{
 "description": "Changed-path rules for `tools/local.py affected` (#401). Files every Gym case loads (the bootstrap resource/require graph computed by tools/local.py, e.g. main/g1/wheel.convexshape) always select the whole inventory, before any rule, so no narrow rule may match them (tests/g2/test_local_first.py). Otherwise the first matching rule wins; a path no rule matches selects the whole Gym inventory. \"cases\": [] means `check` runs the covering tests; \"cases\": \"ci\" means no local command covers the path, so `affected --run` reports BLOCKED instead of PASS; \"also_ci\": true selects the cases and additionally reports BLOCKED, because part of the coverage exists only in CI. A file every case loads is also reported BLOCKED when a \"ci\" or \"also_ci\" rule matches it. Station JSONs are loaded by id (`sys.load_resource` in main/gym/stations.lua) and by many runners, so they have no narrow rule. Documentation is skipped through tools/ci/classify_changes.py. A suggestion for local runs only: GitHub required still runs every case.",
 "rules": [
  {
   "name": "le6 editor gameplay checks (loaded by polish.cjs and editor_ui_checks.cjs)",
   "cases": [
    "le6"
   ],
   "paths": [
    "tools/gameplay/check_*_editor.cjs"
   ]
  },
  {
   "name": "release preview verification (tools/preview/verify.cjs; CI only)",
   "cases": "ci",
   "paths": [
    "tools/gameplay/*.cjs",
    "tools/preview/*"
   ]
  },
  {
   "name": "persistence suites in the pinned Defold engine (CI only; check runs only the protocol tests)",
   "cases": "ci",
   "paths": [
    "tools/g2/persistence_385.py",
    "tests/engine/persistence/persistence.*",
    "tests/engine/persistence/runner.*"
   ]
  },
  {
   "name": "workflows, Renovate, workflow lint, Bridge, Android and G1 physics (CI only; G1 also via `tools/local.py physics`)",
   "cases": "ci",
   "paths": [
    ".github/*",
    "renovate.json",
    "tools/ci/lint_workflows.py",
    "tools/ci/actionlint-lock.json",
    "tools/g2/*",
    "tools/setup_bridge.py",
