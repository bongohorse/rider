-- Level editor (LE2 shell, LE3 drawing, LE4 documents, LE5a prefabs, LE5b curves). Its own game object sits on top of the input stack: in Edit
-- mode every action is consumed here (Defold only stops propagation between game objects, not between
-- the components of one), so game keys, the HUD and the world never see editor input (R15).
local editor=require "main.gym.editor"
local doc_lib=require "main.gym.editor_doc"
local edit=require "main.gym.editor_edit"
local prefab=require "main.gym.editor_prefab"
local snap_lib=require "main.gym.editor_snap"
local overlay=require "main.gym.editor_overlay"
local stations=require "main.gym.stations"
local custom=require "main.gym.custom"
local socket=require "socket"
local LOADER="main:/loader#script"
local BUTTON=vmath.vector4(0.13,0.24,0.28,1)
local ACTIVE=vmath.vector4(0.15,0.5,0.45,1)
local PANEL=vmath.vector4(0.05,0.1,0.13,0.92)
-- Screen-space behaviour (independent of zoom): pick tolerance, anchor snap radius, handle size,
-- double-click time and distance. Grid steps are metres (R6).
-- Pixel values are reference pixels (1280 x 720 CSS canvas), scaled like the GUI (HiDPI, window size).
local PICK_PX,SNAP_PX,HANDLE_PX,DOUBLE_S,DOUBLE_PX=10,12,9,0.4,4
-- Editor zoom range (LE6: down to 0.01, about 650 m across the canvas, so Fit level shows long courses;
-- it was 0.05, about 130 m).
local MIN_ZOOM,MAX_ZOOM=0.01,4
local ui=1
local C={param=vmath.vector4(1,0.45,0.85,1),vertex=vmath.vector4(0.9,0.95,1,0.9),free=vmath.vector4(1,1,1,0.95),joint=vmath.vector4(0.35,0.95,0.45,1),
    selected=vmath.vector4(1,0.6,0.15,1),hover=vmath.vector4(1,0.95,0.35,1),connect=vmath.vector4(0.35,1,0.45,0.55),
    draw=vmath.vector4(0.55,0.8,1,1),rubber=vmath.vector4(0.55,0.8,1,0.6),join=vmath.vector4(1,0.6,0.15,0.5),box=vmath.vector4(1,0.95,0.35,0.7),
    anchor=vmath.vector4(0.35,1,0.45,1),angle=vmath.vector4(0.4,0.7,1,1),grid=vmath.vector4(0.85,0.85,0.85,1),off=vmath.vector4(1,0.35,0.3,1),free_snap=vmath.vector4(0.85,0.85,0.85,0.6),
    bounds=vmath.vector4(1,0.55,0.25,0.75),test=vmath.vector4(0.55,0.8,1,0.7),
    ghost=vmath.vector4(0.8,0.92,1,0.3),ghost_bad=vmath.vector4(1,0.35,0.3,0.35),last=vmath.vector4(0.55,0.8,1,0.22)}
local function node(self,pos,size,x,y,color)
    local n=gui.new_box_node(pos,size)
    gui.set_xanchor(n,x or gui.ANCHOR_NONE);gui.set_yanchor(n,y or gui.ANCHOR_NONE)
    gui.set_color(n,color or BUTTON)
    self.nodes[#self.nodes+1]=n
    return n
end
local function text(self,pos,value,x,y,pivot,scale)
    local n=gui.new_text_node(pos,value)
    gui.set_font(n,"default");gui.set_xanchor(n,x or gui.ANCHOR_NONE);gui.set_yanchor(n,y or gui.ANCHOR_NONE)
    gui.set_pivot(n,pivot or gui.PIVOT_CENTER);gui.set_scale(n,vmath.vector3(scale or 0.5,scale or 0.5,1))
    self.nodes[#self.nodes+1]=n
    return n
end
local function button(self,name,pos,size,label,x,y)
    local b=node(self,pos,size,x,y)
    local t=text(self,pos,label,x,y)
    self.buttons[name]={box=b,label=t}
    return b
end
local TOOLS={{"select","Select [S]"},{"draw","Draw [D]"},{"curve","Curve [C]"},{"prefab","Prefab [P]"},{"start","START"},{"finish","FINISH"},{"label","Label [L]"},{"pan","Pan"}}
-- Right panel rows (LE5a): a selected prefab's fields, one row each (the Kicker + landing has the most).
local PARAMS=7
-- editor.gui max_nodes (raised from the default 512 for the LE5a panel rows).
local MAX_NODES=640
local KIND_KEYS={}
for i,kind in ipairs(prefab.ORDER) do KIND_KEYS[hash("station_"..i)]=kind end
-- Open dialog (LE4): My levels rows per page; templates per page (LE6: paged, so a growing station list
-- never covers the Close button).
local ROWS,TEMPLATE_ROWS=10,10
-- Warning list (LE6): clickable rows per page.
local WARN_ROWS=8
-- View row (LE6) in the bottom bar, left of the page's own High DPI / Fullscreen buttons: name, label, width.
local VIEW={{"view_fit","Fit [Home]",70},{"view_centre","Centre [.]",70},{"view_start","START",50},{"view_test","Last test",64},{"view_bounds","Bounds",56},
    {"view_ghost","Ghost",50},{"view_help","Help [H]",60}}
local DIM=vmath.vector4(0.09,0.15,0.17,1)
local DANGER=vmath.vector4(0.5,0.15,0.12,1)
local DIALOG=vmath.vector4(0.05,0.1,0.13,1)
-- Help overlay (LE6b): the shipped controls. Keys in [brackets]; tests/ci/test_editor_help.py checks that
-- every editor key binding is listed here.
-- HELP BEGIN
local HELP_LEFT={
    "Editor help  ([H], [Esc] or a click outside closes it)",
    "",
    "Tools",
    "  [S] Select  [D] Draw  [C] Curve  [P] Prefab  [L] Label",
    "  START, FINISH and Pan: buttons on the left",
    "",
    "Mouse",
    "  Click selects or places; drag moves (one Undo step)",
    "  Wheel zooms; Middle drag or [Space]+drag pans",
    "  Shift+click adds or removes; drag on empty space: box",
    "  [Tab] picks the next item under the cursor",
    "  Double-click a selected line or curve: insert a point",
    "  Double-click a label: edit its text",
    "  [Esc] cancels the action, then clears the selection",
    "",
    "Draw [D] and Curve [C]",
    "  Click places points; click the last one, double-click",
    "  or [Enter] finishes; [Backspace] or Ctrl+[Z] removes",
    "  the last point; [Esc] discards the piece",
    "  Starting or ending on a free end (green ring) connects",
    "",
    "Snapping",
    "  0.5 m grid + anchors; [Alt] 0.1 m; Shift 15 deg",
    "  Ctrl while dragging: off; [G] grid on/off",
}
local HELP_RIGHT={
    "Edit",
    "  [Delete] / [Backspace] delete; [K] split; [J] connect",
    "  Ctrl+[Z] undo; Ctrl+[Y] or Ctrl+Shift+[Z] redo",
    "  Ctrl+[C] copy; Ctrl+[V] paste at the cursor",
    "  Mirror [<] [>] (right panel): mirrored copy left/right",
    "  Prefab [P]: [1] to [7] pick the type; pink handles and",
    "    the right panel change its values",
    "  Curves: drag anchors and tangents (pink); Make smooth /",
    "    Make corner on points (Shift+click or a box)",
    "  Label [L]: click places one and edits its text",
    "",
    "Test and play",
    "  [E], [Enter] or Play: drive from START",
    "  [F] test start on the surface; Shift+[F] drop here",
    "  -/+ (right panel): start or test speed; [R] retry",
    "    (while driving); [E] back to the editor",
    "",
    "View (bottom row)",
    "  [Home] Fit level; [.] centre the selection; START;",
    "  Last test; Bounds; Ghost (test start preview)",
    "",
    "Fields (level name, values, label text)",
    "  While a field is focused every key types into it;",
    "  [Enter] applies, [Esc] cancels, a click elsewhere applies",
}
-- HELP END
local function shorten(t,n) if #t<=n then return t end;return t:sub(1,n-3):gsub("[\128-\191]*$",""):gsub("[\192-\255]$","").."..." end
-- A faint upright vehicle (LE6b), relative to the chassis centre in metres: chassis box (feel: 1.08 x
-- 0.28 m), two wheels at (+-0.46, -0.30) of radius 0.22 m (two squares each, one turned 45 degrees: an
-- octagon) and the rider. {centre x, y, width, height, turned}.
local SILHOUETTE={{0,0,1.08,0.28},{-0.46,-0.3,0.39,0.39},{-0.46,-0.3,0.39,0.39,true},{0.46,-0.3,0.39,0.39},{0.46,-0.3,0.39,0.39,true},{-0.04,0.4,0.3,0.5}}
local function silhouette(self)
    local list={}
    for i=1,#SILHOUETTE do
        local n=gui.new_box_node(vmath.vector3(0,0,0),vmath.vector3(1,1,0))
        gui.set_enabled(n,false);list[i]=n
    end
    self.extra_nodes=(self.extra_nodes or 0)+#list
    return list
end
-- Places a silhouette with its chassis centre at p (metres); nil hides it.
local function show_silhouette(o,list,p,s,color)
    for i,n in ipairs(list) do
        gui.set_enabled(n,p~=nil)
        if p then
            local part=SILHOUETTE[i]
            gui.set_screen_position(n,vmath.vector3(s.ox+(p[1]+part[1])*s.ppm_x,s.oy+(p[2]+part[2])*s.ppm_y,0))
            gui.set_size(n,vmath.vector3(part[3]*math.abs(s.ppm_x)/o.k,part[4]*math.abs(s.ppm_y)/o.k,0))
            gui.set_euler(n,vmath.vector3(0,0,part[5] and 45 or 0))
            gui.set_color(n,color)
        end
    end
end
function init(self)
    -- Overlays first: GUI nodes draw in creation order, so the panels stay on top of grid and handles.
    self.overlay=overlay.init()
    self.nodes,self.buttons,self.held={},{},{}
    -- Vehicle silhouettes (LE6b): the test start preview (ghost) and the last test start; below the panels.
    self.ghost,self.last_ghost=silhouette(self),silhouette(self)
    -- Test state for the le2/le3/le4 runners only (debug engine); release builds never publish it.
    local case=sys.get_config_string("rider.gym_test","")
    self.debug=html5 and sys.get_engine_info().is_debug and (case=="le2" or case=="le3" or case=="le4" or case=="le5a" or case=="le5b" or case=="le5c" or case=="le5d" or case=="le6")
    local L,R,T,B=gui.ANCHOR_LEFT,gui.ANCHOR_RIGHT,gui.ANCHOR_TOP,gui.ANCHOR_BOTTOM
    node(self,vmath.vector3(480,525,0),vmath.vector3(960,30,0),nil,T,PANEL)
    self.title=text(self,vmath.vector3(10,525,0),"",L,T,gui.PIVOT_W)
    button(self,"undo",vmath.vector3(518,525,0),vmath.vector3(50,22,0),"Undo",R,T)
    button(self,"redo",vmath.vector3(572,525,0),vmath.vector3(50,22,0),"Redo",R,T)
    button(self,"new",vmath.vector3(625,525,0),vmath.vector3(48,22,0),"New",R,T)
    button(self,"open",vmath.vector3(681,525,0),vmath.vector3(56,22,0),"Open",R,T)
    button(self,"import",vmath.vector3(744,525,0),vmath.vector3(62,22,0),"Import",R,T)
    button(self,"export",vmath.vector3(810,525,0),vmath.vector3(62,22,0),"Export",R,T)
    button(self,"play",vmath.vector3(900,525,0),vmath.vector3(110,22,0),"Play > [E]",R,T)
    -- Eight tools (LE6b: Label), 24 apart, end where the seven did (the canvas below stays free).
    for i,tool in ipairs(TOOLS) do button(self,"tool_"..tool[1],vmath.vector3(52,470-(i-1)*24,0),vmath.vector3(92,21,0),tool[2],L,T) end
    -- Prefab types (shown with the Prefab tool; keys 1-7 pick them too).
    for i,kind in ipairs(prefab.ORDER) do
        button(self,"kind_"..kind,vmath.vector3(52,250-(i-1)*26,0),vmath.vector3(92,22,0),i.." "..(kind=="kicker" and "Kicker" or prefab.name(kind)),L,T)
        gui.set_scale(self.buttons["kind_"..kind].label,vmath.vector3(0.42,0.42,1))
    end
    -- The right panel is laid out every frame from the rows it shows (layout()).
    self.panel=node(self,vmath.vector3(860,329,0),vmath.vector3(196,292,0),R,T,PANEL)
    self.properties=text(self,vmath.vector3(768,468,0),"",R,T,gui.PIVOT_NW,0.42)
    button(self,"minus",vmath.vector3(800,330,0),vmath.vector3(40,22,0),"-",R,T)
    button(self,"plus",vmath.vector3(848,330,0),vmath.vector3(40,22,0),"+",R,T)
    button(self,"direction",vmath.vector3(860,302,0),vmath.vector3(180,22,0),"Flip direction",R,T)
    button(self,"delete",vmath.vector3(860,302,0),vmath.vector3(180,22,0),"Delete [Del]",R,T)
    button(self,"split",vmath.vector3(860,274,0),vmath.vector3(180,22,0),"Split here [K]",R,T)
    button(self,"connect",vmath.vector3(860,246,0),vmath.vector3(180,22,0),"Connect [J]",R,T)
    button(self,"disconnect",vmath.vector3(860,246,0),vmath.vector3(180,22,0),"Disconnect [J]",R,T)
    -- LE5c: a point's Corner/Smooth switch and a prefab's conversion to an editable path.
    button(self,"smooth",vmath.vector3(860,246,0),vmath.vector3(180,22,0),"Make smooth",R,T)
    button(self,"convert",vmath.vector3(860,246,0),vmath.vector3(180,22,0),"Convert to editable path",R,T)
    -- LE5d: Corner/Smooth for several points or whole objects at once.
    button(self,"smooth_all",vmath.vector3(860,246,0),vmath.vector3(180,22,0),"Make smooth",R,T)
    button(self,"corner_all",vmath.vector3(860,246,0),vmath.vector3(180,22,0),"Make corner",R,T)
    button(self,"rename",vmath.vector3(860,302,0),vmath.vector3(180,22,0),"Rename level",R,T)
    for i=1,PARAMS do
        button(self,"param_"..i,vmath.vector3(860,190,0),vmath.vector3(180,22,0),"",R,T)
        gui.set_scale(self.buttons["param_"..i].label,vmath.vector3(0.42,0.42,1))
    end
    -- Mirror (LE5a, replaces Duplicate): a mirrored copy to the left or right of the selection.
    self.mirror_label=text(self,vmath.vector3(772,218,0),"Mirror",R,T,gui.PIVOT_W,0.45)
    button(self,"mirror_left",vmath.vector3(868,218,0),vmath.vector3(52,22,0),"<",R,T)
    button(self,"mirror_right",vmath.vector3(926,218,0),vmath.vector3(52,22,0),">",R,T)
    button(self,"paste",vmath.vector3(860,190,0),vmath.vector3(180,22,0),"Paste [Ctrl+V]",R,T)
    node(self,vmath.vector3(480,12,0),vmath.vector3(960,24,0),nil,B,PANEL)
    -- View row (LE6): camera and display only, never an edit.
    local x=6
    for _,v in ipairs(VIEW) do
        button(self,v[1],vmath.vector3(x+v[3]/2,12,0),vmath.vector3(v[3],20,0),v[2],L,B)
        gui.set_scale(self.buttons[v[1]].label,vmath.vector3(0.4,0.4,1))
        x=x+v[3]+4
    end
    self.status=text(self,vmath.vector3(x+6,12,0),"",L,B,gui.PIVOT_W,0.42)
    -- Top bar: the page's own High DPI / Fullscreen buttons cover the bottom-right corner.
    button(self,"warnings",vmath.vector3(434,525,0),vmath.vector3(110,22,0),"",R,T)
    -- LE6: below the message line, clear of the right panel; a header line and one clickable row per
    -- message (a located one shows its source).
    self.warning_panel=node(self,vmath.vector3(430,440,0),vmath.vector3(640,76,0),nil,T,PANEL)
    self.warning_text=text(self,vmath.vector3(118,468,0),"",nil,T,gui.PIVOT_W,0.42)
    for i=1,WARN_ROWS do
        local y=446-(i-1)*22
        local b=node(self,vmath.vector3(430,y,0),vmath.vector3(630,20,0),nil,T)
        local t=text(self,vmath.vector3(120,y,0),"",nil,T,gui.PIVOT_W,0.4)
        self.buttons["warn_"..i]={box=b,label=t}
    end
    button(self,"warn_prev",vmath.vector3(665,468,0),vmath.vector3(50,18,0),"<",nil,T)
    button(self,"warn_next",vmath.vector3(720,468,0),vmath.vector3(50,18,0),">",nil,T)
    self.message=text(self,vmath.vector3(480,492,0),"",nil,T,gui.PIVOT_CENTER,0.5)
    -- Open dialog (LE4): My levels (newest first, paged) and the built-in templates (R2, R3).
    self.dialog_nodes={node(self,vmath.vector3(480,290,0),vmath.vector3(720,420,0),nil,nil,DIALOG)}
    self.library_title=text(self,vmath.vector3(140,474,0),"My levels",nil,nil,gui.PIVOT_W,0.45)
    self.dialog_nodes[2]=self.library_title
    self.dialog_nodes[3]=text(self,vmath.vector3(520,474,0),"Templates (open as a copy)",nil,nil,gui.PIVOT_W,0.45)
    for i=1,ROWS do
        button(self,"lib_"..i,vmath.vector3(290,440-(i-1)*28,0),vmath.vector3(290,24,0),"")
        button(self,"libdel_"..i,vmath.vector3(472,440-(i-1)*28,0),vmath.vector3(64,24,0),"Delete")
        gui.set_scale(self.buttons["lib_"..i].label,vmath.vector3(0.4,0.4,1))
        gui.set_scale(self.buttons["libdel_"..i].label,vmath.vector3(0.4,0.4,1))
    end
    button(self,"lib_newer",vmath.vector3(200,150,0),vmath.vector3(100,24,0),"< Newer")
    button(self,"lib_older",vmath.vector3(380,150,0),vmath.vector3(100,24,0),"Older >")
    button(self,"dialog_close",vmath.vector3(760,110,0),vmath.vector3(120,24,0),"Close [Esc]")
    button(self,"tpl_prev",vmath.vector3(580,150,0),vmath.vector3(100,24,0),"< Previous")
    button(self,"tpl_next",vmath.vector3(760,150,0),vmath.vector3(100,24,0),"More >")
    -- One button per station, shown TEMPLATE_ROWS per page at its row (template_page()).
    self.templates={}
    for i,id in ipairs(stations.ids) do
        local d=stations.resource(id)
        button(self,"template_"..id,vmath.vector3(670,440-((i-1)%TEMPLATE_ROWS)*28,0),vmath.vector3(300,24,0),(d and d.name or id).." ("..id..")")
        gui.set_scale(self.buttons["template_"..id].label,vmath.vector3(0.4,0.4,1))
        self.templates[#self.templates+1]="template_"..id
    end
    -- R1 choice for a level whose compiled geometry differs from its editor source.
    self.conflict_nodes={node(self,vmath.vector3(480,300,0),vmath.vector3(700,150,0),nil,nil,DIALOG)}
    self.conflict_text=text(self,vmath.vector3(480,342,0),"",nil,nil,gui.PIVOT_CENTER,0.42)
    gui.set_line_break(self.conflict_text,true);gui.set_size(self.conflict_text,vmath.vector3(1600,120,0))
    self.conflict_nodes[2]=self.conflict_text
    button(self,"conflict_source",vmath.vector3(320,258,0),vmath.vector3(300,24,0),"Recompile from source")
    button(self,"conflict_lines",vmath.vector3(640,258,0),vmath.vector3(300,24,0),"Keep compiled geometry (as lines)")
    -- Help overlay (LE6b): modal, on top of everything; [H], [Esc], Close or a click outside closes it.
    self.help_nodes={node(self,vmath.vector3(480,290,0),vmath.vector3(880,330,0),nil,nil,DIALOG)}
    self.help_nodes[2]=text(self,vmath.vector3(60,440,0),table.concat(HELP_LEFT,"\n"),nil,nil,gui.PIVOT_NW,0.5)
    self.help_nodes[3]=text(self,vmath.vector3(500,440,0),table.concat(HELP_RIGHT,"\n"),nil,nil,gui.PIVOT_NW,0.5)
    button(self,"help_close",vmath.vector3(820,148,0),vmath.vector3(120,24,0),"Close [Esc]")
    self.edit_nodes=self.nodes;self.nodes={}
    self.hint=text(self,vmath.vector3(12,40,0),"Edit level [E]",L,B,gui.PIVOT_W,0.42)
    self.play_message=text(self,vmath.vector3(480,470,0),"",nil,T,gui.PIVOT_CENTER,0.5)
    gui.set_color(self.play_message,vmath.vector4(1,0.6,0.4,1))
    self.gui_nodes=self.overlay.nodes+#self.edit_nodes+#self.nodes+self.extra_nodes
    msg.post(".","acquire_input_focus")
    window.set_listener(function(_,event)
        -- The first press after a focus loss is the click that brings focus back (its gained event may
        -- arrive after that press), so it is ignored unless focus came back more than 1 s earlier.
        if event==window.WINDOW_EVENT_FOCUS_LOST then self.focus_lost,self.refocus,self.refocus_until=true,true,nil
        elseif event==window.WINDOW_EVENT_FOCUS_GAINED then self.refocus_until=socket.gettime()+1 end
    end)
end
-- Held commands, gestures and previews never survive a mode change or focus loss (R15). A polyline
-- being drawn keeps its placed points on focus loss; a mode change ends it (see play).
local function cancel(self)
    self.drag,self.pan,self.box,self.held,self.pending=nil,nil,nil,{},nil
    if editor.preview then editor.preview=nil;editor.touch() end
    if editor.preview_objects then editor.set_preview(nil) end
end
local function map() return editor.map() end
local function cursor(self,action)
    local s=map()
    if not s or not action.screen_x or s.ppm_x==0 or s.ppm_y==0 then return self.cursor end
    self.cursor={(action.screen_x-s.ox)/s.ppm_x,(action.screen_y-s.oy)/s.ppm_y}
    self.cursor_px={action.screen_x,action.screen_y}
    return self.cursor
end
local function tolerance(px) local s=map();return px*ui/math.max(1e-6,s and math.abs(s.ppm_x) or 1) end
local function to_px(p,s) return {s.ox+p[1]*s.ppm_x,s.oy+p[2]*s.ppm_y} end
local function dist(a,b) return math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2) end
local function length(v) return math.sqrt(v[1]*v[1]+v[2]*v[2]) end
local function seg_t(p,a,b)
    local dx,dy=b[1]-a[1],b[2]-a[2]
    return math.max(0,math.min(1,((p[1]-a[1])*dx+(p[2]-a[2])*dy)/math.max(1e-12,dx*dx+dy*dy)))
end
local function seg_dist(p,a,b)
    local t=seg_t(p,a,b)
    return dist(p,{a[1]+(b[1]-a[1])*t,a[2]+(b[2]-a[2])*t})
end
local function find(id) return edit.find(editor.doc.editor,id) end
local path=doc_lib.path
-- Handles of a selected prefab (LE5a). A handle on the exit also selects that end (Connect/Disconnect).
local function prefab_handles(o)
    local list=prefab.handles(o)
    if doc_lib.terrain(o) then
        local pts=path(o)
        local e=pts[#pts]
        for _,h in ipairs(list) do if dist(h.p,e)<1e-9 then h.index=#pts end end
    end
    return list
end
-- Handles of a selected curve (LE5b): every anchor ("a<i>") and its tangents ("i<i>", "o<i>"; the open
-- ends have none). The first anchor of a connected start belongs to the upstream piece and is left out
-- (R4); an end anchor also selects that end (Connect/Disconnect).
local function curve_handles(o)
    local _,prev=doc_lib.links(editor.doc.editor)
    local n,last=#o.anchors,#path(o)
    local list={}
    for i,a in ipairs(o.anchors) do
        if not (i==1 and prev[o.id]) then list[#list+1]={name="a"..i,p=a.p,label="anchor "..i,anchor=i,index=i==1 and 1 or i==n and last or nil} end
        -- A corner (LE5c) has no tangents; the open ends have none either.
        if i>1 and a.mode~="corner" then list[#list+1]={name="i"..i,p={a.p[1]+a["in"][1],a.p[2]+a["in"][2]},label="tangent in, anchor "..i,anchor=i,tangent=true} end
        if i<n and a.mode~="corner" then list[#list+1]={name="o"..i,p={a.p[1]+a.out[1],a.p[2]+a.out[2]},label="tangent out, anchor "..i,anchor=i,tangent=true} end
    end
    return list
end
local function object_handles(o)
    if o.type=="curve" then return curve_handles(o) end
    if o.type=="prefab" then return prefab_handles(o) end
    return {}
end
local function drawing_tool() return editor.tool=="draw" or editor.tool=="curve" end
-- The point of a selected vertex in pts (a drag preview may hold another sample count): a line's point by
-- index, a curve's or prefab's first or last point.
local function end_point(pts,o,index)
    if o.type=="line" then return pts[index] end
    return index==1 and pts[1] or pts[#pts]
end
-- Pick candidates under the cursor, best first (hover shows the first; Tab cycles; click picks the
-- shown one): handles of a selected prefab, line points (every point of a selected line, the ends of
-- every line and terrain prefab; a joint once, as its upstream piece's last point), START, FINISH,
-- labels, then lines, prefabs and hulls by edge distance.
local function candidates(p)
    local e=editor.doc.editor
    local tol=tolerance(PICK_PX)
    local next,prev=doc_lib.links(e)
    local list,seen={},{}
    local function add(c) if not seen[c.key] then seen[c.key]=true;list[#list+1]=c end end
    for _,o in ipairs(e.objects) do
        if (o.type=="prefab" or o.type=="curve") and editor.selected[o.id] then
            for _,h in ipairs(object_handles(o)) do
                local d=dist(p,h.p)
                if d<=tol then add({kind="handle",id=o.id,handle=h.name,label=h.label,index=h.index,anchor=h.anchor,d=d,rank=0,key="h:"..o.id..":"..h.name}) end
            end
        end
    end
    for _,o in ipairs(e.objects) do
        if doc_lib.terrain(o) then
            local selected=editor.selected[o.id] and o.type=="line"
            local pts=path(o)
            for i,q in ipairs(pts) do
                if (selected or i==1 or i==#pts) and math.abs(q[1]-p[1])<=tol and math.abs(q[2]-p[2])<=tol then
                    local d=dist(p,q)
                    if d<=tol then
                        local id,index=o.id,i
                        if i==1 and prev[o.id] then id=prev[o.id];index=#path(find(id)) end
                        add({kind="vertex",id=id,index=index,d=d,rank=1,key="v:"..id..":"..index})
                    end
                end
            end
        end
    end
    local v,s=doc_lib.VEHICLE,e.start.position
    if p[1]>=s[1]+v[1] and p[1]<=s[1]+v[2] and p[2]>=s[2]+v[3] and p[2]<=s[2]+v[4] then add({kind="start",id="start",d=0,rank=2,key="start"}) end
    local f=e.finish
    if f and math.abs(p[1]-f.position[1])<=tol and p[2]>=f.position[2]-doc_lib.FINISH_BELOW and p[2]<=f.position[2]+doc_lib.FINISH_ABOVE then
        add({kind="finish",id="finish",d=math.abs(p[1]-f.position[1]),rank=2,key="finish"})
    end
    for _,o in ipairs(e.objects) do
        local d,segment
        if o.type=="label" then
            -- The drawn text's box (LE6b): editor_view scales labels by max(1, 0.5 / zoom); the builtin
            -- font is about 7.9 x 14 units per character at scale 1 (1 unit = 1 cm).
            local k=math.max(1,0.5/editor.camera.zoom)/100
            local chars=select(2,o.text:gsub("[^\128-\191]",""))
            local dx=math.max(0,math.abs(p[1]-o.position[1])-chars*3.95*k)
            local dy=math.max(0,math.abs(p[2]-o.position[2])-7*k)
            d=math.sqrt(dx*dx+dy*dy)
        else
            local closed=doc_lib.outline(o)
            for _,pts in ipairs(closed and {closed} or doc_lib.parts(o)) do
                for i=2,#pts+(closed and 1 or 0) do
                    local q=seg_dist(p,pts[i-1],pts[(i-1)%#pts+1])
                    if not d or q<d then d,segment=q,i-1 end
                end
            end
        end
        if d and d<=tol then add({kind="object",id=o.id,type=o.type,segment=segment,d=d,rank=o.type=="label" and 3 or 4,key="o:"..o.id}) end
    end
    table.sort(list,function(a,b) if a.rank~=b.rank then return a.rank<b.rank end;if a.d~=b.d then return a.d<b.d end;return a.key<b.key end)
    return list
end
local function describe_candidate(c)
    if not c then return "" end
    if c.kind=="handle" then return "handle ("..c.label..") of "..doc_lib.label(find(c.id)) end
    if c.kind=="vertex" then
        local o=find(c.id)
        if o and o.type~="line" then return (c.index==1 and "entry" or "exit").." of "..doc_lib.label(o) end
        return "point "..c.index.." of "..c.id
    end
    if c.kind=="object" then local o=find(c.id);return o and doc_lib.label(o):lower() or c.type.." "..c.id end
    return c.kind=="start" and "START" or "FINISH"
end
-- Hover (R6 editing basics): the candidate a click would pick is highlighted before clicking.
local function set_hover(self,list)
    local keys={};for _,c in ipairs(list) do keys[#keys+1]=c.key end
    local key=table.concat(keys,",")
    if key~=self.hover_key then self.hover_key,self.hover_index=key,1 end
    self.candidates=list
    local c=list[self.hover_index]
    local object=c and c.kind=="object" and c.id or nil
    if editor.hover_object~=object then editor.hover_object=object;editor.touch() end
    editor.hover=c
end
-- Anchors for snapping: every line point and hull vertex except those that move with the edit, plus
-- extra points. Line ends carry their end so the draw tool can show and confirm a connect preview.
local cache={}
local function anchors(skip,extra)
    local e=editor.doc.editor
    -- Rebuilt only when the document, the moving set or the drawn points change (not per mouse move).
    if cache.doc==editor.doc and cache.revision==e.revision and cache.skip==skip and cache.extra==(extra and #extra or 0)
        and cache.last==(extra and extra[#extra]) then return cache.list end
    local next,prev=doc_lib.links(e)
    local list={}
    for _,o in ipairs(e.objects) do
        if not (skip and skip[o.id]) then
            if doc_lib.terrain(o) then
                local pts=path(o)
                for i,q in ipairs(pts) do
                    local free=(i==1 and not prev[o.id]) or (i==#pts and not next[o.id])
                    local skip_point=skip and skip.vertex and skip.vertex[o.id..":"..i]
                    if not skip_point then list[#list+1]={p=q,id=o.id,index=i,end_free=free and {id=o.id,index=i} or nil} end
                end
            elseif doc_lib.outline(o) then for _,q in ipairs(doc_lib.outline(o)) do list[#list+1]={p=q,id=o.id} end end
        end
    end
    for _,q in ipairs(extra or {}) do list[#list+1]={p=q} end
    cache={doc=editor.doc,revision=e.revision,skip=skip,extra=extra and #extra or 0,last=extra and extra[#extra],list=list}
    return list
end
local function snap_mode(self)
    if self.held.ctrl then return "Snap off (Ctrl)" end
    local parts={}
    if self.held.alt then parts[#parts+1]="grid 0.1 m (Alt)" elseif editor.grid then parts[#parts+1]="grid 0.5 m" else parts[#parts+1]="grid off [G]" end
    parts[#parts+1]="anchors"
    if self.held.shift then parts[#parts+1]="15 deg (Shift)" end
    return "Snap: "..table.concat(parts," + ")
end
local function snap(self,p,skip,from,extra)
    local q,kind,anchor=snap_lib.snap(p,{off=self.held.ctrl,grid=editor.grid,fine=self.held.alt,from=self.held.shift and from or nil,
        anchors=anchors(skip,extra),radius=tolerance(SNAP_PX)})
    self.snapped={p=q,kind=kind,anchor=anchor}
    return q,kind,anchor
end
local function selected_object()
    for _,o in ipairs(editor.doc.editor.objects) do if o.id==editor.selection then return o end end
end
local function delete(self)
    if editor.point_count()>=2 then editor.message="Delete works on one point at a time: click one of the selected points first.";return end
    local s=editor.selection
    local v=editor.vertex
    -- A curve anchor (or a curve end) deletes that anchor; a prefab end stands for the whole prefab.
    -- Only an anchor of the single selected curve counts (never one left over from another selection).
    local a=editor.anchor
    if a and not (a.id==editor.selection and #editor.selected_ids()==1) then a=nil end
    if not a and v and find(v.id) and find(v.id).type=="curve" then a={id=v.id,i=v.index==1 and 1 or #find(v.id).anchors} end
    if a and find(a.id) then
        if editor.commit(function(e) return edit.delete_anchor(e,a.id,a.i) end,true) then editor.select(a.id) end
        return
    end
    if v and find(v.id) and find(v.id).type=="prefab" then v=nil end
    if v then
        if editor.commit(function(e) return edit.delete_point(e,v.id,v.index) end,true) then editor.select(v.id) end
        return
    end
    if s=="start" then editor.message="START cannot be deleted; move it instead.";return end
    if s=="finish" then editor.commit(function(e) e.finish=nil end);return end
    local ids=editor.selected_ids()
    if #ids>0 then editor.commit(function(e) edit.remove(e,ids) end,true) end
end
local function place(target,p)
    editor.commit(function(e)
        if target=="start" then e.start.position={p[1],p[2]}
        elseif e.finish then e.finish.position={p[1],p[2]}
        else e.finish={position={p[1],p[2]},direction=1} end
    end)
    editor.select(target)
end
-- Drawing (D): each click places a snapped point; a click on the last point, a double-click or Enter
-- finishes the piece; ending on a free end connects and finishes there; Backspace removes the last
-- point; Esc discards the unfinished piece.
local function finish_drawing(self)
    local d=self.drawing
    self.drawing=nil
    if not d or #d.points<2 or d.opened~=editor.opened then return end
    -- Connections are resolved when the piece is finished: a free end exactly at its first or last
    -- point (snapped there, shown as a connect preview). Undo/Redo while drawing cannot leave stale ends.
    local function free_end(p)
        for _,c in ipairs(edit.ends(editor.doc.editor)) do if c.free and c.p[1]==p[1] and c.p[2]==p[2] then return {id=c.id,index=c.index} end end
    end
    -- Only a point placed with the anchor snap (the visible connect preview) connects; Ctrl never does.
    local first=d.anchored[1] and free_end(d.points[1])
    local last=d.anchored[#d.points] and free_end(d.points[#d.points])
    if first and last and first.id==last.id and first.index==last.index then last=nil end
    local id,note
    local ok=editor.commit(function(e)
        local err
        id,err=(d.kind=="curve" and edit.add_curve or edit.add_line)(e,d.points,first,last)
        if not id then return nil,err end
        note=err
    end,true)
    if ok and id then editor.select(id);if note then editor.message=note end end
end
local function connect_target(v)
    -- The nearest free end of another run within the snap radius of the selected free end.
    local e=editor.doc.editor
    if not v or edit.joint(e,v.id,v.index) then return nil end
    local o=find(v.id)
    if not o or (v.index~=1 and v.index~=#path(o)) then return nil end
    local run={};for _,id in ipairs(edit.run_of(e,v.id)) do run[id]=true end
    local p=path(o)[v.index]
    local best,bd
    for _,c in ipairs(edit.ends(e)) do
        if c.free and not run[c.id] then
            local d=dist(p,c.p)
            if d<=math.max(0.01,tolerance(SNAP_PX)) and (not bd or d<bd) then best,bd=c,d end
        end
    end
    return best
end
local function connect(self)
    if editor.point_count()>=2 then editor.message="Connect [J] works on one point at a time: click one of the selected points first.";return end
    local v=editor.vertex
    if not v then editor.message="Select a line end first.";return end
    local e=editor.doc.editor
    if edit.joint(e,v.id,v.index) then
        local id,index=edit.owner(e,v.id,v.index)
        local q=path(find(id))[index]
        q={q[1],q[2]}
        if editor.commit(function(doc_e) local to,err=edit.disconnect(doc_e,id,index);if not to then return nil,err end end,true) then
            -- Disconnect may re-orient a remaining line run: select the same end by position.
            local pts=path(find(id))
            editor.select(id,{id=id,index=dist(pts[1],q)<1e-6 and 1 or #pts})
        end
        return
    end
    local v2=editor.vertex2
    local function point(x) local o=x and find(x.id);return o and path(o)[x.index] end
    if point(v2) and dist(point(v2),point(v))>=0.01 then
        -- Two separated free ends: a new piece bridges them; neither end moves (LE3b).
        local id
        if editor.commit(function(doc_e) local new,err=edit.bridge(doc_e,{id=v.id,index=v.index},{id=v2.id,index=v2.index});id=new;if not new then return nil,err end end,true) then
            editor.select(id)
        end
        return
    end
    local target=point(v2) and {id=v2.id,index=v2.index,p=point(v2)} or connect_target(v)
    if not target then editor.message="Connect needs a second free end: Shift+click it, or drag this end onto it.";return end
    local id=v.id
    if editor.commit(function(doc_e) return edit.connect(doc_e,{id=v.id,index=v.index},{id=target.id,index=target.index}) end,true) then
        -- The connected end is the joint at the target position; select it again by position.
        local pts=path(find(id))
        local index=dist(pts[1],target.p)<1e-6 and 1 or #pts
        local oid,oindex=edit.owner(editor.doc.editor,id,index)
        editor.select(oid,{id=oid,index=oindex})
    end
end
local function split(self)
    if editor.point_count()>=2 then editor.message="Split [K] works on one point at a time: click one of the selected points first.";return end
    local a=editor.anchor
    if a and find(a.id) and a.id==editor.selection and #editor.selected_ids()==1 then
        if editor.commit(function(e) local id,err=edit.split_curve(e,a.id,a.i);if not id then return nil,err end end,true) then editor.select(a.id) end
        return
    end
    local v=editor.vertex
    if not v then editor.message="Select a point inside a line (or an anchor inside a curve) first.";return end
    if editor.commit(function(e) local id,err=edit.split(e,v.id,v.index);if not id then return nil,err end end,true) then
        editor.select(v.id,{id=v.id,index=#find(v.id).points})
    end
end
local function play(self,test)
    -- An unfinished piece is completed first, so Play never drops placed points.
    if self.drawing then finish_drawing(self) end
    if editor.dirty then editor.save_draft() end
    cancel(self)
    msg.post(LOADER,"editor_play",{test=test})
end
local function test_start(self)
    local p=self.cursor
    if not p then return end
    local mode=self.held.shift and "drop" or "surface"
    local pos,err=doc_lib.test_start(editor.doc,p,mode)
    if not pos then editor.message="Test start refused: "..err..".";return end
    play(self,{position=pos,speed=editor.test_speed,mode=mode})
end
local function zoom(self,factor)
    local c,p=editor.camera,self.cursor
    local z=math.max(MIN_ZOOM,math.min(MAX_ZOOM,c.zoom*factor))
    if p then c.x,c.y=p[1]-(p[1]-c.x)*c.zoom/z,p[2]-(p[2]-c.y)*c.zoom/z end
    c.zoom=z
end
-- After another document became current: dialogs close, and an unfinished piece (which belongs to the
-- previous document) is discarded with its gesture state.
local function opened(self)
    self.open_dialog,self.field,self.confirm_delete,self.place=false,nil,nil,nil
    if self.drawing then self.drawing=nil;editor.message="Unfinished piece discarded: another level was opened." end
    cancel(self);self.snapped=nil
end
local function open_template(self,id)
    local d=stations.resource(id)
    if not d then editor.message="Template unavailable: "..id;return end
    local doc,note=doc_lib.template(d)
    -- A note of the previous template must not stay on another one.
    editor.message=""
    if editor.open(doc,true) then
        opened(self)
        if note then editor.message=editor.message~="" and editor.message.." "..note or note end
    end
end
-- My levels (LE4): open, delete (asks once more), new.
local function refresh_library(self)
    local list,err=editor.library().list(),select(2,editor.library().index())
    self.library,self.library_error=list,err
    self.page=math.max(0,math.min(self.page or 0,math.floor((#list-1)/ROWS)))
end
local function open_saved(self,key)
    if key==editor.key() then editor.message="This level is already open.";self.open_dialog=false;return end
    local doc,err,unsupported=editor.library().load(key)
    if not doc then
        editor.message=unsupported and "Not opened: this level was saved by an unsupported editor ("..err.."). It is kept unchanged." or "The level cannot be opened: "..tostring(err)
        return
    end
    if editor.open(doc,true,{key=key}) then opened(self) end
end
local function delete_saved(self,key)
    if key==editor.key() then editor.message="The open level cannot be deleted; open another level first.";return end
    if self.confirm_delete~=key then self.confirm_delete=key;editor.message="Click Sure? to delete this level from My levels.";return end
    self.confirm_delete=nil
    local ok,err=editor.library().remove(key)
    editor.message=ok and "Level deleted from My levels." or "Delete failed ("..tostring(err)..")."
    refresh_library(self)
end
local function new_level(self)
    local n=#editor.library().list()+1
    local drawing=self.drawing
    if not editor.open(doc_lib.blank("my-level-"..n,"New level "..n),true,{store=true}) then return end
    opened(self)
    if not drawing then editor.message="New level "..n..": draw terrain [D]." end
end
-- Copy/paste (R17): new ids, internal connections kept, outside connections dropped, no START/FINISH.
local function copy_selection()
    local ids=editor.selected_ids()
    if #ids==0 then
        editor.message=(editor.selection=="start" or editor.selection=="finish") and "START and FINISH are not copied: a level has one of each." or "Select objects to copy first."
        return false
    end
    editor.clipboard=edit.copy(editor.doc.editor,ids)
    editor.message="Copied "..#ids.." object"..(#ids==1 and "" or "s")..". Ctrl+V pastes at the cursor."
    editor.touch()
    return true
end
local function paste_by(d)
    local clip=editor.clipboard
    local ids
    if editor.commit(function(e) ids=edit.paste(e,clip,d) end,true) then
        editor.select(nil)
        for _,id in ipairs(ids) do editor.selected[id]=true end
        editor.selection=ids[1];editor.touch()
        local n=#ids
        editor.message="Pasted "..n.." object"..(n==1 and "" or "s")..(#clip.connections>0 and " with their connections" or "")..". Connections to other pieces are not copied."
    end
end
-- The copy's centre lands on the cursor; the offset keeps the active grid, so on-grid points stay on it.
local function paste_at(self,p)
    local clip=editor.clipboard
    if not clip then editor.message="Nothing to paste: copy a selection first [Ctrl+C].";return end
    local b=edit.bbox(clip.objects)
    local d={p[1]-(b[1]+b[2])/2,p[2]-(b[3]+b[4])/2}
    local step=self.held.alt and snap_lib.FINE or editor.grid and snap_lib.GRID or nil
    if step then d={snap_lib.round(d[1],step),snap_lib.round(d[2],step)} end
    paste_by(d)
end
-- Mirror (LE5a): a horizontally mirrored copy to the left or right of the selection, at least 1 m apart,
-- offset by a multiple of 0.5 m. The original and the clipboard stay unchanged; one Undo step.
local function mirror(self,side)
    local ids=editor.selected_ids()
    if #ids==0 then editor.message="Select objects to mirror first.";return end
    local new
    if editor.commit(function(e) new=edit.mirror(e,ids,side) end,true) then
        editor.select(nil)
        for _,id in ipairs(new) do editor.selected[id]=true end
        editor.selection=new[1];editor.touch()
        editor.message="Mirrored copy of "..#new.." object"..(#new==1 and "" or "s").." to the "..(side>0 and "right" or "left")..". The original is unchanged."
    end
end
-- Prefabs (LE5a). A parameter change keeps the entry and moves the downstream run (edit.set_params);
-- one Undo step. A change that adds a Play-blocking error is applied and named as a conflict.
local function apply_params(id,params,partner)
    local known={}
    for _,m in ipairs(editor.errors) do known[m]=true end
    -- params: prefab parameters, or the new anchors of a curve (LE5b, same R4 rule).
    local change=find(id).type=="curve" and edit.set_anchors or edit.set_params
    if editor.commit(function(e)
        local moved,err=change(e,id,params)
        if not moved then return nil,err end
        -- A smoothed joint's other tangent (LE5c) changes in the same Undo step.
        if partner then local ok,perr=edit.set_anchors(e,partner.id,partner.anchors);if not ok then return nil,perr end end
    end,true) then
        for _,m in ipairs(editor.errors) do
            if not known[m] then editor.message="Changed, with a conflict: "..m..(m:match("%.$") and "" or ".").." Undo [Ctrl+Z] restores the previous shape.";return true end
        end
        return true
    end
end
local function same_params(a,b)
    for k,v in pairs(a) do if b[k]~=v then return false end end
    for k in pairs(b) do if a[k]==nil then return false end end
    return true
end
-- Snapping steps for handle drags: lengths on the active grid, angles in 1 deg steps (Alt 0.1, Shift 15
-- deg); Ctrl turns both off (R6).
local function steps(self)
    if self.held.ctrl then return {} end
    return {length=self.held.alt and snap_lib.FINE or editor.grid and snap_lib.GRID or nil,angle=self.held.shift and 15 or self.held.alt and 0.1 or 1}
end
-- Where a click with the Prefab tool places the current type: its entry at the snapped cursor. On a free
-- exit the prefab continues that run; on a free entry its exit ends there (a visible connect preview,
-- R5). A Platform is a separate obstacle and never connects.
local function placement(self,p)
    local kind=editor.prefab_kind
    local params=prefab.defaults(kind)
    local q,how,anchor=snap(self,p)
    local place={kind=kind,params=params,at={q[1],q[2]},p=q}
    if kind~="platform" and how=="anchor" and anchor.end_free then
        local o=find(anchor.id)
        if anchor.index==#path(o) and anchor.index>1 then place.first={id=anchor.id,index=anchor.index}
        else
            local x=doc_lib.exit({type="prefab",kind=kind,at={0,0},params=params})
            place.at={q[1]-x[1],q[2]-x[2]};place.last={id=anchor.id,index=1}
        end
        place.target=anchor.id
    end
    return place
end
local function place_prefab(self,p)
    local place=placement(self,p)
    local id
    if editor.commit(function(e) local new,err=edit.add_prefab(e,place.kind,place.params,place.at,place.first,place.last);id=new;if not new then return nil,err end end,true) then
        editor.select(id)
        editor.message="Placed "..prefab.name(place.kind).." "..id..(place.target and ", connected to "..place.target or "")..". Change its values on the right."
    end
end
-- Point selection (LE5d). A point is {id, i}: a line point or a curve anchor by index, a joint as its
-- upstream piece's last point. Points belong to selected lines and curves (a joint also to its selected
-- downstream piece); prefab points never (convert first). editor.points holds two or more; one point is the
-- LE5c single selection (vertex/anchor), none means whole objects.
local function editable(o) return o and (o.type=="line" or o.type=="curve") end
local function point_total(o) return o.type=="line" and #o.points or #o.anchors end
local function own_point(id,i)
    local o=find(id)
    if not editable(o) then return nil end
    local next,prev=doc_lib.links(editor.doc.editor)
    if i==1 and prev[id] then
        local u=find(prev[id])
        if not editable(u) or not (editor.selected[id] or editor.selected[u.id]) then return nil end
        return {id=u.id,i=point_total(u)}
    end
    if editor.selected[id] or (i==point_total(o) and next[id] and editor.selected[next[id]]) then return {id=id,i=i} end
end
-- The point a pick candidate stands for (a line point or end, a curve's anchor handle), or nil.
local function point_of(c)
    if c.kind=="vertex" then
        local o=find(c.id)
        if not editable(o) then return nil end
        return own_point(c.id,o.type=="curve" and (c.index==1 and 1 or #o.anchors) or c.index)
    end
    if c.kind=="handle" and c.anchor and c.handle:sub(1,1)=="a" then return own_point(c.id,c.anchor) end
end
local function point_pos(pt)
    local o=editor.preview_objects and editor.preview_objects[pt.id] or find(pt.id)
    if not o then return nil end
    return o.type=="line" and o.points[pt.i] or o.anchors[pt.i] and o.anchors[pt.i].p
end
-- The LE5c single point (anchor or vertex) as a point, if it is one.
local function single_point()
    local a=editor.anchor
    if a and a.id==editor.selection and find(a.id) then return own_point(a.id,a.i) end
    local v=editor.vertex
    if v and find(v.id) then return point_of({kind="vertex",id=v.id,index=v.index}) end
end
-- Selects only this point, as the LE5c single selection. The object selection stays as it is: a joint
-- picked through its selected downstream piece does not add the upstream piece.
local function set_single(pt)
    local o=find(pt.id)
    editor.points,editor.vertex2={},nil
    if o.type=="line" then editor.selection,editor.vertex,editor.anchor=pt.id,{id=pt.id,index=pt.i},nil
    else
        local n=#o.anchors
        editor.selection,editor.anchor=pt.id,{id=pt.id,i=pt.i}
        editor.vertex=(pt.i==1 or pt.i==n) and {id=pt.id,index=pt.i==1 and 1 or #path(o)} or nil
    end
    editor.touch()
end
-- After a change of editor.points: one point becomes the single selection, two or more drop it.
local function settle_points(primary)
    local n=editor.point_count()
    if n==1 then for _,only in pairs(editor.points) do set_single(only) end;return end
    editor.vertex,editor.vertex2,editor.anchor=nil,nil,nil
    if n>=2 and primary and editor.selected[primary] then editor.selection=primary end
    editor.touch()
end
-- Shift+click on a point: add or remove it (the current single point joins the set first).
local function toggle_point(pt)
    if editor.point_count()==0 then
        local s1=single_point()
        if s1 then editor.points[s1.id..":"..s1.i]={id=s1.id,i=s1.i} end
    end
    local key=pt.id..":"..pt.i
    if editor.points[key] then editor.points[key]=nil else editor.points[key]={id=pt.id,i=pt.i} end
    settle_points(pt.id)
end
local function has_paths()
    for id in pairs(editor.selected) do if editable(find(id)) then return true end end
    return false
end
-- A box on empty space while lines or curves are selected: their points inside it (LE5d box rule).
local function box_points(b)
    local x0,x1=math.min(b.from[1],b.to[1]),math.max(b.from[1],b.to[1])
    local y0,y1=math.min(b.from[2],b.to[2]),math.max(b.from[2],b.to[2])
    local found,any={},false
    for _,o in ipairs(editor.doc.editor.objects) do
        if editor.selected[o.id] and editable(o) then
            for i=1,point_total(o) do
                local q=o.type=="line" and o.points[i] or o.anchors[i].p
                if q[1]>=x0 and q[1]<=x1 and q[2]>=y0 and q[2]<=y1 then
                    local pt=own_point(o.id,i)
                    if pt then found[pt.id..":"..pt.i]=pt;any=true end
                end
            end
        end
    end
    return any and found or nil
end
local function plural(n,word) return n.." "..word..(n==1 and "" or "s") end
local function names_text(list)
    if #list<=3 then return table.concat(list,", ") end
    return table.concat(list,", ",1,3).." and "..(#list-3).." more"
end
-- What Make smooth / Make corner would do with the current points or whole objects (panel text), cached
-- per document state and selection.
local corner_cache={}
local function corner_summary()
    local e=editor.doc.editor
    local multi=editor.point_count()>=2
    local ids=editor.selected_ids()
    local list=multi and editor.point_list() or edit.object_points(e,ids)
    local keys={}
    for _,pt in ipairs(list) do keys[#keys+1]=pt.id..":"..pt.i end
    local key=tostring(editor.doc)..":"..e.revision..":"..table.concat(ids,",")..":"..tostring(multi)..":"..table.concat(keys,",")
    if corner_cache.key==key then return corner_cache.value end
    local r={points=#list,sharp=0,smooth=0,ends=0,prefab=0,convert=0,multi=multi}
    local seen={}
    for _,pt in ipairs(list) do
        local st=edit.corner_state(e,pt.id,pt.i)
        if not st then r.ends=r.ends+1
        elseif not seen[st.id..":"..st.i] then
            seen[st.id..":"..st.i]=true
            if st.prefab then r.prefab=r.prefab+1 elseif st.corner then r.sharp=r.sharp+1 else r.smooth=r.smooth+1 end
        end
    end
    if not multi then
        for _,id in ipairs(ids) do local o=find(id);if o.type=="prefab" and doc_lib.terrain(o) and not prefab.sample_error(o) then r.convert=r.convert+1 end end
    end
    corner_cache={key=key,value=r}
    return r
end
-- Whole-object Make smooth / Make corner is offered for selected lines or curves (no single point picked),
-- or for several objects with a terrain prefab among them; a single prefab keeps its Convert button.
local function object_corner_mode()
    if not editor.doc then return false end
    if editor.point_count()>=2 or editor.vertex or editor.anchor then return false end
    if has_paths() then return true end
    local ids=editor.selected_ids()
    if #ids<2 then return false end
    for _,id in ipairs(ids) do if doc_lib.terrain(find(id)) then return true end end
    return false
end
-- Bulk Corner / Smooth (LE5d): every selected point, or every eligible point of the selected objects, in
-- one Undo step. Prefabs among whole objects are converted first, after a confirmation click.
local function bulk_text(r,smooth,nothing)
    local head=nothing and "Nothing to "..(smooth and "smooth" or "make sharp") or (smooth and "Make smooth: " or "Make corner: ")..plural(r.changed,"point")..(smooth and " rounded" or " made sharp")
    local skips={}
    if r.ends>0 then skips[#skips+1]=plural(r.ends,"open end") end
    if r.already>0 then skips[#skips+1]=plural(r.already,"point").." already "..(smooth and "smooth" or "sharp") end
    if r.prefab>0 then skips[#skips+1]=plural(r.prefab,"joint").." to a prefab (convert it first)" end
    if #r.skipped>0 then skips[#skips+1]=names_text(r.skipped)..(smooth and " (no path)" or " (no smooth points)") end
    if #r.refused>0 then skips[#skips+1]=plural(#r.refused,"point").." refused ("..r.refused[1]..")" end
    return head..(#skips>0 and "; skipped: "..table.concat(skips,", ") or "")..(#r.converted>0 and ". Converted "..names_text(r.converted).." to paths" or "").."."
end
-- The extra note for converting a Bump/wave: a curve through its crests, at most this far from its shape.
local function wave_note(objects)
    local worst
    for _,o in ipairs(objects) do
        if o.type=="prefab" and o.kind=="wave" then worst=math.max(worst or 0,edit.convert_deviation(o)) end
    end
    return worst and string.format(" (a Bump/wave becomes a curve through its crests and troughs, at most %.1f mm from its shape)",worst*1000) or ""
end
local function bulk_corner(self,smooth)
    local multi=editor.point_count()>=2
    local points=multi and editor.point_list() or {}
    local ids=editor.selected_ids()
    if not multi and #ids==0 then editor.message="Select lines, curves or points first.";return end
    local e=editor.doc.editor
    if not multi and smooth then
        local names,objects={},{}
        for _,id in ipairs(ids) do
            local o=find(id)
            if o.type=="prefab" and doc_lib.terrain(o) and not prefab.sample_error(o) then names[#names+1]=doc_lib.label(o);objects[#objects+1]=o end
        end
        local key=table.concat(ids,",")
        if #names>0 and not (self.confirm_bulk and self.confirm_bulk.key==key and self.confirm_bulk.revision==e.revision) then
            self.confirm_bulk={key=key,revision=e.revision}
            editor.message="Make smooth converts "..names_text(names).." to editable paths first: parameter fields and handles go; shapes and connections stay"..wave_note(objects)..". Click Sure? Make smooth."
            return
        end
    end
    self.confirm_bulk=nil
    local report
    if editor.commit(function(doc_e)
        local r,rep=edit.set_corners(doc_e,points,smooth,not multi and {objects=ids} or nil)
        report=r
        if not r then return nil,bulk_text(rep,smooth,true) end
    end,true) then
        -- Converted prefabs keep their ids; a Kicker's landing is a new line and joins the selection.
        for _,id in ipairs(report.objects or {}) do editor.selected[id]=true end
        editor.touch()
        editor.message=bulk_text(report,smooth)
    end
end
-- Corner / Smooth (LE5c): the point a click picked (a curve anchor, a line point or a joint, owned by the
-- upstream piece) and whether it is sharp now. Open ends have no corner; prefab points need a conversion.
local function smooth_state()
    local id,i
    local a=editor.anchor
    if a and a.id==editor.selection and find(a.id) then id,i=a.id,a.i
    elseif editor.vertex and find(editor.vertex.id) then
        local v=editor.vertex
        local o=find(v.id)
        id,i=v.id,(o.type=="curve" and v.index>1) and #o.anchors or v.index
    end
    if not id then return nil end
    -- The rule lives in edit.corner_state (shared with the bulk action, LE5d).
    return edit.corner_state(editor.doc.editor,id,i)
end
local function smooth_point(self)
    local st=smooth_state()
    if not st then editor.message="Select a point inside a line or curve, or a joint, first.";return end
    local rid,ri
    if editor.commit(function(e) local id,i=edit.set_corner(e,st.id,st.i,st.corner);rid,ri=id,i;if not id then return nil,i end end,true) then
        editor.select(rid);editor.anchor={id=rid,i=ri}
        editor.message=st.corner and "Smooth: the corner is rounded through the same point; drag its tangents (pink) to shape it." or "Corner: the point is sharp again."
    end
end
-- Convert to editable path asks once more and says what it removes (contract: LE5c).
local function convert_prefab(self)
    local o=editor.selection and find(editor.selection)
    if not (o and o.type=="prefab") then return end
    if self.confirm_convert~=o.id then
        self.confirm_convert,self.confirm_revision=o.id,editor.doc.editor.revision
        editor.message="Converting removes the "..prefab.name(o.kind).."'s parameter fields and handles; its shape and connections stay"..wave_note({o})..". Click Sure? to convert."
        return
    end
    self.confirm_convert=nil
    local ids
    if editor.commit(function(e) local list,err=edit.convert_prefab(e,o.id);ids=list;if not list then return nil,err end end,true) then
        editor.select(ids[1])
        editor.message="Converted to an editable path"..(#ids>1 and " ("..#ids.." lines; the jump gap stays open)" or "")..": its points can now be moved, smoothed [Make smooth] or deleted."
    end
end
-- Labels (LE6b): Label [L] places one at the snapped cursor (one Undo step) and focuses its text at once
-- (the whole text selected, so typing replaces it); a changed text is a second step. Double-click or the
-- panel's Text row edits it later. Station rule: at most 64 bytes, never empty.
local LABEL_TEXT="Label"
local function edit_label(self,id)
    local o=find(id)
    if not (o and o.type=="label") then return end
    self.field={text=o.text,initial=o.text,all=true,label=id}
    editor.message="Type the label text; Enter applies, Esc keeps it."
end
local function place_label(self,p)
    local q=snap(self,p)
    local id
    if editor.commit(function(e)
        id=editor.new_id()
        e.objects[#e.objects+1]={id=id,type="label",position={q[1],q[2]},text=LABEL_TEXT}
    end,true) then
        editor.select(id)
        edit_label(self,id)
    end
end
local function confirm_label(self,closing)
    local f=self.field
    local o=find(f.label)
    local t=f.text:match("^%s*(.-)%s*$")
    if not o then self.field=nil;return end
    if t=="" then
        editor.message=(closing and "Not applied: " or "").."A label cannot be empty."..(closing and " The previous text is kept." or "")
        if closing then self.field=nil end
        return
    end
    self.field=nil;editor.message=""
    if t~=o.text then
        editor.commit(function(e) local l=edit.find(e,f.label);l.text=t end,true)
    end
end
-- Number fields edit the same parameters as the handles; a choice field steps to its next value.
local function number_text(v) return (string.format("%.4f",v):gsub("0+$",""):gsub("%.$","")) end
local function param_rows(o)
    if o.type=="label" then return {{key="text",label="Text"}} end
    if o.type=="curve" then
        local a=editor.anchor
        local inner=a and a.id==o.id and a.i>1 and a.i<#o.anchors and o.anchors[a.i].mode~="corner"
        return inner and {{key="mode",label="Tangents",choices={"free","smooth","symmetric"}}} or {}
    end
    return prefab.fields(o.kind,o.params,true)
end
-- A curve anchor's tangent mode (LE5b): free tangents move independently; smooth keeps them on one line
-- (each keeps its length); symmetric mirrors them. Switching applies the mode to the in tangent.
local MODES={free="smooth",smooth="symmetric",symmetric="free"}
local function anchor_mode(id,i)
    local o=find(id)
    local anchors=doc_lib.copy(o.anchors)
    local a=anchors[i]
    a.mode=MODES[a.mode]
    local len=math.sqrt(a.out[1]^2+a.out[2]^2)
    if i>1 and i<#anchors and len>0 then
        if a.mode=="symmetric" then a["in"]={-a.out[1],-a.out[2]}
        elseif a.mode=="smooth" then
            local l=math.sqrt(a["in"][1]^2+a["in"][2]^2)
            a["in"]={-a.out[1]/len*l,-a.out[2]/len*l}
        end
    end
    apply_params(id,anchors)
end
local function param_click(self,i)
    local o=find(editor.selection)
    if o and o.type=="label" then edit_label(self,o.id);return end
    if o and o.type=="curve" then if editor.anchor then anchor_mode(o.id,editor.anchor.i) end;return end
    local f=o and o.type=="prefab" and param_rows(o)[i]
    if not f then return end
    if f.choices then
        local params,err=prefab.cycle(o.kind,o.params,f.key)
        if params then apply_params(o.id,params) else editor.message=err end
    else
        local t=number_text(o.params[f.key])
        self.field={text=t,initial=t,all=true,param=f.key,id=o.id,label=f.label,unit=f.unit}
        editor.message=string.format("Type %s (%s, %s to %s); Enter applies, Esc cancels.",f.label:lower(),f.unit,number_text(f.min),number_text(f.max))
    end
end
-- Applies a number field. Invalid input leaves the shape unchanged and keeps the field open with the
-- reason (close: a click elsewhere drops it with the same message).
local function confirm_param(self,closing)
    local f=self.field
    local o=find(f.id)
    if not o or f.text==f.initial then self.field=nil;editor.message="";return end
    local params,err=prefab.set(o.kind,o.params,f.param,f.text)
    if not params then
        editor.message=(closing and "Not applied: " or "")..err.." The previous value is kept."
        if closing then self.field=nil end
        return
    end
    self.field=nil;editor.message=""
    apply_params(o.id,params)
end
-- Export (R9, R12): only a playable level, compiled like Play; the file is the station JSON with its
-- editor block. Import opens a file as a copy in My levels (the HTML helper reads it; boot validates it).
local function export(self)
    if self.drawing then finish_drawing(self) end
    local level,err=editor.compile()
    if not level then editor.message="Export blocked: "..err;return end
    local text=json.encode(level,{encode_empty_table_as_object=false})
    if #text>custom.limit then editor.message="Export blocked: the level is larger than 256 KiB.";return end
    if not html5 then editor.message="Export needs the web build.";return end
    html5.run("window.riderCustom.exportLevel("..json.encode({name=level.id..".json",text=text})..")")
    editor.message=string.format("Exported %s.json (%.1f KiB).",level.id,#text/1024)
end
local function import(self)
    if not html5 then editor.message="Import needs the web build.";return end
    cancel(self)
    custom.open("Import a level file into the editor. It opens as a copy in My levels; nothing is overwritten.",true)
end
-- Rename (LE4): a text field. While it is focused every key acts on the field only (contract controls).
local function drop_char(t)
    local i=#t
    while i>0 and t:byte(i)>=128 and t:byte(i)<192 do i=i-1 end
    return t:sub(1,math.max(0,i-1))
end
local function confirm_name(self,closing)
    if self.field.param then confirm_param(self,closing);return end
    if self.field.label then confirm_label(self,closing);return end
    local name=self.field.text:match("^%s*(.-)%s*$")
    if name=="" then editor.message="A level name cannot be empty.";return end
    self.field=nil
    if name~=editor.doc.name then editor.commit(function(_,doc) doc.name=name end) end
end
local function set_tool(self,tool)
    if self.drawing and tool~=self.drawing.kind:gsub("line","draw") then finish_drawing(self) end
    editor.tool=tool;self.place=nil;editor.touch()
end
-- Navigation (LE6): view only. The camera moves and the selection may change; nothing is committed, so
-- the document, its dirty state and the Undo history stay unchanged.
-- The canvas area not covered by the panels (canvas pixels): left palette, right panel, top and bottom bars.
local function usable(self)
    local w,h=window.get_size()
    local k=self.overlay.k
    return {x0=100*k,x1=math.max(100*k+1,w-200*k),y0=26*k,y1=math.max(26*k+1,h-32*k)}
end
local function grow(b,x,y) b[1]=math.min(b[1],x);b[2]=math.max(b[2],x);b[3]=math.min(b[3],y);b[4]=math.max(b[4],y) end
local function empty_box() return {math.huge,-math.huge,math.huge,-math.huge} end
local function start_box(b,p) local v=doc_lib.VEHICLE;grow(b,p[1]+v[1],p[2]+v[3]);grow(b,p[1]+v[2],p[2]+v[4]) end
local function object_box(b,o) for _,q in ipairs(editor.shape(o)) do grow(b,q[1],q[2]) end end
-- Puts box (metres {x0, x1, y0, y1}) in the middle of the usable area. fit: zoom so it fills 80 % of the
-- area (in or out); otherwise the zoom is kept unless the box does not fit (then zoomed out). Returns
-- true when the zoom limit kept the box from fitting.
local function view_box(self,box,fit)
    local m=map()
    if not m or m.ppm_x==0 or m.ppm_y==0 then return false end
    local c,u=editor.camera,usable(self)
    local px,py=math.abs(m.ppm_x)/c.zoom,math.abs(m.ppm_y)/c.zoom
    local bw,bh=math.max(box[2]-box[1],1),math.max(box[4]-box[3],1)
    local z=math.min((u.x1-u.x0)*0.8/(bw*px),(u.y1-u.y0)*0.8/(bh*py))
    local limited=z<MIN_ZOOM
    if not fit then z=math.min(z,c.zoom) end
    z=math.max(MIN_ZOOM,math.min(MAX_ZOOM,z))
    -- The camera centre stays at the same canvas pixel; the box centre goes to the usable area's centre.
    local cx,cy=m.ox+c.x*m.ppm_x,m.oy+c.y*m.ppm_y
    local nx,ny=m.ppm_x*z/c.zoom,m.ppm_y*z/c.zoom
    c.x=(box[1]+box[2])/2-((u.x0+u.x1)/2-cx)/nx
    c.y=(box[3]+box[4])/2-((u.y0+u.y1)/2-cy)/ny
    c.zoom=z
    return limited
end
local function fit_level(self)
    local b=doc_lib.extent(editor.doc.editor)
    local limited=view_box(self,b,true)
    editor.message=limited and string.format("Fit level: the level is %.0f m wide; this is the farthest zoom (its centre is shown).",b[2]-b[1]) or ""
end
-- The selection's box: selected points, the single point, START/FINISH or the selected objects.
local function selection_box()
    local b=empty_box()
    local e=editor.doc.editor
    local s=editor.selection
    if s=="start" then start_box(b,e.start.position)
    elseif s=="finish" and e.finish then local f=e.finish.position;grow(b,f[1],f[2]-doc_lib.FINISH_BELOW);grow(b,f[1],f[2]+doc_lib.FINISH_ABOVE)
    elseif editor.point_count()>=2 then
        for _,pt in ipairs(editor.point_list()) do local q=point_pos(pt);if q then grow(b,q[1],q[2]) end end
    else
        for _,id in ipairs(editor.selected_ids()) do object_box(b,find(id)) end
    end
    if b[1]>b[2] then return nil end
    return b
end
local function centre_selection(self)
    local b=selection_box()
    if not b then editor.message="Centre selection: nothing is selected. Select objects, points, START or FINISH first.";return end
    view_box(self,b,false)
    editor.message=""
end
local function go_start(self)
    local b=empty_box();start_box(b,editor.doc.editor.start.position)
    view_box(self,b,false);editor.message=""
end
local function go_last_test(self)
    local p=editor.last_test_start()
    if not p then editor.message="Last test start: none yet in this level. Press F (or Shift+F) to start a test run here first.";return end
    local b=empty_box();start_box(b,p)
    view_box(self,b,false)
    editor.message=string.format("Last test start: x %.2f m  y %.2f m.",p[1],p[2])
end
-- The R13 bounds of the current revision (cached; LE6 bounds display and panel).
local function current_bounds(self)
    local e=editor.doc.editor
    local key=tostring(editor.doc)..":"..e.revision
    if self.bounds_key~=key then self.bounds_key,self.bounds=key,doc_lib.bounds(e) end
    return self.bounds
end
-- Whether Centre has something to centre (cheap: no shapes; selection_box computes the box on use).
local function has_selection()
    local s=editor.selection
    if s=="start" or (s=="finish" and editor.doc.editor.finish) then return true end
    return editor.point_count()>=2 or next(editor.selected)~=nil
end
-- Warning list (LE6): every error, the display note and every warning, each with its target if any.
local function problem_rows()
    local rows={}
    for i,m in ipairs(editor.errors) do rows[#rows+1]={text=m,error=true,target=editor.error_at[i]} end
    if editor.display_note then rows[#rows+1]={text=editor.display_note} end
    for i,m in ipairs(editor.warnings) do rows[#rows+1]={text=m,target=editor.warning_at[i]} end
    return rows
end
-- Jump to a problem: its source objects are resolved by stable id in the current document (a deleted one
-- is skipped, never navigated to), selected and centred; a message without a target only shows its text.
local function show_problem(self,row)
    local kind=row.error and "Error: " or "Warning: "
    local t=row.target
    local ids={}
    for _,id in ipairs(t and t.ids or {}) do if find(id) then ids[#ids+1]=id end end
    if not t or (#ids==0 and not t.start and not t.at) then
        editor.message=kind..row.text..(t and " (its source no longer exists)" or "")
        return
    end
    local b=empty_box()
    if t.at then
        -- A located message: a few metres around the spot, so the spot stays in view.
        grow(b,t.at[1]-3,t.at[2]-2);grow(b,t.at[1]+3,t.at[2]+2)
    else
        for _,id in ipairs(ids) do object_box(b,find(id)) end
        if t.start then start_box(b,editor.doc.editor.start.position) end
    end
    if t.start then editor.select("start")
    else
        editor.select(ids[1])
        for _,id in ipairs(ids) do editor.selected[id]=true end
        editor.touch()
    end
    view_box(self,b,false)
    self.flash={p=t.at or {(b[1]+b[2])/2,(b[3]+b[4])/2},until_t=socket.gettime()+2}
    editor.message=kind..row.text
end
-- Help is modal and consumes input, so a piece being drawn stays as it is (neither finished nor dropped).
local function open_help(self)
    cancel(self)
    self.help_open,self.warnings_open,self.open_dialog=true,false,false
    editor.message=""
end
local function on_button(self,name)
    if name~="libdel_"..(self.confirm_row or "") then self.confirm_delete=nil end
    if name~="convert" then self.confirm_convert=nil end
    if name~="smooth_all" then self.confirm_bulk=nil end
    if name=="undo" or name=="redo" then
        if editor.undo(name=="undo")==false then editor.message="Nothing to "..name.."." end
    elseif name=="open" then
        self.open_dialog=not self.open_dialog
        -- The warning list closes under a dialog (its rows would take the dialog's clicks).
        if self.open_dialog then self.page,self.tpl_page,self.warnings_open=0,0,false;refresh_library(self) end
    elseif name=="new" then new_level(self)
    elseif name=="export" then export(self)
    elseif name=="import" then import(self)
    elseif name=="rename" then
        -- The whole name starts selected: typing replaces it, Backspace clears it.
        self.field={text=editor.doc.name,all=true};editor.message="Type the level name; Enter confirms, Esc cancels."
    elseif name=="mirror_left" or name=="mirror_right" then mirror(self,name=="mirror_left" and -1 or 1)
    elseif name=="smooth" then smooth_point(self)
    elseif name=="convert" then convert_prefab(self)
    elseif name=="smooth_all" or name=="corner_all" then bulk_corner(self,name=="smooth_all")
    elseif name:match("^param_%d$") then param_click(self,tonumber(name:sub(7)))
    elseif name:match("^kind_") then editor.prefab_kind=name:sub(6);set_tool(self,"prefab")
    elseif name=="paste" then paste_at(self,{editor.camera.x,editor.camera.y})
    elseif name=="dialog_close" then self.open_dialog=false
    elseif name=="lib_newer" then self.page=math.max(0,self.page-1)
    elseif name=="lib_older" then self.page=self.page+1
    elseif name:match("^lib_%d+$") then
        local l=self.library[self.page*ROWS+tonumber(name:sub(5))]
        if l then open_saved(self,l.key) end
    elseif name:match("^libdel_%d+$") then
        local row=tonumber(name:sub(8))
        local l=self.library[self.page*ROWS+row]
        if l then self.confirm_row=row;delete_saved(self,l.key) end
    elseif name=="conflict_source" then
        editor.conflict=nil;editor.message="Opened the editor source; Play and Export recompile from it."
    elseif name=="conflict_lines" then
        -- The line copy replaces the source in My levels: it takes the source's key (saved first).
        local c=editor.conflict
        editor.flush()
        if not editor.open(c.lines,true,{key=editor.key(),store=editor.store[editor.opened]}) then return end
        opened(self)
        editor.message="Opened the compiled geometry as editable lines (one Undo step back to the source)."
    elseif name=="play" then play(self)
    elseif name:match("^tool_") then set_tool(self,name:sub(6))
    elseif name:match("^template_") then open_template(self,name:sub(10))
    elseif name=="minus" or name=="plus" then
        local step=(name=="plus" and 1 or -1)*(self.held.shift and 5 or 0.5)
        if editor.selection=="start" then
            local speed=math.max(-30,math.min(30,editor.doc.editor.start.speed+step))
            editor.commit(function(e) e.start.speed=speed end)
        else editor.test_speed=math.max(-30,math.min(30,editor.test_speed+step));editor.touch() end
    elseif name=="direction" and editor.doc.editor.finish then
        editor.commit(function(e) e.finish.direction=-e.finish.direction end)
    elseif name=="delete" then delete(self)
    elseif name=="split" then split(self)
    elseif name=="connect" or name=="disconnect" then connect(self)
    elseif name=="warnings" then self.warnings_open,self.open_dialog=not self.warnings_open,false;self.warn_page=0
    elseif name:match("^warn_%d$") then
        local row=(self.problem_rows or {})[(self.warn_page or 0)*WARN_ROWS+tonumber(name:sub(6))]
        if row then show_problem(self,row) end
    elseif name=="warn_prev" then self.warn_page=math.max(0,(self.warn_page or 0)-1)
    elseif name=="warn_next" then self.warn_page=(self.warn_page or 0)+1
    elseif name=="tpl_prev" then self.tpl_page=math.max(0,(self.tpl_page or 0)-1)
    elseif name=="tpl_next" then self.tpl_page=(self.tpl_page or 0)+1
    elseif name=="view_fit" then fit_level(self)
    elseif name=="view_centre" then centre_selection(self)
    elseif name=="view_start" then go_start(self)
    elseif name=="view_test" then go_last_test(self)
    elseif name=="view_help" then open_help(self)
    elseif name=="view_ghost" then
        editor.show_ghost=not editor.show_ghost;editor.touch()
        editor.message=editor.show_ghost and "Ghost on: the vehicle shows where F would start a test run." or "Ghost off."
    elseif name=="view_bounds" then
        editor.show_bounds=not editor.show_bounds;editor.touch()
        editor.message=editor.show_bounds and "Bounds shown: the safety bounds Play, Export and test starts use (computed automatically)." or ""
    end
end
local function vertex_state()
    local v=editor.vertex
    if not v then return nil end
    local o=find(v.id)
    if not o then return nil end
    return {inner=v.index>1 and v.index<#path(o),joint=edit.joint(editor.doc.editor,v.id,v.index)~=nil,o=o}
end
local function visible_buttons(self)
    -- The R1 choice is modal: nothing else is offered until it is made; so is the help overlay (LE6b).
    if editor.conflict then return {"conflict_source","conflict_lines"} end
    if self.help_open then return {"help_close"} end
    local list={}
    -- The open warning list lies over other controls: its rows are hit first (LE6).
    if self.warnings_open and not self.open_dialog then
        local rows=self.problem_rows or {}
        local page=self.warn_page or 0
        for i=1,WARN_ROWS do if rows[page*WARN_ROWS+i] then list[#list+1]="warn_"..i end end
        if page>0 then list[#list+1]="warn_prev" end
        if (page+1)*WARN_ROWS<#rows then list[#list+1]="warn_next" end
    end
    for _,name in ipairs({"undo","redo","new","open","import","export","play","minus","plus","tool_select","tool_draw","tool_curve","tool_prefab","tool_start","tool_finish","tool_label","tool_pan","warnings"}) do list[#list+1]=name end
    for _,v in ipairs(VIEW) do list[#list+1]=v[1] end
    if editor.tool=="prefab" then for _,kind in ipairs(prefab.ORDER) do list[#list+1]="kind_"..kind end end
    local vs=vertex_state()
    if editor.selection=="finish" then list[#list+1]="direction"
    elseif editor.selection and editor.selection~="start" then list[#list+1]="delete"
    elseif not editor.selection then list[#list+1]="rename" end
    if vs then
        if vs.inner then list[#list+1]="split" end
        list[#list+1]=vs.joint and "disconnect" or (not vs.inner and "connect") or nil
    end
    local o=editor.selection and find(editor.selection)
    -- A curve's inner anchor splits there (LE5b).
    local a=editor.anchor
    if o and o.type=="curve" and a and a.id==o.id and a.i>1 and a.i<#o.anchors and not (vs and vs.inner) then list[#list+1]="split" end
    local st=smooth_state()
    if editor.point_count()>=2 or (not st and object_corner_mode()) then list[#list+1]="smooth_all";list[#list+1]="corner_all"
    elseif st then list[#list+1]="smooth" end
    if o and o.type=="prefab" and doc_lib.terrain(o) and #editor.selected_ids()==1 then list[#list+1]="convert" end
    if o and (o.type=="prefab" or o.type=="curve" or o.type=="label") and #editor.selected_ids()==1 then
        for i=1,#param_rows(o) do list[#list+1]="param_"..i end
    end
    if next(editor.selected) then list[#list+1]="mirror_left";list[#list+1]="mirror_right" end
    if editor.clipboard then list[#list+1]="paste" end
    if self.open_dialog then
        local tp=self.tpl_page or 0
        for i=tp*TEMPLATE_ROWS+1,math.min(#self.templates,(tp+1)*TEMPLATE_ROWS) do list[#list+1]=self.templates[i] end
        if tp>0 then list[#list+1]="tpl_prev" end
        if (tp+1)*TEMPLATE_ROWS<#self.templates then list[#list+1]="tpl_next" end
        local count=#(self.library or {})
        for i=1,ROWS do
            local l=self.library[self.page*ROWS+i]
            if l then
                list[#list+1]="lib_"..i
                if l.key~=editor.key() then list[#list+1]="libdel_"..i end
            end
        end
        if self.page>0 then list[#list+1]="lib_newer" end
        if (self.page+1)*ROWS<count then list[#list+1]="lib_older" end
        list[#list+1]="dialog_close"
    end
    return list
end
local function hit(self,action)
    for _,name in ipairs(visible_buttons(self)) do
        if gui.pick_node(self.buttons[name].box,action.x,action.y) then return name end
    end
    if self.warnings_open and not self.open_dialog and gui.pick_node(self.warning_panel,action.x,action.y) then return "warning_panel" end
    if self.open_dialog and gui.pick_node(self.dialog_nodes[1],action.x,action.y) then return "dialog_panel" end
    if editor.conflict then return "conflict_panel" end
end
-- Translating a selection: each connected run moves once (R4, R17); the grabbed object's nearest
-- point snaps (anchors outside the moving set, Shift 15 degree directions, grid).
local function start_move(self,c,p)
    local e=editor.doc.editor
    local ids=editor.selected_ids()
    local list,set=edit.closure(e,ids)
    local o=find(c.id)
    local ref
    for _,q in ipairs(path(o)) do if not ref or dist(p,q)<dist(p,ref) then ref=q end end
    local base={}
    for _,id in ipairs(list) do base[id]=doc_lib.copy(find(id)) end
    self.drag={kind="move",ids=ids,list=list,skip=set,ref={ref[1],ref[2]},press={p[1],p[2]},press_px=self.cursor_px,base=base,delta={0,0},moved=false}
end
local function start_vertex(self,c,p)
    local e=editor.doc.editor
    local o=find(c.id)
    local skip={vertex={[c.id..":"..c.index]=true}}
    -- An exit point carries its downstream run along: those points never snap to themselves.
    if c.index==#o.points then
        for _,id in ipairs(edit.downstream(e,c.id)) do skip[id]=true end
    end
    local from=o.points[c.index>1 and c.index-1 or 2]
    self.drag={kind="vertex",id=c.id,index=c.index,skip=skip,from={from[1],from[2]},origin={o.points[c.index][1],o.points[c.index][2]},
        offset={p[1]-o.points[c.index][1],p[2]-o.points[c.index][2]},press_px=self.cursor_px,moved=false}
end
-- Dragging a prefab handle changes its parameters (R4: the entry stays fixed, the downstream run moves);
-- the drag delta is converted by prefab.drag with the active snapping.
local function start_handle(self,id,name,p)
    local o=find(id)
    self.drag={kind="handle",id=id,handle=name,p0=doc_lib.copy(o.params or o.anchors),press={p[1],p[2]},press_px=self.cursor_px,moved=false}
    if o.type=="curve" then
        -- An anchor drag snaps (never to its own curve, nor to a downstream run it carries along); Shift
        -- keeps 15 degree directions from the neighbouring anchor.
        local i=tonumber(name:sub(2))
        local skip={[id]=true}
        if i==#o.anchors then for _,d in ipairs(edit.downstream(editor.doc.editor,id)) do skip[d]=true end end
        local from=o.anchors[i>1 and i-1 or 2].p
        -- Only an anchor drag snaps (and shows the snap marker); tangents never snap to points.
        if name:sub(1,1)=="a" then self.drag.skip,self.drag.from=skip,{from[1],from[2]} end
        -- A smoothed joint (LE5c): the neighbouring piece holds the other tangent, which follows.
        local next,prev=doc_lib.links(editor.doc.editor)
        local kind=name:sub(1,1)
        local pid=(kind=="i" and i==#o.anchors and next[id]) or (kind=="o" and i==1 and prev[id])
        local po=pid and find(pid)
        if po and po.type=="curve" then
            local pi,pkey=kind=="i" and 1 or #po.anchors,kind=="i" and "out" or "in"
            local b,t=po.anchors[pi],o.anchors[i][kind=="i" and "in" or "out"]
            local bt=b[pkey]
            -- Only a smoothed joint couples: the other side is no corner and its tangent already points
            -- the opposite way (a joint left with a kink stays independent).
            local lt,lb=length(t),length(bt)
            if b.mode~="corner" and lt>0 and lb>0 and (t[1]*bt[1]+t[2]*bt[2])/(lt*lb)<-0.9999 then
                self.drag.partner={id=pid,i=pi,key=pkey,p0=doc_lib.copy(po.anchors)}
            end
        end
        editor.anchor={id=id,i=i};editor.touch()
    end
end
local function anchor_key(anchors)
    local t={}
    for _,a in ipairs(anchors) do t[#t+1]=string.format("%.17g,%.17g,%.17g,%.17g,%.17g,%.17g,%s",a.p[1],a.p[2],a["in"][1],a["in"][2],a.out[1],a.out[2],a.mode) end
    return table.concat(t,";")
end
-- A curve handle drag: an anchor moves (snapped; its tangents move with it), a tangent changes and its
-- partner follows the anchor's mode (smooth: on one line, symmetric: mirrored, free: unchanged).
local function curve_drag(self,drag,p)
    local anchors=doc_lib.copy(drag.p0)
    local kind,i=drag.handle:sub(1,1),tonumber(drag.handle:sub(2))
    local a=anchors[i]
    local d={p[1]-drag.press[1],p[2]-drag.press[2]}
    if kind=="a" then
        a.p=snap(self,{a.p[1]+d[1],a.p[2]+d[2]},drag.skip,drag.from)
        return anchors
    end
    local key,other=kind=="i" and "in" or "out",kind=="i" and "out" or "in"
    local t={a[key][1]+d[1],a[key][2]+d[2]}
    if self.held.shift and not self.held.ctrl then
        local l,step=length(t),math.rad(snap_lib.ANGLE)
        local angle=math.floor(math.atan2(t[2],t[1])/step+0.5)*step
        t={l*math.cos(angle),l*math.sin(angle)}
    end
    a[key]=t
    local lt=length(t)
    if ((other=="in" and i>1) or (other=="out" and i<#anchors)) and lt>0 then
        if a.mode=="symmetric" then a[other]={-t[1],-t[2]}
        elseif a.mode=="smooth" then local l=length(a[other]);a[other]={-t[1]/lt*l,-t[2]/lt*l} end
    end
    local pt=drag.partner
    if pt and lt>0 and (a.mode=="smooth" or a.mode=="symmetric") then
        local partner=doc_lib.copy(pt.p0)
        local b=partner[pt.i]
        if a.mode=="symmetric" then b[pt.key]={-t[1],-t[2]}
        else local l=length(b[pt.key]);b[pt.key]={-t[1]/lt*l,-t[2]/lt*l} end
        drag.partner_anchors=partner
    end
    return anchors
end
-- The Bezier segment and parameter nearest to p (for inserting an anchor on a selected curve).
local function curve_nearest(o,p)
    local best,bi,bt
    for i=1,#o.anchors-1 do
        local a,b=o.anchors[i],o.anchors[i+1]
        local p0,p3=a.p,b.p
        local p1,p2={p0[1]+a.out[1],p0[2]+a.out[2]},{p3[1]+b["in"][1],p3[2]+b["in"][2]}
        if a.mode=="corner" and b.mode=="corner" then
            -- A straight chord (LE5c): the click projected onto it (insert_anchor places corners linearly).
            local t=seg_t(p,p0,p3)
            local dd=dist(p,{p0[1]+(p3[1]-p0[1])*t,p0[2]+(p3[2]-p0[2])*t})
            if t>0 and t<1 and (not best or dd<best) then best,bi,bt=dd,i,t end
        else for k=1,63 do
            local t=k/64;local u=1-t
            local q={u*u*u*p0[1]+3*u*u*t*p1[1]+3*u*t*t*p2[1]+t*t*t*p3[1],u*u*u*p0[2]+3*u*u*t*p1[2]+3*u*t*t*p2[2]+t*t*t*p3[2]}
            local dd=dist(p,q)
            if not best or dd<best then best,bi,bt=dd,i,t end
        end end
    end
    return bi,bt
end
-- Dragging one point of a multi-point selection moves all of them (LE5d): the grabbed point snaps
-- (never to a moving point or a run carried along), each point moves once (edit.move_points).
local function start_points(self,pt,p)
    local e=editor.doc.editor
    local list=editor.point_list()
    local skip={vertex={}}
    for _,q in ipairs(list) do
        local o=find(q.id)
        if o.type=="line" then skip.vertex[q.id..":"..q.i]=true else skip[q.id]=true end
        if q.i==point_total(o) then for _,d in ipairs(edit.downstream(e,q.id)) do skip[d]=true end end
    end
    local ref=point_pos(pt)
    self.drag={kind="points",points=list,grab=pt,skip=skip,ref={ref[1],ref[2]},press={p[1],p[2]},press_px=self.cursor_px,delta={0,0},moved=false}
end
local function prefab_end_handle(o,index)
    for _,h in ipairs(prefab_handles(o)) do if h.index==index then return h.name end end
end
local function canvas_press(self,action)
    local p=cursor(self,action)
    if not p then return end
    self.confirm_convert,self.confirm_bulk,self.pending=nil,nil,nil
    if self.held.space or editor.tool=="pan" then self.pan={action.screen_x,action.screen_y};return end
    if editor.tool=="start" or editor.tool=="finish" then place(editor.tool,p);return end
    if editor.tool=="prefab" then place_prefab(self,p);self.place=nil;return end
    if editor.tool=="label" then place_label(self,p);return end
    local now=socket.gettime()
    local px=self.cursor_px
    local double=self.last_press and now-self.last_press.t<=DOUBLE_S and dist(px,self.last_press.px)<=DOUBLE_PX*ui
    -- A Shift+click only changes the selection; it never starts a double-click.
    self.last_press=not self.held.shift and {t=now,px={px[1],px[2]}} or nil
    if drawing_tool() then
        if self.drawing and self.drawing.opened~=editor.opened then self.drawing=nil end
        local d=self.drawing
        local last=d and d.points[#d.points]
        local q,kind,anchor=snap(self,p,nil,last,d and {unpack(d.points,1,#d.points-1)} or nil)
        if not d then
            -- Curve [C] places anchors like Draw places points; their tangents are set automatically.
            self.drawing={kind=editor.tool=="curve" and "curve" or "line",points={q},anchored={kind=="anchor"},opened=editor.opened}
        elseif double or dist(q,last)<0.01 then finish_drawing(self)
        else
            d.points[#d.points+1]=q;d.anchored[#d.points]=kind=="anchor"
            -- Ending on another free end connects there and completes the piece (R5).
            if kind=="anchor" and anchor.end_free then finish_drawing(self) end
        end
        editor.touch()
        return
    end
    -- Select tool.
    local list=candidates(p)
    set_hover(self,list)
    local c=list[self.hover_index]
    if double and c and c.kind=="object" and c.type=="label" then
        -- Double-click on a label edits its text (LE6b).
        editor.select(c.id);edit_label(self,c.id)
        self.last_press=nil
        return
    end
    if double and c and c.kind=="object" and c.type=="curve" and editor.selected[c.id] then
        -- Double-click on a selected curve inserts an anchor on it (de Casteljau; shape unchanged).
        local i,t=curve_nearest(find(c.id),p)
        local index
        if editor.commit(function(e) local k,err=edit.insert_anchor(e,c.id,i,t);index=k;if not k then return nil,err end end,true) then
            editor.select(c.id);editor.anchor={id=c.id,i=index}
        end
        self.last_press=nil
        return
    end
    if double and c and c.kind=="object" and c.type=="line" and editor.selected[c.id] then
        -- Double-click on a selected line inserts a point exactly on the segment (shape unchanged).
        local o=find(c.id)
        local a,b=o.points[c.segment],o.points[c.segment+1]
        local t=seg_t(p,a,b)
        -- With grid snap the point gets a grid x (y for a vertical segment), still on the segment.
        local step=not self.held.ctrl and (self.held.alt and snap_lib.FINE or editor.grid and snap_lib.GRID)
        local axis=math.abs(b[1]-a[1])>1e-9 and 1 or 2
        local exact
        if step then
            local v=snap_lib.round(a[axis]+(b[axis]-a[axis])*t,step)
            local u=(v-a[axis])/(b[axis]-a[axis])
            if u>0 and u<1 then t,exact=u,v end
        end
        local q={a[1]+(b[1]-a[1])*t,a[2]+(b[2]-a[2])*t}
        if exact then q[axis]=exact end
        local index
        if editor.commit(function(e) local i,err=edit.insert_point(e,c.id,c.segment,q);index=i;if not i then return nil,err end end,true) then
            editor.select(c.id,{id=c.id,index=index})
        end
        self.last_press=nil
        return
    end
    if not c then
        -- With lines or curves selected, the box selects their points (LE5d); it falls back to the LE3b
        -- object box when it catches none, so the selection is cleared only on release then.
        local points=has_paths()
        if not self.held.shift and not points then editor.select(nil) end
        self.box={from={p[1],p[2]},to={p[1],p[2]},add=self.held.shift,points=points}
        return
    end
    if self.held.shift and c.kind=="object" then editor.toggle(c.id);return end
    if self.held.shift and (c.kind=="vertex" or c.kind=="handle") then
        if c.kind=="vertex" then
            -- Shift+click a second free end: the pair Connect [J] joins or bridges (LE3b, takes precedence).
            local e=editor.doc.editor
            local v=editor.vertex
            local function free(x) local o=find(x.id);return o and x.index and (x.index==1 or x.index==#path(o)) and not edit.joint(e,x.id,x.index) end
            if v and free(v) and free(c) and not (c.id==v.id and c.index==v.index) then editor.vertex2={id=c.id,index=c.index};editor.touch();return end
        end
        -- Shift+click on a point of a selected line or curve adds or removes it (LE5d). On an anchor handle
        -- the decision waits for the release: Shift+drag keeps its 15 degree anchor drag (LE5b).
        local pt=point_of(c)
        if pt then
            if c.kind=="handle" then self.pending={c=c,p={p[1],p[2]},px=self.cursor_px,pt=pt} else toggle_point(pt) end
            return
        end
        if c.kind=="vertex" then editor.message="Shift+click picks a second free end after selecting a free end.";return end
    end
    -- Pressing a point of a multi-point selection drags them all; a click without moving selects only it.
    local pt=editor.point_count()>=2 and (c.kind=="vertex" or c.kind=="handle") and point_of(c)
    if pt and editor.points[pt.id..":"..pt.i] then start_points(self,pt,p);return end
    if c.kind~="start" and c.kind~="finish" then editor.points={} end
    if c.kind=="handle" then
        editor.selection,editor.vertex,editor.vertex2,editor.anchor=c.id,c.index and {id=c.id,index=c.index} or nil,nil,nil;editor.touch()
        start_handle(self,c.id,c.handle,p)
    elseif c.kind=="vertex" then
        if not editor.selected[c.id] then editor.select(c.id,{id=c.id,index=c.index})
        else editor.selection,editor.vertex,editor.vertex2,editor.anchor=c.id,{id=c.id,index=c.index},nil,nil;editor.touch() end
        local o=find(c.id)
        if o.type=="prefab" then
            -- A prefab end: its exit handle changes parameters; otherwise the whole run moves.
            local name=prefab_end_handle(o,c.index)
            if name then start_handle(self,c.id,name,p) else start_move(self,c,p) end
        elseif o.type=="curve" then start_handle(self,c.id,"a"..(c.index==1 and 1 or #o.anchors),p)
        else start_vertex(self,c,p) end
    elseif c.kind=="start" or c.kind=="finish" then
        editor.select(c.id)
        local origin=c.id=="start" and editor.doc.editor.start.position or editor.doc.editor.finish.position
        self.drag={kind="marker",target=c.id,offset={p[1]-origin[1],p[2]-origin[2]},origin={origin[1],origin[2]},moved=false}
        editor.preview={target=c.id,position={origin[1],origin[2]}}
    else
        if not editor.selected[c.id] then editor.select(c.id)
        else editor.selection,editor.vertex,editor.anchor=c.id,nil,nil;editor.touch() end
        start_move(self,c,p)
    end
end
local function canvas_move(self,action)
    local p=cursor(self,action)
    local s=map()
    if self.pan and action.screen_x and s then
        editor.camera.x=editor.camera.x-(action.screen_x-self.pan[1])/s.ppm_x
        editor.camera.y=editor.camera.y-(action.screen_y-self.pan[2])/s.ppm_y
        self.pan={action.screen_x,action.screen_y}
        return
    end
    if not p then return end
    local pend=self.pending
    if pend and self.cursor_px and dist(self.cursor_px,pend.px)>=DOUBLE_PX*ui then
        -- A Shift+press on an anchor that moves is the LE5b anchor drag (Shift: 15 degree steps).
        self.pending=nil
        local c=pend.c
        editor.points={}
        editor.selection,editor.vertex,editor.vertex2,editor.anchor=c.id,c.index and {id=c.id,index=c.index} or nil,nil,nil;editor.touch()
        start_handle(self,c.id,c.handle,pend.p)
        self.drag.press_px=pend.px
    end
    local drag=self.drag
    if drag and drag.kind=="marker" then
        local q={p[1]-drag.offset[1],p[2]-drag.offset[2]}
        -- A click without movement selects only; it is not an edit.
        if q[1]~=drag.origin[1] or q[2]~=drag.origin[2] then
            editor.preview={target=drag.target,position=q}
            drag.moved=true
            editor.touch()
        end
    elseif drag and drag.kind~="marker" and not drag.moved and dist(self.cursor_px,drag.press_px)<DOUBLE_PX*ui then
        -- A click is not a drag: snapping must not move an off-grid object that was only clicked.
        return
    elseif drag and drag.kind=="vertex" then
        local raw={p[1]-drag.offset[1],p[2]-drag.offset[2]}
        local q=snap(self,raw,drag.skip,drag.from)
        if drag.moved or q[1]~=drag.origin[1] or q[2]~=drag.origin[2] then
            drag.moved,drag.to=true,q
            local e=doc_lib.copy(editor.doc.editor)
            local preview={}
            for _,id in ipairs(edit.move_vertex(e,drag.id,drag.index,q)) do preview[id]=edit.find(e,id) end
            editor.set_preview(preview)
        end
    elseif drag and drag.kind=="handle" then
        local o=find(drag.id)
        local params,changed
        if o.type=="curve" then
            params=curve_drag(self,drag,p)
            local key=anchor_key(params)
            changed=key~=(drag.key or anchor_key(drag.p0));drag.key=key
        else
            params=prefab.drag(o,drag.handle,drag.p0,{p[1]-drag.press[1],p[2]-drag.press[2]},steps(self))
            changed=not same_params(params,drag.params or drag.p0)
        end
        if changed then
            drag.moved,drag.params=true,params
            -- Preview: the reshaped piece and the moved downstream run; a new Play-blocking error is shown
            -- as a conflict before the release applies it.
            local e=doc_lib.copy(editor.doc.editor)
            local moved=(o.type=="curve" and edit.set_anchors or edit.set_params)(e,drag.id,params) or {}
            if drag.partner_anchors and edit.set_anchors(e,drag.partner.id,doc_lib.copy(drag.partner_anchors)) then
                local listed=false
                for _,id in ipairs(moved) do listed=listed or id==drag.partner.id end
                if not listed then moved[#moved+1]=drag.partner.id end
            end
            local preview={}
            for _,id in ipairs(moved) do preview[id]=edit.find(e,id) end
            drag.downstream=math.max(0,#moved-1)
            -- The same checks as live validation: the domain rules and the compile (START overlap).
            local known={}
            for _,m in ipairs(editor.errors) do known[m]=true end
            local copy={schema=1,units="metres",id=editor.doc.id,name=editor.doc.name,editor=e}
            local errors=doc_lib.problems(e)
            local _,cerr=doc_lib.compile(copy,nil,errors)
            if cerr and errors[1]~=cerr then errors[#errors+1]=cerr end
            drag.conflict=nil
            for _,m in ipairs(errors) do if not known[m] then drag.conflict=m;break end end
            editor.set_preview(preview)
        end
    elseif drag and drag.kind=="points" then
        local raw={drag.ref[1]+p[1]-drag.press[1],drag.ref[2]+p[2]-drag.press[2]}
        local q=snap(self,raw,drag.skip,drag.ref)
        local d={q[1]-drag.ref[1],q[2]-drag.ref[2]}
        if drag.moved or d[1]~=0 or d[2]~=0 then
            drag.moved,drag.delta=true,d
            local e=doc_lib.copy(editor.doc.editor)
            local preview={}
            for _,id in ipairs(edit.move_points(e,drag.points,d) or {}) do preview[id]=edit.find(e,id) end
            editor.set_preview(preview)
        end
    elseif drag and drag.kind=="move" then
        local raw={drag.ref[1]+p[1]-drag.press[1],drag.ref[2]+p[2]-drag.press[2]}
        local q=snap(self,raw,drag.skip,drag.ref)
        local d={q[1]-drag.ref[1],q[2]-drag.ref[2]}
        if drag.moved or d[1]~=0 or d[2]~=0 then
            drag.moved,drag.delta=true,d
            local preview={}
            for id,o in pairs(drag.base) do
                local t=doc_lib.copy(o);edit.translate_object(t,d)
                preview[id]=t
            end
            editor.set_preview(preview)
        end
    elseif self.box then self.box.to={p[1],p[2]}
    elseif drawing_tool() then
        local d=self.drawing
        snap(self,p,nil,d and d.points[#d.points],d and {unpack(d.points,1,#d.points-1)} or nil)
    elseif editor.tool=="prefab" then self.place=placement(self,p)
    elseif editor.tool=="select" then set_hover(self,candidates(p)) end
end
local function box_select(self,b)
    local x0,x1=math.min(b.from[1],b.to[1]),math.max(b.from[1],b.to[1])
    local y0,y1=math.min(b.from[2],b.to[2]),math.max(b.from[2],b.to[2])
    if not b.add then editor.selected={} end
    -- An object is picked when the box contains one of its points or one of its edges crosses the box.
    local box={x0,x1,y0,y1}
    for _,o in ipairs(editor.doc.editor.objects) do
        local closed=doc_lib.outline(o)
        local hit=false
        for _,pts in ipairs(closed and {closed} or o.type=="label" and {{o.position}} or doc_lib.parts(o)) do
            for i,q in ipairs(pts) do
                if q[1]>=x0 and q[1]<=x1 and q[2]>=y0 and q[2]<=y1 then hit=true;break end
                local r=pts[i+1] or (closed and pts[1])
                if r and doc_lib.segment_box(q,r,box) then hit=true;break end
            end
            if hit then break end
        end
        if hit then editor.selected[o.id]=true end
    end
    editor.selection,editor.vertex,editor.vertex2,editor.anchor,editor.points=next(editor.selected),nil,nil,nil,{}
    for _,o in ipairs(editor.doc.editor.objects) do if editor.selected[o.id] then editor.selection=o.id;break end end
    editor.touch()
end
local function canvas_release(self)
    self.pan=nil
    local drag,box=self.drag,self.box
    self.drag,self.box=nil,nil
    if self.pending then
        -- A Shift+click on an anchor without moving: add or remove that point (LE5d).
        local pt=self.pending.pt
        self.pending=nil
        toggle_point(pt)
        return
    end
    if box then
        -- A click on empty space only clears the selection; a real drag selects what it touches: the points
        -- of the selected lines and curves inside it (LE5d), or else objects (LE3b).
        local s=map()
        if s and dist(to_px(box.from,s),to_px(box.to,s))>=DOUBLE_PX*ui then
            local found=box.points and box_points(box)
            if found then
                if not box.add then editor.points={} elseif editor.point_count()==0 then
                    local s1=single_point()
                    if s1 then editor.points[s1.id..":"..s1.i]=s1 end
                end
                for k,pt in pairs(found) do editor.points[k]=pt end
                settle_points(editor.selection)
                return
            end
            if box.points and not box.add then editor.select(nil) end
            box_select(self,box)
        elseif box.points and not box.add then editor.select(nil) end
        return
    end
    if not drag then return end
    if drag.kind=="marker" then
        if drag.moved and editor.preview then
            local p=editor.preview.position
            editor.preview=nil
            -- A whole drag is one completed action (R12, R17).
            place(drag.target,p)
        elseif editor.preview then editor.preview=nil;editor.touch() end
        return
    end
    editor.set_preview(nil)
    if drag.kind=="points" and not drag.moved then set_single(drag.grab);return end
    if not drag.moved then return end
    if drag.kind=="handle" then
        local o=find(drag.id)
        local differs=drag.params and (o.type=="curve" and anchor_key(drag.params)~=anchor_key(drag.p0) or o.type~="curve" and not same_params(drag.params,drag.p0))
        if differs then apply_params(drag.id,drag.params,drag.partner_anchors and {id=drag.partner.id,anchors=drag.partner_anchors}) end
    elseif drag.kind=="vertex" then
        local q=drag.to
        if q[1]==drag.origin[1] and q[2]==drag.origin[2] then return end
        editor.commit(function(e) edit.move_vertex(e,drag.id,drag.index,q) end,true)
    elseif drag.kind=="points" then
        -- The whole multi-point drag is one Undo step; the points stay selected.
        local d=drag.delta
        if d[1]~=0 or d[2]~=0 then editor.commit(function(e) local m,err=edit.move_points(e,drag.points,d);if not m then return nil,err end end,true) end
    else
        local d=drag.delta
        if d[1]~=0 or d[2]~=0 then editor.commit(function(e) edit.translate(e,drag.ids,d) end,true) end
    end
end
function on_input(self,action_id,action)
    if editor.mode~="edit" then
        -- An open report or import panel keeps its input; E does not leave it behind.
        local panel=html5 and html5.run("!!(window.riderFeedback?.visible||window.riderCustom?.visible)")=="true"
        if action_id==hash("editor_toggle") and action.pressed and not panel then
            editor.message=""
            msg.post(LOADER,"editor_enter")
            return true
        end
        return false
    end
    if self.focus_lost then self.focus_lost=false;cancel(self) end
    -- An open Import/Export panel keeps all input: canvas clicks and keys never edit behind it.
    if self.panel_open then
        if action_id==hash("ui_pointer") and action.pressed then editor.message="Close the Import/Export panel first." end
        return true
    end
    for _,m in ipairs({{"editor_ctrl","ctrl"},{"editor_shift","shift"},{"editor_space","space"},{"editor_alt","alt"}}) do
        if action_id==hash(m[1]) then
            -- Held keys report every frame, so a modifier cleared by cancel() comes back while still down.
            self.held[m[2]]=not action.released or nil
            return true
        end
    end
    -- The help overlay (LE6b) is modal: it takes every key and click; [H], [Esc], Close or a click
    -- outside the panel closes it. Nothing behind it is edited or driven.
    if self.help_open then
        if action_id==hash("ui_pointer") and action.pressed then
            if hit(self,action)=="help_close" or not gui.pick_node(self.help_nodes[1],action.x,action.y) then self.help_open=false end
        elseif (action_id==hash("help_toggle") or action_id==hash("editor_cancel")) and action.pressed then self.help_open=false end
        return true
    end
    -- A focused name field takes every key (contract controls); a click elsewhere confirms it.
    if self.field then
        local f=self.field
        if action_id==hash("editor_text") and action.text then
            local t=action.text:gsub("[%z\1-\31\127]","")
            if f.all and t~="" then f.text,f.all="",false end
            local limit=f.param and 16 or 64
            if #f.text+#t>limit then editor.message=f.param and "A value is limited to 16 characters." or f.label and "A label is limited to 64 bytes." or "A level name is limited to 64 bytes." else f.text=f.text..t end
        elseif action_id==hash("editor_delete") and (action.pressed or action.repeated) then
            f.text=f.all and "" or drop_char(f.text);f.all=false
        elseif action_id==hash("editor_play") and action.pressed then confirm_name(self)
        elseif action_id==hash("editor_cancel") and action.pressed then self.field=nil;editor.message=""
        elseif action_id==hash("ui_pointer") and action.pressed then confirm_name(self,true)
        elseif action_id==nil then cursor(self,action) end
        return true
    end
    if action_id==nil then canvas_move(self,action);return true end
    if action_id==hash("ui_pointer") then
        if action.pressed then
            -- The click that returns focus to the canvas never edits the level.
            if self.refocus then
                self.refocus=false
                if not self.refocus_until or socket.gettime()<self.refocus_until then return true end
            end
            local name=hit(self,action)
            if name=="warning_panel" or name=="dialog_panel" or name=="conflict_panel" then return true
            elseif name then on_button(self,name)
            elseif self.open_dialog then self.open_dialog=false
            else canvas_press(self,action) end
        elseif action.released then canvas_release(self) end
        canvas_move(self,action)
        return true
    end
    if action_id==hash("editor_pan") then
        if action.pressed and action.screen_x then self.pan={action.screen_x,action.screen_y} elseif action.released then self.pan=nil end
        return true
    end
    if (action_id==hash("editor_zoom_in") or action_id==hash("editor_zoom_out")) and action.pressed then
        local up=action_id==hash("editor_zoom_in")
        -- Over the Open dialog the wheel pages its list (templates on the right half, My levels on the left).
        if self.open_dialog and action.x and gui.pick_node(self.dialog_nodes[1],action.x,action.y) then
            local templates=(action.screen_x or 0)>=gui.get_screen_position(self.dialog_nodes[1]).x
            local key,count,per=templates and "tpl_page" or "page",templates and #self.templates or #(self.library or {}),templates and TEMPLATE_ROWS or ROWS
            self[key]=math.max(0,math.min(math.max(0,math.ceil(count/per)-1),(self[key] or 0)+(up and -1 or 1)))
            return true
        end
        cursor(self,action);zoom(self,up and 1.2 or 1/1.2);return true
    end
    if not action.pressed then return true end
    -- "Sure? Make smooth" (LE5d) belongs to the click right after it: any key disarms it.
    self.confirm_bulk=nil
    if editor.conflict then editor.message="Choose how to open this level first.";return true end
    if self.drag and action_id~=hash("editor_cancel") then return true end
    if action_id==hash("editor_toggle") then play(self)
    elseif action_id==hash("editor_play") then
        -- Enter first completes a piece being drawn; otherwise it is Play.
        if self.drawing then finish_drawing(self) else play(self) end
    elseif action_id==hash("editor_test") then test_start(self)
    elseif action_id==hash("editor_tool_select") then set_tool(self,"select")
    elseif action_id==hash("editor_tool_draw") then set_tool(self,"draw")
    elseif action_id==hash("editor_tool_prefab") then set_tool(self,"prefab")
    elseif action_id==hash("editor_grid") then editor.grid=not editor.grid;editor.touch()
    elseif action_id==hash("editor_label") then set_tool(self,"label")
    elseif action_id==hash("help_toggle") then open_help(self)
    elseif action_id==hash("editor_fit") then fit_level(self)
    elseif action_id==hash("editor_centre") then centre_selection(self)
    elseif action_id==hash("editor_cycle") then
        -- Tab cycles through overlapping candidates under the cursor.
        if self.candidates and #self.candidates>1 then self.hover_index=self.hover_index%#self.candidates+1;set_hover(self,self.candidates) end
    elseif action_id==hash("editor_connect") then connect(self)
    elseif action_id==hash("editor_split") then split(self)
    elseif action_id==hash("editor_delete") then
        if self.drawing then
            table.remove(self.drawing.points)
            if #self.drawing.points==0 then self.drawing=nil end
            editor.touch()
        else delete(self) end
    elseif action_id==hash("editor_z") and self.held.ctrl then
        if self.drawing and not self.held.shift then
            -- While drawing, Ctrl+Z removes the last placed point (like Backspace).
            table.remove(self.drawing.points)
            if #self.drawing.points==0 then self.drawing=nil end
            editor.touch()
        elseif editor.undo(not self.held.shift)==false then editor.message="Nothing to "..(self.held.shift and "redo" or "undo").."." end
    elseif action_id==hash("editor_y") and self.held.ctrl then
        if editor.undo(false)==false then editor.message="Nothing to redo." end
    elseif action_id==hash("editor_c") and self.held.ctrl then copy_selection()
    elseif action_id==hash("editor_c") then set_tool(self,"curve")
    elseif action_id==hash("editor_v") and self.held.ctrl then
        if self.drawing then finish_drawing(self) end
        paste_at(self,self.cursor or {editor.camera.x,editor.camera.y})
    elseif editor.tool=="prefab" and KIND_KEYS[action_id] then
        -- 1-7 pick the prefab type (the game's station keys are editor input while editing).
        editor.prefab_kind=KIND_KEYS[action_id];self.place=self.cursor and placement(self,self.cursor) or nil;editor.touch()
    elseif action_id==hash("editor_cancel") then
        -- Esc first cancels the current action (drag, unfinished piece), then clears the selection.
        if self.drag or self.pan or self.box then cancel(self)
        elseif self.drawing then self.drawing=nil;editor.touch()
        elseif self.open_dialog then self.open_dialog=false
        elseif self.warnings_open then self.warnings_open=false
        else editor.select(nil) end
    end
    return true
end
local function one_sided(e,run)
    for _,c in ipairs(doc_lib.run_chains(e,run)) do if not doc_lib.one_sided(c.points) then return false end end
    return true
end
local function seg_text(a,b)
    local length,angle=snap_lib.measure(a,b)
    return string.format("%.2f m  %.1f deg",length,angle)
end
local function describe(self)
    local e=editor.doc.editor
    local s=editor.selection
    local lines={}
    local ids=editor.selected_ids()
    local v=editor.vertex
    if s=="start" then
        local p=editor.preview and editor.preview.target=="start" and editor.preview.position or e.start.position
        lines={"START",string.format("x %.2f m  y %.2f m",p[1],p[2]),string.format("Start speed %.1f m/s",e.start.speed)}
        local blocked=doc_lib.blocked(e,p)
        if blocked then lines[#lines+1]="Overlaps "..blocked.type.." "..blocked.id end
    elseif s=="finish" and e.finish then
        local p=e.finish.position
        lines={"FINISH",string.format("x %.2f m  y %.2f m",p[1],p[2]),"Direction "..(e.finish.direction<0 and "<- (left)" or "-> (right)")}
    elseif editor.point_count()>=2 then
        -- Several points (LE5d): what the bulk buttons do with them.
        local r=corner_summary()
        lines={r.points.." points selected","Make smooth rounds "..r.sharp,"Make corner sharpens "..r.smooth}
        if r.ends>0 then lines[#lines+1]=plural(r.ends,"open end").." (skipped)" end
        if r.prefab>0 then lines[#lines+1]=plural(r.prefab,"joint").." to a prefab (skipped)" end
        lines[#lines+1]="Drag one: all move together;"
        lines[#lines+1]="click one: only that point."
        lines[#lines+1]="Shift+click adds or removes."
    elseif v and find(v.id) then
        local o=find(v.id)
        local pts=editor.shape(o)
        local p=end_point(pts,o,v.index)
        if o.type~="line" then lines={(v.index==1 and "Entry" or "Exit").." of "..doc_lib.label(o),string.format("x %.2f m  y %.2f m",p[1],p[2])}
        else
            lines={"Point "..v.index.." of "..#pts.." in line "..v.id,string.format("x %.2f m  y %.2f m",p[1],p[2])}
            if v.index>1 then lines[#lines+1]="Before: "..seg_text(pts[v.index-1],p) end
            if v.index<#pts then lines[#lines+1]="After: "..seg_text(p,pts[v.index+1]) end
        end
        local joint=edit.joint(e,v.id,v.index)
        if joint then lines[#lines+1]="Joint "..v.id.." -> "..joint..": dragging moves the downstream run"
        elseif o.type=="line" and v.index>1 and v.index<#pts then lines[#lines+1]="Delete joins its neighbours (orange)"
        else
            local v2=editor.vertex2
            local q=v2 and find(v2.id) and path(find(v2.id))[v2.index]
            local target=connect_target(v)
            if q and dist(q,p)>=0.01 then lines[#lines+1]=string.format("Connect [J] bridges to %s (%.2f m)",v2.id,dist(q,p))
            elseif q or target then lines[#lines+1]="Touches "..(q and v2.id or target.id).." end: Connect [J]"
            else lines[#lines+1]="Free end; Shift+click another free end to connect" end
            if o.type=="line" then lines[#lines+1]=#pts>2 and "Delete shortens the line" or "Delete: not possible (2 points)" end
        end
    elseif #ids>1 then
        local list=edit.closure(e,ids)
        lines={#ids.." objects selected","Dragging moves "..#list.." pieces","(each connected run once)"}
    elseif s and selected_object() then
        local o=selected_object()
        if o.type=="line" then
            local length=0
            for i=2,#o.points do length=length+dist(o.points[i-1],o.points[i]) end
            local run=edit.run_of(e,o.id)
            lines={"Line "..o.id,#o.points.." points, "..string.format("%.2f m",length),
                #run>1 and "Run of "..#run.." pieces: "..table.concat(run," > ",1,math.min(#run,4))..(#run>4 and " ..." or "") or "Not connected",
                one_sided(e,run) and "Solid below (one-sided)" or "Turns back: two-sided collision",
                "Drag moves the whole run","Double-click inserts a point"}
        elseif o.type=="hull" then
            local b=empty_box()
            for _,q in ipairs(o.vertices) do grow(b,q[1],q[2]) end
            lines={"Hull "..o.id,#o.vertices.." vertices",string.format("x %.2f m to %.2f m",b[1],b[2]),string.format("y %.2f m to %.2f m",b[3],b[4])}
        elseif o.type=="curve" then
            local pts=editor.shape(o)
            local l=0
            for i=2,#pts do l=l+dist(pts[i-1],pts[i]) end
            local run=edit.run_of(e,o.id)
            lines={"Curve "..o.id,string.format("%d anchors, %.2f m, %d samples",#o.anchors,l,#pts),#run>1 and "Run of "..#run.." pieces" or "Not connected"}
            -- The direction change at each joint (0 deg: a smooth join).
            local next,prev=doc_lib.links(e)
            local function kink(a,b)
                local la,lb=length(a),length(b)
                if la==0 or lb==0 then return 0 end
                return math.deg(math.acos(math.max(-1,math.min(1,(a[1]*b[1]+a[2]*b[2])/(la*lb)))))
            end
            if prev[o.id] then
                local u=editor.shape(find(prev[o.id]))
                lines[#lines+1]=string.format("Join from %s: kink %.1f deg",prev[o.id],kink({u[#u][1]-u[#u-1][1],u[#u][2]-u[#u-1][2]},{pts[2][1]-pts[1][1],pts[2][2]-pts[1][2]}))
            end
            if next[o.id] then
                local w=editor.shape(find(next[o.id]))
                local n=#pts
                lines[#lines+1]=string.format("Join to %s: kink %.1f deg",next[o.id],kink({pts[n][1]-pts[n-1][1],pts[n][2]-pts[n-1][2]},{w[2][1]-w[1][1],w[2][2]-w[1][2]}))
            end
            local a=editor.anchor and editor.anchor.id==o.id and o.anchors[editor.anchor.i]
            if a then lines[#lines+1]=string.format("Anchor %d (%s): x %.2f m  y %.2f m",editor.anchor.i,a.mode,a.p[1],a.p[2]) end
            lines[#lines+1]="Drag anchors and tangents (pink);"
            lines[#lines+1]="double-click adds an anchor."
        elseif o.type=="prefab" then
            local pts=editor.shape(o)
            lines={doc_lib.label(o).." (prefab)",string.format("At x %.2f m  y %.2f m",o.at[1],o.at[2])}
            if doc_lib.terrain(o) then
                local q=pts[#pts]
                lines[#lines+1]=string.format("Exit x %.2f m  y %.2f m",q[1],q[2])
                local run=edit.run_of(e,o.id)
                lines[#lines+1]=#run>1 and "Run of "..#run.." pieces" or "Not connected"
            end
            for _,t in ipairs(prefab.derived(o)) do lines[#lines+1]=t end
        else
            lines={"Label "..o.id,shorten(o.text,30),string.format("x %.2f m  y %.2f m",o.position[1],o.position[2]),
                "Click Text or double-click","to edit; drag moves it."}
        end
    elseif editor.tool=="prefab" then
        lines={"Prefab [P]: "..prefab.name(editor.prefab_kind),"Click places it (keys 1-7 or the","list pick the type). On a free end","(green ring) it connects: after an","exit, or ending at an entry.","Select it to change its values:","fields on the right or the handles.","Snap: 0.5 m grid [G], Alt 0.1 m."}
    elseif editor.tool=="label" then
        lines={"Label [L]","Click places a label and","edits its text (up to 64","bytes); Enter applies.","Select it to edit, move,","copy or delete it."}
    elseif editor.tool=="curve" then
        lines={"Curve [C]","Click to place anchors; tangents","follow them automatically. Click","the last anchor, double-click or","Enter to finish; Backspace undoes","an anchor. Select the curve to drag","anchors and tangents (pink).","Start or end on a free end to","connect (green ring)."}
    elseif editor.tool=="draw" then
        lines={"Draw [D]","Click to place points","Click the last point, double-click","or Enter to finish; Backspace undoes","a point; Esc discards the piece.","Start or end on a free end to","connect (green ring).","","Snap: 0.5 m grid [G], Alt 0.1 m,","Shift 15 deg, Ctrl off."}
    else
        lines={shorten(editor.doc.name,30),string.format("Test start speed %.1f m/s",editor.test_speed),"-/+: speed (Shift+click: 5 m/s)","F test start, Shift+F drop here",
            "Ctrl+Z / Ctrl+Y: undo / redo","Ctrl+C / Ctrl+V: copy / paste","Tab: next item under the cursor","Shift+click: add to selection","Drag on empty space: box select",
            string.format("Curves sampled: %s mm / %s m",doc_lib.SAMPLING.tolerance*1000,doc_lib.SAMPLING.max_segment)}
    end
    if editor.show_bounds and not s and editor.tool=="select" then
        -- The shown R13 bounds (LE6): what Play, Export and test starts use.
        local b=current_bounds(self)
        lines[#lines+1]=string.format("Bounds x %.1f to %.1f m",b[1],b[2])
        lines[#lines+1]=string.format("       y %.1f to %.1f m",b[3],b[4])
    end
    if object_corner_mode() then
        -- Whole objects (LE5d): what Make smooth / Make corner would change, and the box rule.
        local r=corner_summary()
        lines[#lines+1]="Make smooth: "..plural(r.sharp,"point")..(r.convert>0 and ", "..r.convert.." conv." or "")
        lines[#lines+1]="Make corner: "..plural(r.smooth,"point")
        if has_paths() then
            lines[#lines+1]="Drag on empty space: points;"
            lines[#lines+1]="Esc first to box-select objects."
        end
    end
    return table.concat(lines,"\n")
end
local function readout(self)
    local d,drag=self.drawing,self.drag
    if d and self.snapped and drawing_tool() then
        local last=d.points[#d.points]
        local note=self.snapped.kind=="anchor" and self.snapped.anchor.end_free and "  connects to "..self.snapped.anchor.id or ""
        return seg_text(last,self.snapped.p)..note
    end
    if drawing_tool() and self.snapped and self.snapped.kind=="anchor" and self.snapped.anchor.end_free then return "starts at "..self.snapped.anchor.id.." end (connects)" end
    if drag and drag.kind=="vertex" and drag.to then
        local o=find(drag.id)
        local pts=editor.shape(o)
        local t={}
        if drag.index>1 then t[#t+1]=seg_text(pts[drag.index-1],pts[drag.index]) end
        if drag.index<#pts then t[#t+1]=seg_text(pts[drag.index],pts[drag.index+1]) end
        return table.concat(t," | ")
    end
    -- START / FINISH drag (LE6b): position, and for START the clearance check Play uses.
    if drag and drag.kind=="marker" and drag.moved and editor.preview then
        local q=editor.preview.position
        local text=string.format("%s x %.2f m  y %.2f m",drag.target=="start" and "START" or "FINISH",q[1],q[2])
        local blocked=drag.target=="start" and doc_lib.blocked(editor.doc.editor,q)
        return blocked and text.." | overlaps "..doc_lib.label(blocked):lower().." (Play blocked)" or text
    end
    if drag and drag.kind=="move" and drag.moved then return string.format("dx %.2f m  dy %.2f m",drag.delta[1],drag.delta[2]) end
    if drag and drag.kind=="points" and drag.moved then return string.format("dx %.2f m  dy %.2f m | %d points",drag.delta[1],drag.delta[2],#drag.points) end
    if self.box then return self.box.points and "Box: points of the selected lines and curves (none inside: objects)" or "Box: objects" end
    if drag and drag.kind=="handle" and drag.params and find(drag.id).type=="curve" then
        local kind,i=drag.handle:sub(1,1),tonumber(drag.handle:sub(2))
        local a=drag.params[i]
        local text
        if kind=="a" then text=string.format("anchor %d: x %.2f m  y %.2f m",i,a.p[1],a.p[2])
        else
            local t=a[kind=="i" and "in" or "out"]
            text=string.format("tangent %.2f m  %.1f deg (%s)",length(t),math.deg(math.atan2(t[2],t[1])),a.mode)
        end
        text=text..(drag.downstream and drag.downstream>0 and " | moves "..drag.downstream.." downstream" or "")
        return drag.conflict and text.." | conflict: "..drag.conflict or text
    end
    if drag and drag.kind=="handle" and drag.params then
        local o=find(drag.id)
        local t={}
        for _,f in ipairs(prefab.fields(o.kind,drag.params,true)) do
            if not f.choices and drag.params[f.key]~=drag.p0[f.key] then t[#t+1]=f.label:lower().." "..prefab.value(f,drag.params) end
        end
        local text=table.concat(t,", ")..(drag.downstream and drag.downstream>0 and " | moves "..drag.downstream.." downstream" or "")
        return drag.conflict and text.." | conflict: "..drag.conflict or text
    end
    if editor.tool=="prefab" and self.place then
        local pl=self.place
        return prefab.name(pl.kind)..string.format(" at x %.2f m  y %.2f m",pl.at[1],pl.at[2])..(pl.target and "  connects to "..pl.target or "")
    end
    local g=self.ghost_now
    if g then
        local key=g.mode=="drop" and "Shift+F" or "F"
        return g.pos and string.format("%s: test start here (x %.2f m  y %.2f m)",key,g.pos[1],g.pos[2]) or key..": refused ("..g.err..")"
    end
    if editor.tool=="select" and editor.hover then
        local n=self.candidates and #self.candidates or 0
        return describe_candidate(editor.hover)..(n>1 and string.format("  (%d/%d, Tab)",self.hover_index,n) or "")
    end
    return ""
end
-- The test start preview (LE6b): where F (Shift+F: drop here) would start, by the same rules as F
-- (editor_doc.test_start), or why it would be refused. Shown with the Select tool over empty canvas inside
-- the free area, never while dragging, with a field, dialog, list or help open, or when switched off.
local function ghost_state(self)
    if not editor.show_ghost or editor.tool~="select" or not self.cursor or not self.cursor_px then return nil end
    if self.drag or self.box or self.pan or self.pending or self.field or self.help_open or self.open_dialog or self.warnings_open or editor.conflict or self.panel_open then return nil end
    if self.candidates and #self.candidates>0 then return nil end
    local u,q=usable(self),self.cursor_px
    if q[1]<u.x0 or q[1]>u.x1 or q[2]<u.y0 or q[2]>u.y1 then return nil end
    local mode=self.held.shift and "drop" or "surface"
    local key=string.format("%s:%d:%s:%.17g:%.17g",tostring(editor.doc),editor.doc.editor.revision,mode,self.cursor[1],self.cursor[2])
    if self.ghost_key~=key then
        local pos,err=doc_lib.test_start(editor.doc,self.cursor,mode)
        self.ghost_key,self.ghost_cache=key,{pos=pos,err=err,mode=mode}
    end
    return self.ghost_cache
end
-- Overlays for this frame: grid, handles (hover and selection first, then selected lines' points,
-- then every line end in view), connect preview, draw and selection previews, snap and readout.
local function draw_overlay(self)
    local o=self.overlay
    overlay.begin(o)
    ui=o.s
    local s=map()
    local w,h=window.get_size()
    if not s then overlay.finish(o);show_silhouette(o,self.ghost,nil);show_silhouette(o,self.last_ghost,nil);return end
    local e=editor.doc.editor
    overlay.grid(o,s,w,h,self.held.alt and snap_lib.FINE or snap_lib.GRID)
    local function visible(q) return q[1]>=-20 and q[1]<=w+20 and q[2]>=-20 and q[2]<=h+20 end
    local function handle(p,color,size,diamond) local q=to_px(p,s);if visible(q) then overlay.handle(o,q,color,size or HANDLE_PX,diamond) end end
    local hover=editor.hover
    local hovered=editor.tool=="select" and hover and hover.kind=="vertex" and not self.drag and find(hover.id)
    local hover_point=hovered and editor.shape(hovered)[hover.index]
    if hover_point then handle(hover_point,C.hover,HANDLE_PX+5) end
    local v=editor.vertex
    if v and find(v.id) then
        local pts=editor.shape(find(v.id))
        handle(end_point(pts,find(v.id),v.index),C.selected,HANDLE_PX+3)
        local vs=vertex_state()
        -- Delete preview: an inner point's neighbours are joined.
        if vs and vs.inner and not self.drag then overlay.line(o,to_px(pts[v.index-1],s),to_px(pts[v.index+1],s),C.join,2) end
        local v2=editor.vertex2 and find(editor.vertex2.id)
        if v2 and not self.drag then
            -- Second end for Connect: a bridge preview, or a ring when the ends touch.
            local vp=end_point(pts,find(v.id),v.index)
            local q=end_point(editor.shape(v2),v2,editor.vertex2.index) or vp
            handle(q,C.selected,HANDLE_PX+3)
            if dist(q,vp)>=0.01 then overlay.line(o,to_px(vp,s),to_px(q,s),C.connect,3) else handle(q,C.connect,HANDLE_PX+12) end
        else
            local target=not self.drag and connect_target(v)
            if target then handle(target.p,C.connect,HANDLE_PX+12) end
        end
    end
    if drawing_tool() and self.snapped and self.snapped.kind=="anchor" and self.snapped.anchor.end_free then handle(self.snapped.p,C.connect,HANDLE_PX+12) end
    local next,prev=doc_lib.links(e)
    -- A selected prefab's or curve's handles, the hovered one larger. Curve tangents are drawn as lines to
    -- diamond handles; at a joint the neighbour's direction (green) and the curve's (pink) show the kink.
    local hovered_handle=editor.tool=="select" and hover and hover.kind=="handle" and not self.drag and hover.key
    for _,obj in ipairs(e.objects) do
        if (obj.type=="prefab" or obj.type=="curve") and editor.selected[obj.id] then
            local shown=editor.preview_objects and editor.preview_objects[obj.id] or obj
            for _,h in ipairs(object_handles(shown)) do
                if h.tangent then overlay.line(o,to_px(shown.anchors[h.anchor].p,s),to_px(h.p,s),C.param,1) end
                local picked=editor.anchor and editor.anchor.id==obj.id and editor.anchor.i==h.anchor and not h.tangent
                handle(h.p,picked and C.selected or C.param,HANDLE_PX+(hovered_handle=="h:"..obj.id..":"..h.name and 6 or 1),h.tangent)
            end
            if obj.type=="curve" then
                local pts=editor.shape(shown)
                local function ray(p,d,color)
                    local l=length(d)
                    if l==0 then return end
                    local k=40*ui/math.abs(s.ppm_x)/l
                    overlay.line(o,to_px(p,s),to_px({p[1]+d[1]*k,p[2]+d[2]*k},s),color,2)
                end
                if prev[obj.id] then
                    local u=editor.shape(find(prev[obj.id]))
                    ray(pts[1],{u[#u][1]-u[#u-1][1],u[#u][2]-u[#u-1][2]},C.joint);ray(pts[1],{pts[2][1]-pts[1][1],pts[2][2]-pts[1][2]},C.param)
                end
                if next[obj.id] then
                    local w=editor.shape(find(next[obj.id]))
                    local n=#pts
                    ray(pts[n],{w[2][1]-w[1][1],w[2][2]-w[1][2]},C.joint);ray(pts[n],{pts[n][1]-pts[n-1][1],pts[n][2]-pts[n-1][2]},C.param)
                end
            end
        end
    end
    for _,obj in ipairs(e.objects) do
        if obj.type=="line" and editor.selected[obj.id] then
            for _,q in ipairs(editor.shape(obj)) do handle(q,C.vertex,HANDLE_PX-2) end
        end
    end
    for _,obj in ipairs(e.objects) do
        if doc_lib.terrain(obj) then
            local pts=editor.shape(obj)
            handle(pts[1],prev[obj.id] and C.joint or C.free,HANDLE_PX-1,true)
            if not next[obj.id] then handle(pts[#pts],C.free,HANDLE_PX-1,true) end
        end
    end
    -- The multi-point selection (LE5d): filled orange squares over the handles.
    for _,pt in ipairs(editor.point_list()) do
        local q=point_pos(pt)
        if q then handle(q,C.selected,HANDLE_PX+3) end
    end
    -- Prefab placement preview (R5): the shape a click places, and a ring on the end it connects to.
    local pl=editor.tool=="prefab" and self.place
    if pl and not self.drag then
        local ghost={type="prefab",kind=pl.kind,at=pl.at,params=pl.params}
        local closed=doc_lib.outline(ghost)
        for _,pts in ipairs(closed and {closed} or doc_lib.parts(ghost)) do
            for i=2,#pts+(closed and 1 or 0) do overlay.line(o,to_px(pts[i-1],s),to_px(pts[(i-1)%#pts+1],s),C.draw,3) end
        end
        if pl.target then handle(pl.p,C.connect,HANDLE_PX+12) end
    end
    local d=self.drawing
    if d and d.kind=="curve" then
        -- The curve as it would be placed (automatic tangents), 8 lines per segment, up to the pool size.
        local pts={unpack(d.points)}
        if self.snapped and dist(self.snapped.p,pts[#pts])>=0.01 then pts[#pts+1]=self.snapped.p end
        local anchors=edit.auto_anchors(pts)
        local steps=math.max(1,math.min(8,math.floor(56/math.max(1,#anchors-1))))
        for i=1,#anchors-1 do
            local a,b=anchors[i],anchors[i+1]
            local p0,p3=a.p,b.p
            local p1,p2={p0[1]+a.out[1],p0[2]+a.out[2]},{p3[1]+b["in"][1],p3[2]+b["in"][2]}
            local last=p0
            for k=1,steps do
                local t=k/steps;local u=1-t
                local q={u*u*u*p0[1]+3*u*u*t*p1[1]+3*u*t*t*p2[1]+t*t*t*p3[1],u*u*u*p0[2]+3*u*u*t*p1[2]+3*u*t*t*p2[2]+t*t*t*p3[2]}
                overlay.line(o,to_px(last,s),to_px(q,s),i<#d.points and C.draw or C.rubber,i<#d.points and 3 or 2);last=q
            end
        end
        for _,q in ipairs(d.points) do handle(q,C.draw,HANDLE_PX-2) end
    elseif d then
        for i=2,#d.points do overlay.line(o,to_px(d.points[i-1],s),to_px(d.points[i],s),C.draw,3) end
        for _,q in ipairs(d.points) do handle(q,C.draw,HANDLE_PX-2) end
        if self.snapped then overlay.line(o,to_px(d.points[#d.points],s),to_px(self.snapped.p,s),C.rubber,2) end
    end
    local b=self.box
    if b then
        local p0,p1=to_px(b.from,s),to_px(b.to,s)
        overlay.line(o,{p0[1],p0[2]},{p1[1],p0[2]},C.box,1);overlay.line(o,{p1[1],p0[2]},{p1[1],p1[2]},C.box,1)
        overlay.line(o,{p1[1],p1[2]},{p0[1],p1[2]},C.box,1);overlay.line(o,{p0[1],p1[2]},{p0[1],p0[2]},C.box,1)
    end
    -- R13 bounds (LE6, view only): the same calculation as Play, Export and test starts, per revision.
    if editor.show_bounds then
        local bb=current_bounds(self)
        overlay.rect(o,to_px({bb[1],bb[3]},s),to_px({bb[2],bb[4]},s),w,h,C.bounds,2)
    end
    -- The last launched test start of this document (LE6) as a faint vehicle, the test start preview
    -- (ghost, LE6b), and the spot a problem row jumped to.
    show_silhouette(o,self.last_ghost,editor.last_test_start(),s,C.last)
    local g=ghost_state(self)
    self.ghost_now=g
    show_silhouette(o,self.ghost,g and (g.pos or self.cursor),s,g and (g.pos and C.ghost or C.ghost_bad))
    local f=self.flash
    if f and socket.gettime()<f.until_t then
        local phase=(f.until_t-socket.gettime())%0.5/0.5
        handle(f.p,C.off,HANDLE_PX+10+12*phase,true)
    elseif f then self.flash=nil end
    local snapping=self.snapped and (drawing_tool() or editor.tool=="prefab" or (self.drag and self.drag.kind~="marker" and (self.drag.kind~="handle" or self.drag.skip)))
    overlay.snap(o,snapping and to_px(self.snapped.p,s) or nil,snapping and (C[self.snapped.kind] or C.free_snap) or nil)
    local text=readout(self)
    overlay.readout(o,self.cursor_px,text)
    self.readout_text=text
    overlay.finish(o)
end
-- Right panel (LE5a): the description, then the rows it shows, top to bottom; the panel grows to fit
-- them (never smaller than in LE4). LINE: one description line of the builtin 14 px font at scale 0.42,
-- with a margin (a line count, so no text metrics API is needed).
local ROW,LINE=26,7.5
local function layout(self,shown)
    local y=468-self.description_lines*LINE-6-ROW/2
    local rows={{"minus","plus"},{"direction","delete","rename"},{"split"},{"connect","disconnect"},{"smooth"},{"smooth_all"},{"corner_all"},{"convert"}}
    for i=1,PARAMS do rows[#rows+1]={"param_"..i} end
    rows[#rows+1]={"mirror_left","mirror_right"}
    rows[#rows+1]={"paste"}
    local function put(name,x)
        local b=self.buttons[name]
        local p=vmath.vector3(x,y,0)
        gui.set_position(b.box,p);gui.set_position(b.label,p)
    end
    local mirror=false
    for _,row in ipairs(rows) do
        local any=false
        for _,name in ipairs(row) do any=any or shown[name] end
        if any then
            if row[1]=="minus" then put("minus",800);put("plus",848)
            elseif row[1]=="mirror_left" then
                put("mirror_left",868);put("mirror_right",926)
                gui.set_position(self.mirror_label,vmath.vector3(772,y,0));mirror=true
            else for _,name in ipairs(row) do if shown[name] then put(name,860) end end end
            y=y-ROW
        end
    end
    gui.set_enabled(self.mirror_label,mirror)
    local bottom=math.min(183,y+ROW/2-4)
    gui.set_position(self.panel,vmath.vector3(860,(475+bottom)/2,0));gui.set_size(self.panel,vmath.vector3(196,475-bottom,0))
end
local function screen(n) local p=gui.get_screen_position(n);return {x=p.x,y=p.y} end
-- Test state (debug only): the selected prefab's handles and its panel rows as shown.
local function published_handles()
    local o=editor.selection and editor.doc and find(editor.selection)
    if not (o and (o.type=="prefab" or o.type=="curve")) then return {} end
    local list={}
    for _,h in ipairs(object_handles(o)) do list[#list+1]={name=h.name,p=h.p,index=h.index or false} end
    return list
end
local function published_rows(self)
    local o=editor.selection and editor.doc and find(editor.selection)
    if not (o and (o.type=="prefab" or o.type=="curve" or o.type=="label") and #editor.selected_ids()==1) then return {} end
    local list={}
    for i=1,#param_rows(o) do list[i]=gui.get_text(self.buttons["param_"..i].label) end
    return list
end
-- Test state (debug only): the View row's button rectangles in canvas pixels (LE6 overlap check).
local function view_rects(self)
    local list={}
    for _,v in ipairs(VIEW) do
        local p,k=gui.get_screen_position(self.buttons[v[1]].box),self.overlay.k
        list[#list+1]={name=v[1],x0=p.x-v[3]/2*k,x1=p.x+v[3]/2*k,y0=p.y-10*k,y1=p.y+10*k}
    end
    return list
end
-- Test state (debug only): every listed problem with its target (LE6).
local function published_problems(self)
    local list={}
    for _,r in ipairs(self.problem_rows or {}) do
        local t=r.target
        list[#list+1]={text=r.text,error=r.error or false,ids=t and t.ids or {},at=t and t.at or false,start=t and t.start or false,located=t~=nil}
    end
    return list
end
local function publish(self)
    local e=editor.doc and editor.doc.editor
    local buttons={}
    for name,b in pairs(self.buttons) do buttons[name]=screen(b.box) end
    local o=self.overlay
    html5.run("window.riderEditor="..json.encode({mode=editor.mode,tool=editor.tool,selection=editor.selection or "",status=editor.status,
        message=editor.message,problem=editor.problem or "",dirty=editor.dirty or false,test_speed=editor.test_speed,camera=editor.camera,screen=editor.map(),
        id=editor.doc and editor.doc.id or "",name=editor.doc and editor.doc.name or "",revision=e and e.revision or -1,next_id=e and e.next_id or 0,
        start=e and e.start,finish=e and e.finish or false,objects=e and #e.objects or 0,undo=editor.history and #editor.history.undo or 0,
        redo=editor.history and #editor.history.redo or 0,view=editor.view_counts,cursor=self.cursor or false,buttons=buttons,open_dialog=self.open_dialog or false,
        selected=editor.doc and editor.selected_ids() or {},vertex=editor.vertex or false,hover=editor.hover and editor.hover.key or "",hover_count=self.candidates and #self.candidates or 0,
        drawing=self.drawing and #self.drawing.points or 0,snap=self.snapped and {kind=self.snapped.kind,p=self.snapped.p} or false,grid=editor.grid,
        readout=self.readout_text or "",errors=editor.errors,warnings=editor.warnings,display_note=editor.display_note or "",vertex2=editor.vertex2 or false,warnings_open=self.warnings_open or false,chains=editor.chains or 0,
        overlay={nodes=self.gui_nodes,max_nodes=MAX_NODES,grid=o.used.grid,handles=o.used.handles,lines=o.used.lines,bounds=o.used.bounds,dropped=o.dropped,spacing=o.spacing or 0},
        visible=visible_buttons(self),key=editor.key() or 0,stored=editor.store[editor.opened] or false,library=editor.library().list(),page=self.page or 0,
        conflict=editor.conflict and editor.conflict.summary or false,field=self.field and self.field.text or false,field_all=self.field and self.field.all or false,unsynced=editor.unsynced or false,
        clipboard=editor.clipboard and {objects=#editor.clipboard.objects,connections=#editor.clipboard.connections} or false,
        prefab_kind=editor.prefab_kind,place=self.place and {at=self.place.at,target=self.place.target or false,kind=self.place.kind} or false,
        handles=published_handles(),field_param=self.field and self.field.param or false,
        points=editor.doc and editor.point_list() or {},confirm_bulk=self.confirm_bulk and true or false,anchor=editor.anchor or false,
        rows=published_rows(self),problems=published_problems(self),warn_page=self.warn_page or 0,tpl_page=self.tpl_page or 0,
        show_bounds=editor.show_bounds,bounds=e and doc_lib.bounds(e) or false,extent=e and doc_lib.extent(e) or false,
        last_test=editor.doc and editor.last_test_start() or false,view_rects=view_rects(self),usable=self.overlay.k and usable(self) or false,flash=self.flash and self.flash.p or false,
        ghost=self.ghost_now and {pos=self.ghost_now.pos or false,err=self.ghost_now.err or false,mode=self.ghost_now.mode} or false,show_ghost=editor.show_ghost,
        help_open=self.help_open or false,help=self.help_open and {left=HELP_LEFT,right=HELP_RIGHT} or false,field_label=self.field and self.field.label or false,
        labels_drawn=editor.drawn_labels or {}},{encode_empty_table_as_object=false}))
    -- The document itself only when it changed (it can hold thousands of points).
    local key=e and editor.doc.id..":"..e.revision
    if key and key~=self.published then
        self.published=key
        html5.run("window.riderEditorDoc="..json.encode(e,{encode_empty_table_as_object=false}))
        -- Derived geometry (prefab paths), so tests can check what the document compiles from.
        local paths={}
        for _,o in ipairs(e.objects) do paths[o.id]=path(o) end
        html5.run("window.riderEditorPaths="..json.encode(paths))
    end
end
function update(self,dt)
    if not self.focused then
        -- After every init has run: the loader acquired focus too, and this GO must sit above it.
        self.focused=true
        msg.post(".","acquire_input_focus")
    end
    local edit_mode=editor.mode=="edit" and editor.doc~=nil
    self.panel_open=edit_mode and html5 and html5.run("String(!!window.riderCustom?.visible)")=="true"
    for _,n in ipairs(self.edit_nodes) do gui.set_enabled(n,edit_mode) end
    gui.set_enabled(self.hint,not edit_mode);gui.set_enabled(self.play_message,not edit_mode)
    gui.set_text(self.play_message,not edit_mode and editor.message or "")
    if self.focus_lost and edit_mode then self.focus_lost=false;cancel(self) end
    editor.sync()
    if edit_mode then
        if editor.dirty and socket.gettime()-(editor.dirty_at or 0)>=0.4 then editor.save_draft() end
        local e=editor.doc.editor
        -- Save status (R12): Unsaved / Saving... / Saved / Save failed; a copy that was never edited is not in My levels.
        local status=editor.dirty and "Unsaved" or editor.status~="" and editor.status or "Not saved yet"
        if not editor.key() and not editor.store[editor.opened] then status=status.." (copy)" end
        if self.field and not self.field.param and not self.field.label then
            gui.set_text(self.title,self.field.all and "Name: ["..self.field.text.."]  (type to replace)" or "Name: "..self.field.text.."_")
            gui.set_color(self.title,C.hover)
        else
            gui.set_text(self.title,string.format("%s | %s",shorten(editor.doc.name,24),shorten(status,36)))
            gui.set_color(self.title,vmath.vector4(1,1,1,1))
        end
        -- A label's text field shows on the canvas while typing (the edit world draws it); Enter commits it.
        local f=self.field
        editor.label_preview=f and f.label and not f.param and {id=f.label,text=f.text} or nil
        local description=describe(self)
        gui.set_text(self.properties,description)
        self.description_lines=select(2,description:gsub("\n",""))+1
        gui.set_text(self.message,editor.message or "")
        local p=self.cursor
        local snapped=self.snapped and self.snapped.kind~="free" and (drawing_tool() or self.drag) and " -> "..self.snapped.kind or ""
        gui.set_text(self.status,string.format("x %s m  y %s m | zoom %.2f | %s | %s%s | %d objects | %s",p and string.format("%.2f",p[1]) or "-",p and string.format("%.2f",p[2]) or "-",
            editor.camera.zoom,editor.tool,snap_mode(self),snapped,#e.objects,editor.problem and "Play blocked" or "Ready to play")
            ..((self.overlay.dropped or 0)>0 and " | zoom in to see every point" or ""))
        -- The edit world's display note (large drafts, R7) is listed as a warning.
        local notes={unpack(editor.warnings)}
        if editor.display_note then table.insert(notes,1,editor.display_note) end
        local errors,warnings=#editor.errors,#notes
        local function plural(n,word) return n.." "..word..(n==1 and "" or "s") end
        gui.set_text(self.buttons.warnings.label,errors>0 and plural(errors,"error")..", "..warnings.." w." or plural(warnings,"warning"))
        gui.set_color(self.buttons.warnings.box,errors>0 and vmath.vector4(0.5,0.15,0.12,1) or warnings>0 and vmath.vector4(0.45,0.36,0.1,1) or BUTTON)
        -- The list (LE6): one clickable row per message, WARN_ROWS per page; a row with a source shows it.
        local rows=problem_rows()
        self.problem_rows=rows
        self.warn_page=math.max(0,math.min(self.warn_page or 0,math.ceil(#rows/WARN_ROWS)-1))
        local wp=self.warn_page
        local shown_rows=math.max(0,math.min(WARN_ROWS,#rows-wp*WARN_ROWS))
        gui.set_text(self.warning_text,#rows==0 and "No errors or warnings." or
            string.format("%s, %s%s: click a row to show it",plural(errors,"error"),plural(warnings,"warning"),#rows>WARN_ROWS and string.format(" (%d-%d)",wp*WARN_ROWS+1,wp*WARN_ROWS+shown_rows) or ""))
        for i=1,WARN_ROWS do
            local r=rows[wp*WARN_ROWS+i]
            if r then
                local located=r.target~=nil
                gui.set_text(self.buttons["warn_"..i].label,(r.error and "Error: " or "Warning: ")..shorten(r.text,135)..(located and "  -> show" or ""))
            end
        end
        local top,bottom=478,458-shown_rows*22
        gui.set_position(self.warning_panel,vmath.vector3(430,(top+bottom)/2,0));gui.set_size(self.warning_panel,vmath.vector3(640,top-bottom,0))
        gui.set_enabled(self.warning_panel,self.warnings_open or false);gui.set_enabled(self.warning_text,self.warnings_open or false)
        for _,n in ipairs(self.dialog_nodes) do gui.set_enabled(n,self.open_dialog or false) end
        for _,n in ipairs(self.conflict_nodes) do gui.set_enabled(n,editor.conflict~=nil) end
        for _,n in ipairs(self.help_nodes) do gui.set_enabled(n,self.help_open or false) end
        -- Text nodes draw above later boxes, so the panel texts behind the help overlay are hidden while it is open.
        for _,n in ipairs({self.properties,self.status,self.message}) do gui.set_enabled(n,not self.help_open) end
        if editor.conflict then
            gui.set_text(self.conflict_text,"The compiled geometry in this level differs from its editor source:\n"..editor.conflict.summary..
                "\nRecompile from source, or keep the compiled geometry as editable lines (connections are not kept).")
        end
        -- Another document became current (an import, Undo/Redo across documents): dialogs and the name
        -- field belonged to the previous one. The open list follows saves and deletes while it is shown.
        if self.last_opened~=editor.opened then
            self.last_opened=editor.opened
            self.open_dialog,self.field,self.confirm_delete=false,nil,nil
        end
        if self.open_dialog then refresh_library(self) end
        if self.open_dialog then
            local list=self.library or {}
            gui.set_text(self.library_title,self.library_error and "My levels: "..self.library_error or
                #list==0 and "My levels (none yet: edit a level to save it)" or
                string.format("My levels (%d-%d of %d, newest first)",self.page*ROWS+1,math.min(#list,(self.page+1)*ROWS),#list))
            for i=1,ROWS do
                local l=list[self.page*ROWS+i]
                if l then
                    local current=l.key==editor.key()
                    gui.set_text(self.buttons["lib_"..i].label,(current and "* " or "")..shorten(l.name,22).."  "..os.date("%Y-%m-%d %H:%M",l.time)..(current and " (open)" or ""))
                    local confirm=self.confirm_delete==l.key
                    gui.set_text(self.buttons["libdel_"..i].label,confirm and "Sure?" or "Delete")
                end
            end
        end
        local shown={}
        for _,name in ipairs(visible_buttons(self)) do shown[name]=true end
        for name,b in pairs(self.buttons) do
            gui.set_enabled(b.box,shown[name] or false);gui.set_enabled(b.label,shown[name] or false)
            if name:match("^libdel_") then
                local l=self.library and self.library[(self.page or 0)*ROWS+tonumber(name:sub(8))]
                gui.set_color(b.box,l and self.confirm_delete==l.key and DANGER or BUTTON)
            elseif name~="warnings" then gui.set_color(b.box,(name=="tool_"..editor.tool or name=="kind_"..editor.prefab_kind) and ACTIVE or BUTTON) end
        end
        -- "Sure? Convert" belongs to one prefab and one document state: any edit, Undo or other selection drops it.
        if self.confirm_convert and (self.confirm_convert~=editor.selection or self.confirm_revision~=e.revision) then self.confirm_convert=nil end
        if self.confirm_bulk and (self.confirm_bulk.key~=table.concat(editor.selected_ids(),",") or self.confirm_bulk.revision~=e.revision or editor.point_count()>=2) then self.confirm_bulk=nil end
        gui.set_text(self.buttons.smooth_all.label,self.confirm_bulk and "Sure? Make smooth" or "Make smooth")
        gui.set_color(self.buttons.smooth_all.box,self.confirm_bulk and DANGER or BUTTON)
        local st=smooth_state()
        gui.set_text(self.buttons.smooth.label,st and not st.corner and "Make corner" or "Make smooth")
        gui.set_text(self.buttons.convert.label,self.confirm_convert and self.confirm_convert==editor.selection and "Sure? Convert" or "Convert to editable path")
        gui.set_color(self.buttons.convert.box,self.confirm_convert and self.confirm_convert==editor.selection and DANGER or BUTTON)
        -- A selected prefab's fields: label and value, the focused one as an edit field.
        local sel=editor.selection and find(editor.selection)
        if sel and sel.type=="curve" and editor.anchor and editor.anchor.id==sel.id and sel.anchors[editor.anchor.i] then
            gui.set_text(self.buttons.param_1.label,"Anchor "..editor.anchor.i.." tangents: "..sel.anchors[editor.anchor.i].mode.."  (click)")
            gui.set_color(self.buttons.param_1.box,BUTTON)
        elseif sel and sel.type=="label" then
            -- A label's text (LE6b), the focused one as an edit field.
            local f=self.field
            local focused=f and f.label==sel.id
            gui.set_text(self.buttons.param_1.label,focused and (f.all and "Text: ["..f.text.."]" or "Text: "..f.text.."_") or "Text: "..shorten(sel.text,26).."  (click)")
            gui.set_color(self.buttons.param_1.box,focused and ACTIVE or BUTTON)
        elseif sel and sel.type=="prefab" then
            local f=self.field
            for i,fd in ipairs(param_rows(sel)) do
                local b=self.buttons["param_"..i]
                local focused=f and f.param==fd.key and f.id==sel.id
                gui.set_text(b.label,focused and (f.all and fd.label..": ["..f.text.."] "..fd.unit or fd.label..": "..f.text.."_ "..fd.unit)
                    or fd.label..": "..prefab.value(fd,sel.params)..(fd.choices and "  (click)" or ""))
                gui.set_color(b.box,focused and ACTIVE or BUTTON)
            end
        end
        -- Warning rows by severity; view buttons dimmed while they have nothing to do (LE6).
        for i=1,WARN_ROWS do
            local r=rows[wp*WARN_ROWS+i]
            gui.set_color(self.buttons["warn_"..i].box,r and r.error and vmath.vector4(0.35,0.12,0.1,1) or vmath.vector4(0.3,0.25,0.08,1))
        end
        local idle={view_centre=not has_selection(),view_test=editor.last_test_start()==nil}
        for _,v in ipairs(VIEW) do
            local b=self.buttons[v[1]]
            local on=(v[1]=="view_bounds" and editor.show_bounds) or (v[1]=="view_ghost" and editor.show_ghost) or (v[1]=="view_help" and self.help_open)
            gui.set_color(b.box,on and ACTIVE or idle[v[1]] and DIM or BUTTON)
            gui.set_color(b.label,vmath.vector4(1,1,1,idle[v[1]] and 0.45 or 1))
        end
        self.tpl_page=math.max(0,math.min(self.tpl_page or 0,math.ceil(#self.templates/TEMPLATE_ROWS)-1))
        layout(self,shown)
        -- After any document change (edit, Undo/Redo, another document) hover is picked again at the cursor.
        local key=tostring(editor.doc)..":"..e.revision..":"..editor.tool
        if key~=self.seen then
            self.seen=key
            -- A piece being drawn belongs to the document it was started in (LE3b): opening another
            -- document (template, E on another level) discards it with its gesture state.
            if self.drawing and self.drawing.opened~=editor.opened then
                self.drawing=nil;cancel(self);self.snapped=nil
                editor.message="Unfinished piece discarded: another document is now current."
            end
            if editor.tool=="select" and self.cursor then set_hover(self,candidates(self.cursor))
            else self.candidates,editor.hover=nil,nil;if editor.hover_object then editor.hover_object=nil;editor.touch() end end
            self.place=editor.tool=="prefab" and self.cursor and placement(self,self.cursor) or nil
        end
        draw_overlay(self)
        self.overlay_shown=true
    elseif self.overlay_shown then
        self.overlay_shown=false
        overlay.hide(self.overlay)
        show_silhouette(self.overlay,self.ghost,nil);show_silhouette(self.overlay,self.last_ghost,nil)
    end
    -- Test state (debug only): every frame while editing; while driving only on a mode, message or save
    -- change or every 0.25 s, so the published state costs the driven world little.
    if self.debug then
        local now=socket.gettime()
        local key=editor.mode..":"..tostring(editor.message)..":"..tostring(editor.status)..":"..tostring(editor.dirty)
        if editor.mode=="edit" or key~=self.publish_key or now-(self.publish_at or 0)>=0.25 then
            self.publish_key,self.publish_at=key,now
            publish(self)
        end
    end
end
function on_message(self,id,data)
    if id==hash("editor_mode") then
        -- A structural edit reloads the edit world through the same path; only a real mode change
        -- cancels gestures and an unfinished piece.
        if data.mode~=self.mode then
            self.mode=data.mode
            cancel(self);self.open_dialog,self.warnings_open,self.drawing,self.field,self.help_open=false,false,nil,nil,false
        end
        -- Back on top of the input stack for this mode.
        msg.post(".","acquire_input_focus")
    end
end
