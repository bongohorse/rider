-- Sole gym physics owner. Defold owns bodies/world stepping; all lengths here
-- are engine units. create_chain applies physics.scale once in the binding.
local vehicle = require "main.gym.vehicle"
local socket = require "socket"
local rider = require "main.gym.rider"
local feel = require "main.gym.feel"
local telemetry = require "main.gym.telemetry"
-- Authored recovery proposal, deliberately inside the chain ends. No inactivity rule.
local bounds = {min_x=-3900,max_x=7900,min_y=-500}
local function request_reset(self,reason)
    if self.vehicle and self.vehicle.ready and not self.pending_reset then
        self.pending_reset = {generation=self.generation,reason=reason,requested=socket.gettime()}
    end
end
local function reset(self)
    local request = self.pending_reset
    self.pending_reset = nil
    if request.generation ~= self.generation then return end
    self.resetting = true
    self.held = {}
    self.head_contact,self.sensor_skip=false,2
    local before = vehicle.state(self.vehicle)
    local started = socket.gettime()
    vehicle.reset(self.vehicle)
    assert(b2d.body.is_valid(self.terrain), "Terrain invalid after retry")
    local shapes = b2d.body.get_shapes(self.terrain)
    assert(#shapes==1 and shapes[1].is_chain_segment, "Retry changed terrain chain")
    go.set_position(vmath.vector3(vehicle.config.spawn_x,feel.values.camera_height,500),"/camera")
    self.camera_zoom=feel.values.camera_zoom
    go.set("/camera#camera","orthographic_zoom",self.camera_zoom)
    self.generation = self.generation+1
    self.reset_count = self.reset_count+1
    self.last_reset_reason = request.reason
    self.resetting = false
    self.check_reset_pose = self.testcase=="a3"
    local elapsed = (socket.gettime()-started)*1000
    if self.testcase=="a3" then self.reset_ms[#self.reset_ms+1] = elapsed end
    self.latency_ms = math.max(self.latency_ms,(socket.gettime()-request.requested)*1000)
    if request.reason=="bounds" then self.bounds_count=self.bounds_count+1 end
    print("GYM_RESET "..json.encode({count=self.reset_count,reason=request.reason,x=before.x,y=before.y,vx=before.vx}))
    msg.post("main:/loader#ui","retry_done",{reason=request.reason})
end
local function emit(self, event, data)
    data = data or {}
    data.event = event
    data.run_id = self.run_id
    data.source_sha = sys.get_config_string("rider.source_sha", "development")
    print("RIDER_GYM " .. json.encode(data))
    if html5 and event=="vehicle_ready" then
        html5.run("window.riderReady = "..json.encode(data))
    end
end
local function show_preset(self)
    msg.post("main:/loader#ui","preset",{key=self.preset,modified=self.modified or false,invalid=self.invalid_preset or false})
    msg.post("main:/loader#ui","tuning",feel.snapshot())
end
local function setup(self)
    self.terrain = b2d.get_body("/terrain#body")
    assert(b2d.body.is_valid(self.terrain), "Terrain body unavailable")
    -- A collision resource must contain a shape in this engine. Replace its
    -- temporary seed with a script-created chain in this safe update window.
    b2d.body.destroy_shape(self.terrain, 1)
    assert(b2d.body.is_valid(self.terrain), "Seed removal invalidated terrain body")
    self.chain, self.segments = b2d.body.create_chain(self.terrain, {
        vertices = {vmath.vector3(8192, 0, 0), vmath.vector3(-4096, 0, 0)},
        prev_vertex = vmath.vector3(8448, 0, 0), next_vertex = vmath.vector3(-4352, 0, 0),
        friction = 0.8, restitution = 0, enable_sensor_events = true, filter = {category_bits = 1, mask_bits = 1}
    })
    for _,shape in ipairs(self.segments) do
        assert(b2d.shape.are_sensor_events_enabled(shape.shape_id),"Terrain must participate in head sensor overlaps")
    end
    local shapes = b2d.body.get_shapes(self.terrain)
    assert(#shapes == 1 and shapes[1].is_chain_segment, "Terrain must contain only the chain")
    for x = -4096 + 128, 8192 - 128, 256 do
        factory.create("#checker", vmath.vector3(x, 16, -1))
    end
    if self.testcase ~= "a1" then self.vehicle = vehicle.spawn() end
    self.ready = true
    msg.post("main:/loader#script", "gym_ready")
    emit(self, "ready", {chain_segments = #self.segments, tiles = 48, floor_y = 80})
    if self.scenario then self.scenario.setup(self) end
end
function init(self)
    self.run_id = sys.get_config_string("rider.run_id", "interactive")
    self.testcase = sys.get_config_string("rider.gym_test", "")
    self.test = self.testcase == "a1"
    if self.testcase == "a1" or self.testcase == "a2" or self.testcase == "a3" or self.testcase == "a6" or self.testcase == "a7" or self.testcase == "a8" or self.testcase == "a9" or self.testcase=="a9invalid" then
        assert(sys.get_engine_info().is_debug, "Gym scenarios require a debug build")
        self.scenario = require "main.gym.scenarios"
        self.scenario.bind(emit,request_reset)
    end
    local requested=sys.get_config_string("rider.preset","a")
    if html5 then
        local query=html5.run("new URLSearchParams(location.search).get('preset') || ''")
        if query~="" then requested=query end
    end
    local valid
    self.preset,valid=feel.preset(requested)
    self.invalid_preset=not valid
    self.crash_enabled,self.head_contact,self.sensor_skip=false,false,0
    self.camera_zoom=feel.values.camera_zoom
    self.telemetry_seq=0
    self.metrics = telemetry.new()
    self.held = {}
    self.generation, self.reset_count, self.bounds_count = 1,0,0
    self.reset_ms, self.latency_ms = {},0
    self.drive_tick = 0
    self.max_angle = 0
    self.target = hash("/focus")
    self.tick = 0
    msg.post(".", "acquire_input_focus")
end
function update(self, dt)
    if not self.ready then setup(self); return end
    if self.scenario then self.scenario.update_before(self) end
    if self.vehicle and not self.vehicle.ready then
        vehicle.attach(self.vehicle)
        self.target = self.vehicle.ids.chassis
        emit(self,"vehicle_ready",{bodies=3,joints=2})
        show_preset(self)
    end
    local target = go.get_position(self.target)
    if self.vehicle and self.vehicle.ready then
        local pos,zoom=feel.camera(target,vehicle.state(self.vehicle).vx,go.get_position("/camera"),self.camera_zoom,dt)
        go.set_position(pos,"/camera")
        self.camera_zoom=zoom
        go.set("/camera#camera","orthographic_zoom",zoom)
    else
        go.set_position(vmath.vector3(target.x,feel.values.camera_height,500),"/camera")
    end
    if self.vehicle and self.vehicle.ready then
        rider.paint(self.vehicle,self.head_contact)
        local sample = telemetry.frame(self.metrics,self.vehicle,dt)
        if sample then
            self.telemetry_seq=self.telemetry_seq+1
            sample.sequence=self.telemetry_seq
            sample.preset,sample.modified=self.preset,self.modified or false
            sample.head_contact,sample.crash_enabled=self.head_contact,self.crash_enabled
            msg.post("main:/loader#ui","measurements",sample)
        end
    end
    if self.scenario then self.scenario.update_after(self) end
end
local function command(self)
    if self.ui_captured then return {throttle=0,brake_reverse=0,lean=0,allow_reverse=false} end
    local brake = self.held[hash("brake_down")] or self.held[hash("brake_s")]
    local throttle = self.held[hash("throttle_up")] or self.held[hash("throttle_w")]
    return {throttle = throttle and not brake and 1 or 0, brake_reverse = brake and 1 or 0, allow_reverse = not throttle, lean = (self.held[hash("lean_left")] and 1 or 0)-(self.held[hash("lean_right")] and 1 or 0)}
end
function on_input(self, action_id, action)
    if self.ui_captured then return end
    for _,key in ipairs({"a","b","c"}) do
        if action_id==hash("preset_"..key) then
            if action.pressed then self.pending_preset=key end
            return
        end
    end
    if action_id == hash("crash_toggle") then
        if action.pressed then self.crash_enabled=not self.crash_enabled end
        return
    end
    if action_id == hash("retry") then
        if action.pressed then request_reset(self,"manual") end
        return
    end
    if self.resetting then return end
    if action.pressed then self.held[action_id] = true end
    if action.released then self.held[action_id] = nil end
    if self.scenario then self.scenario.input(self,action_id,action) end
end
function fixed_update(self, dt)
    if self.resetting then return end
    if self.vehicle and self.vehicle.ready then
        local state = vehicle.state(self.vehicle)
        if self.scenario then self.scenario.check_pose(self,state) end
        if state.x<bounds.min_x or state.x>bounds.max_x or state.y<bounds.min_y then request_reset(self,"bounds") end
        if self.sensor_skip>0 then self.sensor_skip=self.sensor_skip-1; self.head_contact=false
        else self.head_contact=rider.contact(self.vehicle) end
        if self.head_contact then
            self.head_seen=true
            if self.crash_enabled then request_reset(self,"head") end
        end
        if self.pending_preset then
            self.preset=feel.preset(self.pending_preset)
            self.pending_preset,self.modified,self.invalid_preset=nil,false,false
            request_reset(self,"preset")
            show_preset(self)
        end
        if self.pending_reset then reset(self) end
        if self.pending_tuning then
            local t=self.pending_tuning;self.pending_tuning=nil
            if feel.set(t.key,t.value) then
                self.last_tune=t
                self.modified=true
                show_preset(self)
            end
        end
        self.last_command = command(self)
        vehicle.apply(self.vehicle,self.last_command,dt)
    end
    if self.scenario then self.scenario.fixed(self,dt) end
end
function final(self)
    -- Body/chain lifetime belongs to Defold's world. Drop session references;
    -- do not destroy a chain again while its world is being unloaded.
    self.terrain, self.chain, self.segments, self.probe, self.vehicle = nil, nil, nil, nil, nil
end
function on_message(self,id,data,sender)
    if id==hash("world_load_count") then self.world_loads=data.count
    elseif id==hash("crash_toggle") then self.crash_enabled=not self.crash_enabled
    elseif id==hash("select_preset") then self.pending_preset=data.key
    elseif id==hash("tune") then self.pending_tuning=data
    elseif id==hash("ui_capture") then self.ui_captured=data.active;self.held={}
    elseif id==hash("measurements_shown") then self.measurements_shown=data
    elseif id==hash("retry_labelled") and data.reason=="bounds" then self.bounds_labelled=true end
end
