local stations=require "main.gym.stations"
local mobile=require "main.gym.mobile"
local history=require "main.gym.history"
local audio=require "main.gym.audio"
-- Sole gym physics owner. Defold owns bodies/world stepping; all lengths here
-- are engine units. create_chain applies physics.scale once in the binding.
local vehicle = require "main.gym.vehicle"
local socket = require "socket"
local rider = require "main.gym.rider"
local feel = require "main.gym.feel"
local telemetry = require "main.gym.telemetry"
local editor_view = require "main.gym.editor_view"
-- Authored recovery proposal, deliberately inside the chain ends. No inactivity rule.
local function request_reset(self,reason)
    if self.vehicle and self.vehicle.ready and not self.pending_reset then
        self.pending_reset = {generation=self.generation,reason=reason,requested=socket.gettime()}
    end
end
local function reset(self)
    local request = self.pending_reset
    self.pending_reset = nil
    if request.generation ~= self.generation then return end
    self.resetting = true
    self.held = {}
    self.mobile={}
    mobile.clear()
    self.head_contact,self.sensor_skip=false,2
    self.finish_prev,self.finish_done,self.attempt_time=nil,false,0
    self.track=nil
    self.history=history.new(self.history.generation+1)
    local before = vehicle.state(self.vehicle)
    local started = socket.gettime()
    vehicle.reset(self.vehicle)
    stations.restart(self)
    assert(b2d.body.is_valid(self.terrain), "Terrain invalid after retry")
    local shapes = b2d.body.get_shapes(self.terrain)
    assert(#shapes==#self.segments+#(self.station.hulls or {}), "Retry changed station topology")
    for _,shape in ipairs(self.segments) do
        assert(b2d.shape.is_valid(shape.shape_id) and b2d.shape.are_sensor_events_enabled(shape.shape_id),"Retry lost chain/sensor handle")
    end
    go.set_position(vmath.vector3(vehicle.config.spawn_x,feel.values.camera_height,500),"/camera")
    self.camera_zoom=feel.values.camera_zoom
    go.set("/camera#camera","orthographic_zoom",self.camera_zoom)
    self.generation = self.generation+1
    self.reset_count = self.reset_count+1
    self.last_reset_reason = request.reason
    self.resetting = false
    self.check_reset_pose = self.testcase=="a3"
    local elapsed = (socket.gettime()-started)*1000
    if self.testcase=="a3" then self.reset_ms[#self.reset_ms+1] = elapsed end
    self.latency_ms = math.max(self.latency_ms,(socket.gettime()-request.requested)*1000)
    if request.reason=="bounds" then self.bounds_count=self.bounds_count+1 end
    print("GYM_RESET "..json.encode({count=self.reset_count,reason=request.reason,x=before.x,y=before.y,vx=before.vx}))
    msg.post("main:/loader#ui","retry_done",{reason=request.reason})
end
-- FINISH (contract "Data model"): the chassis centre crosses the finish segment in its direction between
-- two consecutive physics positions, so fast crossings are not missed. Once per attempt; Retry re-arms.
local function check_finish(self,state)
    local f=self.station.finish
    if not f then return end
    local p={feel.metres(state.x),feel.metres(state.y)}
    local q=self.finish_prev
    self.finish_prev=p
    if not q or self.finish_done then return end
    local a,b,d=f.line[1],f.line[2],f.direction
    local lx,ly=b[1]-a[1],b[2]-a[2]
    -- Side of the finish line along its normal, oriented to the finish direction (also for slanted lines).
    local nx,ny=ly,-lx
    if nx*d[1]+ny*d[2]<0 then nx,ny=-nx,-ny end
    local s0=(q[1]-a[1])*nx+(q[2]-a[2])*ny
    local s1=(p[1]-a[1])*nx+(p[2]-a[2])*ny
    if not (s0<0 and s1>=0) then return end
    local t=s0/(s0-s1)
    local x,y=q[1]+(p[1]-q[1])*t,q[2]+(p[2]-q[2])*t
    local u=((x-a[1])*lx+(y-a[2])*ly)/(lx*lx+ly*ly)
    if u<0 or u>1 then return end
    self.finish_done,self.finish_count,self.finish_time=true,(self.finish_count or 0)+1,self.attempt_time
    print("GYM_FINISH "..json.encode({count=self.finish_count,time=self.attempt_time,speed=feel.metres(state.vx)}))
    msg.post("main:/loader#ui","finish_reached",{time=self.attempt_time})
end
local function emit(self, event, data)
    data = data or {}
    data.event = event
    data.run_id = self.run_id
    data.source_sha = sys.get_config_string("rider.source_sha", "development")
    print("RIDER_GYM " .. json.encode(data))
    if html5 and event=="vehicle_ready" then
        html5.run("window.riderReady = "..json.encode(data))
    end
end
local function show_preset(self)
    msg.post("main:/loader#ui","preset",{key=self.preset,modified=self.modified or false,invalid=self.invalid_preset or false})
    -- Imports reload the world from the loader, which must keep the current preset like a station switch.
    msg.post("main:/loader#script","preset_changed",{key=self.preset})
    msg.post("main:/loader#ui","tuning",feel.snapshot())
end
-- A level that cannot take the vehicle leaves a vehicle-less error world; the loader keeps the previous save.
local function fail_placement(self,err)
    print("GYM_PLACE_FAILED "..json.encode({station=self.station.id,error=tostring(err)}))
    if self.vehicle then vehicle.remove(self.vehicle) end
    msg.post("main:/loader#ui","station_error",{note=(self.station.custom and "Custom level" or "Station")..": the vehicle could not be placed ("..tostring(err).."). Import another level [I]."})
    self.station,self.segments,self.chain,self.vehicle=nil,nil,nil,nil
    self.target=hash("/focus")
    -- go.delete completes at the end of the frame; the debug report reads the world afterwards.
    if html5 and sys.get_engine_info().is_debug then self.placement_report=2 end
    self.ready=true
    msg.post("main:/loader#script","gym_ready",{ok=false,generation=self.session_generation,reason="the vehicle could not be placed ("..tostring(err)..")"})
end
local function setup(self)
    self.terrain = b2d.get_body("/terrain#body")
    assert(b2d.body.is_valid(self.terrain), "Terrain body unavailable")
    if self.edit then
        -- Edit mode: a vehicle-less world that only draws the editor document.
        editor_view.build(self)
        self.ready=true
        msg.post("main:/loader#script","gym_ready",{ok=true,generation=self.session_generation,edit=true})
        return
    end
    if not self.station then
        msg.post("main:/loader#ui","station_error",{note=self.station_note or "Invalid station"})
        self.ready=true
        msg.post("main:/loader#script","gym_ready",{ok=false,generation=self.session_generation})
        return
    end
    stations.configure(self.station)
    -- A failed build leaves a vehicle-less error world; the next load replaces it entirely.
    local built,err=pcall(function()
        local chains
        local started=socket.gettime()
        chains,self.segments=stations.build(self.terrain,self.station)
        local built_at=socket.gettime()
        self.chain=chains[1]
        self.decor_sprites,self.decor_labels=stations.decorate(self.station)
        self.load.build_ms,self.load.decorate_ms=(built_at-started)*1000,(socket.gettime()-built_at)*1000
    end)
    if not built then
        print("GYM_BUILD_FAILED "..json.encode({station=self.station.id,error=tostring(err)}))
        msg.post("main:/loader#ui","station_error",{note=(self.station.custom and "Custom level" or "Station").." could not be built. Import another level [I]."})
        self.station,self.segments,self.chain=nil,nil,nil
        self.ready=true
        msg.post("main:/loader#script","gym_ready",{ok=false,generation=self.session_generation,reason="the level could not be built"})
        return
    end
    local placeable,place_err=stations.placeable(self.station)
    if not placeable then
        fail_placement(self,place_err)
        return
    end
    self.ready = true
    -- The loader treats a level as loaded (and saves it) only once the vehicle is drive-ready.
    if self.testcase ~= "a1" then
        local spawned,spawn_err=pcall(function() self.vehicle = vehicle.spawn() end)
        if not spawned then fail_placement(self,spawn_err);return end
    else msg.post("main:/loader#script","gym_ready",{ok=true,generation=self.session_generation}) end
    emit(self, "ready", {chain_segments = #self.segments, tiles = 48, floor_y = 80})
    if self.scenario then self.scenario.setup(self) end
end
function init(self)
    self.station,self.station_note=stations.initial()
    mobile.init()
    self.mobile={}
    self.run_id = sys.get_config_string("rider.run_id", "interactive")
    self.testcase = sys.get_config_string("rider.gym_test", "")
    self.test = self.testcase == "a1"
    if self.testcase == "a1" or self.testcase == "a2" or self.testcase == "a3" or self.testcase == "a6" or self.testcase == "a7" or self.testcase == "a8" or self.testcase == "a9" or self.testcase=="a9invalid" or self.testcase=="a10" or self.testcase=="a11" or self.testcase=="a12" or self.testcase=="m2feedback" or self.testcase=="coast" or self.testcase=="hud" or self.testcase=="a15a" then
        assert(sys.get_engine_info().is_debug, "Gym scenarios require a debug build")
        self.scenario = require "main.gym.scenarios"
        self.scenario.bind(emit,request_reset)
    end
    if self.testcase=="a16" or self.testcase=="a17" or self.testcase=="a19" then
        assert(sys.get_engine_info().is_debug,"Ramp trial requires debug engine")
        self.ramp_trial=require "main.gym.ramp_trial"
    end
    if self.testcase=="le1b" then assert(sys.get_engine_info().is_debug,"Size report requires debug engine") end
    if self.testcase=="le2" or self.testcase=="le3" then assert(sys.get_engine_info().is_debug,"Editor probes require debug engine") end
    if self.testcase=="le1a" then
        assert(sys.get_engine_info().is_debug,"Custom level probes require debug engine")
        self.placement_sweep=require "main.gym.placement_sweep"
    end
    if self.testcase=="a18" or self.testcase=="a18powered" then
        assert(sys.get_engine_info().is_debug,"Seam trial requires debug engine")
        self.seam_trial=require "main.gym.seam_trial"
    end
    local requested=sys.get_config_string("rider.preset","a")
    if html5 then
        local query=html5.run("new URLSearchParams(location.search).get('preset') || ''")
        if query~="" then requested=query end
    end
    local valid
    self.preset,valid=feel.preset(requested)
    self.invalid_preset=not valid
    self.crash_enabled,self.head_contact,self.sensor_skip=false,false,0
    self.camera_zoom=feel.values.camera_zoom
    self.history=history.new()
    self.telemetry_seq=0
    self.metrics = telemetry.new()
    self.held = {}
    self.generation, self.reset_count, self.bounds_count = 1,0,0
    self.session_generation=1
    self.load={}
    self.reset_ms, self.latency_ms = {},0
    self.drive_tick = 0
    self.max_angle = 0
    self.target = hash("/focus")
    self.tick = 0
    msg.post(".", "acquire_input_focus")
end
function update(self, dt)
    if not self.ready then setup(self); return end
    if self.edit then editor_view.update(self);return end
    if self.placement_report then
        self.placement_report=self.placement_report-1
        if self.placement_report==0 then
            self.placement_report=nil
            local c=b2d.world.get_counters(b2d.body.get_world(self.terrain))
            html5.run("window.riderPlacement="..json.encode({generation=self.session_generation,bodies=c.body_count,joints=c.joint_count}))
        end
    end
    if not self.station then return end
    if self.track then html5.run("window.riderTrack="..json.encode({generation=self.session_generation,resets=self.reset_count or 0,max_x=self.track.max_x,max_y=self.track.max_y,min_y=self.track.min_y,
        wheel_max_x=self.track.wheel_max_x,ticks=self.track.ticks,x=self.track.x,y=self.track.y,vx=self.track.vx})) end
    self.mobile=mobile.poll(dt,self.vehicle and self.vehicle.ready and b2d.world.get_profile(b2d.body.get_world(self.vehicle.chassis)).step or 0)
    if self.mobile.clear then self.held={};msg.post("main:/loader#ui","cancel_drag") end
    if self.mobile.started then audio.start(self) end
    if self.mobile.retry then request_reset(self,"manual") end
    if self.mobile.next_section then self.pending_section=true end
    if self.mobile.station then msg.post("main:/loader#script","select_station",{id=self.mobile.station,preset=self.preset}) end
    if self.scenario then self.scenario.update_before(self) end
    if self.vehicle and not self.vehicle.ready then
        local placed,err=pcall(function()
            vehicle.attach(self.vehicle)
            -- Factories can receive an engine step before attach. Use Retry's
            -- canonical pose before the very first authored speed start too.
            vehicle.reset(self.vehicle)
            stations.restart(self)
        end)
        if not placed then fail_placement(self,err);return end
        self.finish_prev,self.finish_done,self.attempt_time=nil,false,0
        msg.post("main:/loader#script","gym_ready",{ok=true,generation=self.session_generation})
        self.target = self.vehicle.ids.chassis
        if self.load.requested then self.load.switch_ms=(socket.gettime()-self.load.requested)*1000 end
        -- Load timings use socket.gettime (1 ms steps on HTML5); switch is absent without a trigger (page load).
        -- A separate message keeps the measurements payload clear of msg.post's 2 KiB cap.
        msg.post("main:/loader#ui","load_timing",{generation=self.session_generation,switch_ms=self.load.switch_ms,parse_ms=self.load.parse_ms,
            build_ms=self.load.build_ms,decorate_ms=self.load.decorate_ms})
        emit(self,"vehicle_ready",{bodies=3,joints=2})
        show_preset(self)
    end
    if self.placement_sweep and self.vehicle and self.vehicle.ready and html5 then
        local ok,spec=pcall(json.decode,html5.run("JSON.stringify(window.riderSweepRequest||null)"))
        if ok and type(spec)=="table" then
            html5.run("window.riderSweepRequest=null")
            local result=self.placement_sweep.run(self.vehicle,spec)
            stations.restart(self)
            html5.run("window.riderSweep="..json.encode(result))
        end
    end
    local target = go.get_position(self.target)
    if self.vehicle and self.vehicle.ready then
        local pos,zoom=feel.camera(target,vehicle.state(self.vehicle).vx,go.get_position("/camera"),self.camera_zoom,dt)
        go.set_position(pos,"/camera")
        self.camera_zoom=zoom
        go.set("/camera#camera","orthographic_zoom",zoom)
    else
        go.set_position(vmath.vector3(target.x,feel.values.camera_height,500),"/camera")
    end
    if self.vehicle and self.vehicle.ready then
        audio.update(self)
        rider.animate(self.vehicle,dt)
        rider.paint(self.vehicle,self.head_contact)
        local sample = telemetry.frame(self.metrics,self.vehicle,dt)
        if sample then
            self.telemetry_seq=self.telemetry_seq+1
            sample.sequence=self.telemetry_seq
            stations.enrich(self,sample)
            sample.command=self.last_command or {}
            sample.speed_mps=feel.metres(sample.speed)
            sample.reset_count=self.reset_count
            sample.ui_captured=self.ui_captured or false
            local projection=camera.get_projection("/camera#camera")
            sample.projection_x,sample.projection_y=projection.m00,projection.m11
            sample.audio_started,sample.audio_muted,sample.audio_pitch=self.audio_started or false,self.audio_muted or false,self.audio_pitch or 0
            sample.preset,sample.modified=self.preset,self.modified or false
            sample.head_contact,sample.crash_enabled=self.head_contact,self.crash_enabled
            msg.post("main:/loader#ui","measurements",sample)
            -- LE1a only: sys.serialize and msg.post share dmScript::CheckTable, so this is the exact payload size (2048-byte cap).
            if self.testcase=="le1a" and html5 then html5.run("window.riderMeasurementBytes="..#sys.serialize(sample)) end
            -- LE2 only: world counters prove that Edit/Play switches leave no bodies, joints or shapes behind.
            if self.testcase=="le2" and html5 then
                local c=b2d.world.get_counters(b2d.body.get_world(self.terrain))
                html5.run("window.riderWorldCounts="..json.encode({generation=self.session_generation,bodies=c.body_count,joints=c.joint_count,shapes=c.shape_count}))
            end
            -- LE1b only: Box2D counters/profile parts and the Lua heap go straight to the page (msg.post caps payloads at 2 KiB).
            if self.testcase=="le1b" and html5 then
                local world=b2d.body.get_world(self.terrain)
                local c,p=b2d.world.get_counters(world),b2d.world.get_profile(world)
                html5.run("window.riderWorld="..json.encode({sequence=sample.sequence,station=sample.station,bytes=c.byte_count,shapes=c.shape_count,contacts=c.contact_count,
                    static_tree_height=c.static_tree_height,step_ms=p.step,pairs_ms=p.pairs,collide_ms=p.collide,solve_ms=p.solve,sensors_ms=p.sensors,lua_kib=collectgarbage("count")}))
            end
            for i,series in ipairs(history.series(self.history)) do
                local encoded=json.encode(series.values)
                assert(#encoded<1500,"Graph message exceeds safe payload budget")
                msg.post("main:/loader#ui","graph",{series=i,values=encoded,scale=series.scale,peak=series.peak,positive_peak=series.positive_peak,
                    generation=self.history.generation,count=series.count,oldest_age=series.oldest_age})
            end
        end
    end
    if self.scenario then self.scenario.update_after(self) end
end
local function command(self)
    if self.ui_captured then return {throttle=0,brake_reverse=0,lean=0,allow_reverse=false} end
    local brake = self.mobile.brake or self.held[hash("brake_down")] or self.held[hash("brake_s")]
    local throttle = self.mobile.throttle or self.held[hash("throttle_up")] or self.held[hash("throttle_w")]
    local left=self.mobile.left or self.held[hash("lean_left")]
    local right=self.mobile.right or self.held[hash("lean_right")]
    local lean=self.mobile.tilt or 0
    if left or right then lean=(left and 1 or 0)-(right and 1 or 0) end
    return {throttle = throttle and not brake and 1 or 0, brake_reverse = brake and 1 or 0, allow_reverse = not throttle, lean = lean}
end
function on_input(self, action_id, action)
    if action.pressed then audio.start(self) end
    if action_id==hash("audio_mute") then if action.pressed then audio.mute(self) end;return end
    if self.ui_captured or self.edit then return end
    for i,id in ipairs(stations.ids) do
        if action_id==hash("station_"..i) then
            if action.pressed then msg.post("main:/loader#script","select_station",{id=id,preset=self.preset}) end
            return
        end
    end
    if action_id==hash("section_cycle") then if action.pressed then self.pending_section=true end;return end
    if action_id==hash("preset_cycle") then
        if action.pressed then self.pending_preset=({a="b",b="c",c="a"})[self.preset] end
        return
    end
    if action_id == hash("crash_toggle") then
        if action.pressed then self.crash_enabled=not self.crash_enabled end
        return
    end
    if action_id == hash("retry") then
        if action.pressed then request_reset(self,"manual") end
        return
    end
    if self.resetting then return end
    if action.pressed then self.held[action_id] = true end
    if action.released then self.held[action_id] = nil end
    if self.scenario then self.scenario.input(self,action_id,action) end
end
function fixed_update(self, dt)
    if self.resetting then return end
    if self.vehicle and self.vehicle.ready then
        local state = vehicle.state(self.vehicle)
        if self.scenario then self.scenario.check_pose(self,state) end
        self.attempt_time=(self.attempt_time or 0)+dt
        check_finish(self,state)
        if self.testcase=="le3" then
            -- LE3b only: per-tick extremes of chassis and wheel centres (metres) prove that a two-sided
            -- curl holds the vehicle; a 0.25 s telemetry sample could miss a pass-through.
            local t=self.track or {max_x=-math.huge,max_y=-math.huge,min_y=math.huge,wheel_max_x=-math.huge,ticks=0}
            self.track=t
            t.ticks=t.ticks+1
            t.max_x,t.max_y,t.min_y=math.max(t.max_x,feel.metres(state.x)),math.max(t.max_y,feel.metres(state.y)),math.min(t.min_y,feel.metres(state.y))
            for _,wheel in ipairs(self.vehicle.wheels) do t.wheel_max_x=math.max(t.wheel_max_x,feel.metres(b2d.body.get_position(wheel).x)) end
            t.x,t.y,t.vx=feel.metres(state.x),feel.metres(state.y),feel.metres(state.vx)
        end
        if stations.outside(self.station,state) then request_reset(self,"bounds") end
        if self.sensor_skip>0 then self.sensor_skip=self.sensor_skip-1; self.head_contact=false
        else self.head_contact=rider.contact(self.vehicle) end
        if self.head_contact then
            self.head_seen=true
            if self.crash_enabled then request_reset(self,"head") end
        end
        if self.pending_preset then
            self.preset=feel.preset(self.pending_preset)
            self.pending_preset,self.modified,self.invalid_preset=nil,false,false
            request_reset(self,"preset")
            show_preset(self)
        end
        if self.pending_section then
            self.pending_section=nil
            if self.station.sections then
                stations.select(self.station,self.station.section_index%#self.station.sections+1)
                stations.configure(self.station)
                request_reset(self,"section")
            end
        end
        if self.pending_reset then reset(self) end
        if self.pending_tuning then
            local t=self.pending_tuning;self.pending_tuning=nil
            if feel.set(t.key,t.value) then
                self.last_tune=t
                self.modified=true
                show_preset(self)
            end
        end
        self.last_command = self.seam_trial and self.seam_trial.command(self.station,self.testcase=="a18") or self.ramp_trial and self.ramp_trial.command(self.station) or command(self)
        vehicle.apply(self.vehicle,self.last_command,dt)
        rider.sample(self.vehicle,self.last_command)
        local sample=telemetry.sample(self.vehicle)
        stations.observe(self,vehicle.state(self.vehicle),dt,sample)
        history.push(self.history,sample,dt)
    end
    if self.scenario then self.scenario.fixed(self,dt) end
end
function final(self)
    mobile.final()
    audio.stop(self)
    -- Body/chain lifetime belongs to Defold's world. Drop session references;
    -- do not destroy a chain again while its world is being unloaded.
    self.terrain, self.chain, self.segments, self.probe, self.vehicle = nil, nil, nil, nil, nil
end
function on_message(self,id,data,sender)
    if id==hash("configure_station") and not self.ready and data.edit then
        self.edit,self.station=true,nil
        self.session_generation=data.generation or 1
    elseif id==hash("configure_station") and not self.ready then
        self.station,self.station_note=stations.load(data.id,data.speed,nil,data.snapshot)
        if not self.station and data.note then self.station_note=data.note end
        self.preset=feel.preset(data.preset or self.preset or "a") -- no loader preset yet: keep the URL preset
        self.session_generation=data.generation or 1
        self.load={requested=data.requested,parse_ms=data.parse_ms}
    elseif id==hash("world_load_count") then self.world_loads=data.count
    elseif id==hash("crash_toggle") then self.crash_enabled=not self.crash_enabled
    elseif id==hash("next_section") then self.pending_section=true
    elseif id==hash("select_preset") then self.pending_preset=data.key
    elseif id==hash("audio_mute") then audio.mute(self)
    elseif id==hash("clear_input") then self.held={};self.mobile={};mobile.clear();msg.post("main:/loader#ui","cancel_drag")
    elseif id==hash("feedback_status") then self.feedback_status=data.status;self.feedback_visible=data.visible
    elseif id==hash("tune") then self.pending_tuning=data
    elseif id==hash("ui_capture") then self.ui_captured=data.active;self.held={};self.mobile={};mobile.clear()
    elseif id==hash("graph_shown") and data.generation==self.history.generation then
        self.graph_peaks=self.graph_peaks or {};self.graph_peaks[data.series]=data.peak
        if data.series>1 then self.graph_seen_peak=math.max(self.graph_seen_peak or 0,data.positive_peak) end
    elseif id==hash("hud_probe_result") then self.hud_probe_result=data
    elseif id==hash("measurements_shown") then self.measurements_shown=data
    elseif id==hash("retry_labelled") and data.reason=="bounds" then self.bounds_labelled=true end
end
