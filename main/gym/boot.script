-- Proxy is the only world-switch owner; messages serialize confirmed unload/load.
local stations=require "main.gym.stations"
local custom=require "main.gym.custom"
local station_data=require "main.gym.station_data"
local socket=require "socket"
local editor=require "main.gym.editor"
local doc_lib=require "main.gym.editor_doc"
local EDITOR="main:/editor#gui"
local time_scale=require "main.gym.time_scale"
local OWNER="gym:/owner#script"
local function switch(self,request)
    self.station,self.speed=request.id,request.speed or ""
    self.snapshot,self.note,self.import=request.snapshot,request.note,request.import
    self.edit,self.play=request.edit,request.play
    -- Loop latency (R15): the world reports trigger -> drive-ready from this loader-side trigger time.
    self.requested,self.parse_ms=request.requested,request.parse_ms
    self.preset=request.preset or self.preset
    self.generation=self.generation+1
    self.loading,self.deadline=true,0
    -- A20: every new world (station, Edit/Play, import) starts running at 1.0, so measurements start comparable.
    self.time=time_scale.new()
    msg.post("#ui","time_state",time_scale.state(self.time))
    msg.post("#ui","station_loading",{generation=self.generation})
    msg.post("#ui","cancel_drag")
    msg.post("#world","disable")
    msg.post("#world","final")
    msg.post("#world","unload")
end
-- Edit/Play mode (R11, R15). Both directions reload the world; the editor state stays loader-side.
local function set_mode(self,mode,note)
    editor.mode=mode
    if note then editor.message=note end
    msg.post(EDITOR,"editor_mode",{mode=mode})
    msg.post("#ui","editor_mode",{active=mode=="edit"})
    if html5 then
        html5.run("window.riderEditing="..tostring(mode=="edit")..";document.body.classList.toggle('rider-editing',window.riderEditing);document.getElementById('custom-import')?.toggleAttribute('hidden',window.riderEditing);window.riderCustom?.closeEditor?.()")
        -- A reload returns to the custom level or draft, never to the built-in source of a template.
        html5.run("(()=>{const u=new URL(location.href);if(u.searchParams.get('station')!=='custom'){u.searchParams.set('station','custom');u.searchParams.delete('section');u.searchParams.delete('speed');history.replaceState(null,'',u.href);}})()")
    end
end
-- Whether a document belongs to a saved level. Since LE4 ids may repeat (an import keeps its id), so a
-- level played from My levels is matched by its storage key; levels without one (imported files, saves
-- from before LE4) by id as in LE2. doc_key 0 is an unsaved copy.
local function same_level(level_key,level_id,doc_key,doc_id)
    if level_key then return doc_key==level_key end
    return doc_id==level_id
end
local function enter_edit(self,note)
    set_mode(self,"edit",note)
    switch(self,{id="custom",edit=true,requested=socket.gettime()})
end
-- E opens the editor on the current level: the in-memory document or the draft of this level,
-- otherwise this level (R2) or a template copy of the built-in station (R3). A replaced document
-- stays one Undo step away.
local function open_current(self)
    local saved=editor.saved_draft()
    local notice
    if saved and saved.unsupported then
        -- R1: only that draft is refused; its slot stays untouched (drafts are saved around it).
        notice="The newest draft was made by an unsupported editor ("..saved.unsupported.."). It is kept unchanged and was not opened."
        saved=nil
    end
    local level=self.station=="custom" and self.level_id and custom.peek(self.level_snapshot)
    -- The editor's own document or draft is reused only for a level it produced; an imported file
    -- with the same id opens as itself (one Undo step away from the previous document).
    local own=level and self.level_edited
    local key=level and self.level_key
    if editor.doc and key and editor.key()==key then editor.message=notice or editor.message;return true end
    -- An unplayed document stays current (also after a test run of it) unless a level was imported after its last edit.
    local unplayed=editor.doc and editor.doc.editor.compiled_revision~=editor.doc.editor.revision and (editor.changed_at or 0)>(self.level_loaded_at or 0)
    if editor.doc and self.station=="custom" and (not level or (own and same_level(key,level.id,editor.key(),editor.doc.id)) or unplayed) then editor.message=notice or editor.message;return true end
    -- The draft's My levels key (0: an unsaved copy); its level copy may lag after a failed save.
    local function opts(d)
        local k=d.key~=0 and d.key or nil
        return {key=k,store=d.key==nil,behind=k and editor.library_behind(k,d.text),saved=true}
    end
    if saved and saved.doc and own and same_level(key,level.id,saved.key,saved.doc.id) then
        if not editor.open(saved.doc,false,opts(saved)) then return nil,editor.message end
        editor.message=notice or "";return true
    end
    if not editor.doc and saved and saved.doc then editor.open(saved.doc,false,opts(saved)) end
    -- A level played from My levels opens its latest saved source (LE4), not an older compiled copy.
    local stored=key and editor.library().load(key)
    if stored then
        if not editor.open(stored,editor.doc~=nil,{key=key}) then return nil,editor.message end
        editor.message=notice or ""
        return true
    end
    local doc,note,conflict
    if level then doc,note,conflict=doc_lib.open_level(level)
    else
        local d=stations.resource(self.station~="custom" and self.station or "straight")
        if not d then return nil,"The station cannot be opened as a template" end
        doc,note=doc_lib.template(d)
    end
    if not editor.open(doc,editor.doc~=nil) then return nil,editor.message end
    editor.conflict=conflict
    if notice or note then editor.message=notice or note end
    return true
end
local function play(self,test)
    local level,err,run=editor.compile(test)
    if not level then editor.message="Play blocked: "..err;return end
    -- Empty lists stay JSON arrays (checkpoints, hulls, labels).
    local list={encode_empty_table_as_object=false}
    local text,run_text=json.encode(level,list),run and json.encode(run,list)
    if #text>custom.limit then editor.message="Play blocked: the level is larger than 256 KiB";return end
    -- The run may use a temporary test start; only the START level is saved and exported (R10).
    local snapshot=custom.freeze(run or level,run_text or text)
    self.play_text,self.test_run,self.play_revision=text,run~=nil,editor.doc.editor.revision
    -- Recorded as the last test start (LE6 navigation) only once this run is drive-ready.
    self.test_start=run and {position={run.spawn[1],run.spawn[2]},instance=editor.opened} or nil
    set_mode(self,"play")
    switch(self,{id="custom",snapshot=snapshot,play=true,requested=socket.gettime()})
end
-- Import inside the editor (LE4, R12): validated like any import, then opened as a copy that is saved to
-- My levels; nothing is played or overwritten. The editor's Import button is the only entry point while
-- editing (the page shortcut and button stay off, R15).
local function import_into_editor(self,request)
    local d,err=custom.parse(request.text)
    if not d then
        custom.notify(request.request,"error","Import failed: "..err..". The open level and My levels are unchanged.")
        return
    end
    local doc,note,conflict=doc_lib.open_level(d)
    if not editor.open(doc,true,{store=true}) then
        custom.notify(request.request,"error","Import refused: "..editor.message)
        return
    end
    editor.conflict=conflict
    editor.message=note or "Imported "..d.name.." as a copy (My levels)."
    custom.notify(request.request,"loaded","Imported.")
end
-- Import = read/validate, freeze a snapshot, then reload the world. Save only after it loaded.
local function import(self,request)
    -- The editor's Import is routed by its flag: it never replaces the played level, even if the editor
    -- was left meanwhile; the page import is refused while editing (R15).
    if request.editor then
        if editor.mode=="edit" then import_into_editor(self,request)
        else custom.notify(request.request,"error","The editor was closed; nothing was imported.") end
        return
    end
    if editor.mode=="edit" then
        custom.notify(request.request,"error","Leave the editor [E] before importing a level.")
        return
    end
    local requested=socket.gettime()
    local d,err=custom.parse(request.text)
    if not d then
        custom.notify(request.request,"error","Import failed: "..err..". The current level and its save are unchanged.")
        return
    end
    local snapshot=custom.freeze(d,request.text)
    custom.notify(request.request,"loading","Loading "..d.name.."...")
    local next={id="custom",snapshot=snapshot,import=request.request,requested=requested,parse_ms=(socket.gettime()-requested)*1000}
    if self.loading then
        -- Never replace the snapshot an in-flight load reads; run the newest import afterwards.
        self.queued=next
        custom.retain({[self.snapshot or ""]=true,[snapshot]=true})
    else switch(self,next) end
end
function init(self)
    msg.post(".","acquire_input_focus")
    custom.init()
    self.debug_limits=html5 and sys.get_engine_info().is_debug and sys.get_config_string("rider.gym_test","")=="le1a"
    local case=sys.get_config_string("rider.gym_test","")
    self.debug_editor=html5 and sys.get_engine_info().is_debug and (case=="ea3" or case=="le2" or case=="le3" or case=="le4" or case=="le5a" or case=="le5b" or case=="le5c" or case=="le5d" or case=="le6")
    self.debug_le3=self.debug_editor and case=="le3"
    self.world_loads,self.generation=0,1
    self.time=time_scale.new()
    self.loading,self.deadline=true,0
    local id,speed=stations.query()
    if sys.get_config_int("rider.terrain_compare",0)==1 and require("main.terrain_compare.entry").initial(self) then
        -- Isolated P1 build: do not restore or replace the player's saved editor documents.
    elseif id=="custom" then
        self.station,self.speed=id,speed
        local saved,rejected=custom.restore()
        local draft=editor.saved_draft()
        local draft_time,draft_key,draft_text=draft and draft.time,draft and draft.key,draft and draft.text
        draft=draft and draft.doc
        -- A draft with unplayed edits reopens the editor after a reload, whichever level is saved: the
        -- draft records the revision its last successful Play compiled (compiled_revision).
        -- A level saved after the draft (e.g. an import) wins; without any level the draft always opens.
        local newer=draft and saved and (saved.time or 0)>(draft_time or 0)
        if draft and (not saved or (draft.editor.compiled_revision~=draft.editor.revision and not newer)) then
            if saved then self.level_snapshot=custom.freeze(saved.doc,saved.text);self.level_id,self.level_key=saved.doc.id,saved.key;self.level_edited=same_level(saved.key,saved.doc.id,draft_key,draft.id) end
            -- A draft from before LE4 has no key: it is saved to My levels as a new entry (store).
            local key=draft_key~=0 and draft_key or nil
            editor.open(draft,false,{key=key,store=draft_key==nil,behind=key and editor.library_behind(key,draft_text),saved=true})
            self.edit=true
            set_mode(self,"edit")
        elseif saved then
            self.snapshot=custom.freeze(saved.doc,saved.text)
            self.restored_edited=draft~=nil and same_level(saved.key,saved.doc.id,draft_key,draft.id)
            self.restored_key=saved.key
            self.restore_note=saved.skipped and "Restored the previous level; the newer save is no longer valid ("..saved.skipped..")"
        else
            self.note=rejected and "The saved custom level is no longer valid ("..rejected.."). Import a level file [I]." or "No saved custom level. Import a level file [I]."
            custom.open(self.note)
        end
    else
        local d=stations.initial();self.station=d and d.id or "straight"
        self.speed=d and d.start_speed or 0
    end
    msg.post("#world","load")
end
function update(self,dt)
    if self.loading then
        self.deadline=self.deadline+dt
        if self.deadline>15 and not self.failed then
            self.failed=true
            msg.post("#ui","station_error",{note="Station loading timed out. Reload to retry."})
            msg.post("#world","disable")
        end
    end
    if self.debug_limits then
        -- Debug fault injection (le1a only): lift the validator and/or load-path start limit to reach a real placement failure.
        local ok,limits=pcall(json.decode,html5.run("JSON.stringify(window.riderDebugLimits||{})"))
        if ok and type(limits)=="table" then
            station_data.START_LIMIT=limits.validator or station_data.START_LIMIT_DEFAULT
            stations.place_limit=limits.placement or station_data.START_LIMIT_DEFAULT
        end
    end
    local request=custom.take()
    if request then
        if sys.get_config_int("rider.terrain_compare",0)==1 then custom.notify(request.request,"error","Use the comparison course selector; normal saved levels are unchanged.")
        else import(self,request) end
    end
    if self.debug_editor then
        -- Debug fault injection (le2 only): write a raw draft slot, e.g. an unsupported editor version.
        local ok,raw=pcall(json.decode,html5.run("(()=>{const r=window.riderDebugDraft;window.riderDebugDraft=null;return JSON.stringify(r||null)})()"))
        if ok and type(raw)=="table" then
            -- raw.key writes a My levels slot instead (le4: an unsupported saved level).
            local target=raw.version and editor.versions.store(raw.version) or raw.key and editor.library().store(raw.key) or editor.draft_store()
            target.debug_write(raw.slot,raw.seq,raw.text,raw.now and os.time() or nil)
        end
        -- Debug control (le3 only): build two-sided runs one-sided, to show what the reversed chain holds.
        if self.debug_le3 then stations.debug_one_sided=html5.run("String(!!window.riderDebugOneSided)")=="true" end
    end
    if self.debug_editor and sys.get_config_string("rider.gym_test","")=="ea3" then
        local ok,r=pcall(json.decode,html5.run("(()=>{let r=window.riderVersionRequest;window.riderVersionRequest=null;return JSON.stringify(r||null)})()"))
        if ok and type(r)=="table" then
            local yes,err
            if r.op=="add" then
                local text=r.text or json.encode(editor.doc,{encode_empty_table_as_object=false})
                if r.pad then text=text..string.rep(" ",r.pad) end
                yes,err=editor.versions.add(r.key or editor.key(),text,r.name or "Test",r.named==true)
            elseif r.op=="remove" then yes,err=editor.versions.remove(r.key or editor.key(),r.id)
            elseif r.op=="clock" then editor.version_times[editor.key()]=socket.gettime()-(r.seconds or 0);yes=true
            elseif r.op=="measure" then yes=true
            end
            html5.run("window.riderVersionResult="..json.encode({token=r.token,ok=yes or false,error=err or false,bytes=editor.versions.bytes(),entries=editor.versions.list(r.key or editor.key())},{encode_empty_table_as_object=false}))
        end
    end
    if self.syncing then
        local state=custom.sync_state()
        if state~="syncing" then
            self.syncing=false
            msg.post("#ui","custom_status",{text=state=="saved" and "Saved" or state=="session" and "Saved for this session only (browser storage unavailable)"
                or "Browser storage sync failed; the level may not survive a reload"})
        end
    end
end
function on_message(self,id,data,sender)
    if sys.get_config_int("rider.terrain_compare",0)==1 and (id==hash("editor_enter") or id==hash("editor_play") or id==hash("editor_reload") or id==hash("select_station")) then
        msg.post("#ui","custom_status",{text="Use the terrain comparison controls; editor and saved levels are unchanged."})
        return
    end
    if id==hash("preset_changed") then self.preset,self.preset_refused=data.key,data.refused
    -- A20 pause/slow motion: play worlds only. Pausing stops ticks at once; any running factor is set only after
    -- the controller acknowledged (time_ready) and cleared its input, so no tick runs with input from before.
    elseif id==hash("time_control") and not self.loading and editor.mode=="play" then
        if time_scale.control(self.time,data.action) then
            self.time.seq=self.time.seq+1
            if self.time.paused then time_scale.apply(self.time,"#world") end
            msg.post(OWNER,"time_state",time_scale.state(self.time,self.generation))
            msg.post("#ui","time_state",time_scale.state(self.time))
        end
    -- Only the acknowledgement of the newest request applies: an older one may predate a later pause or resume.
    elseif id==hash("time_ready") and data.generation==self.generation and data.seq==self.time.seq and not self.loading and editor.mode=="play" then
        time_scale.apply(self.time,"#world")
    elseif id==hash("editor_enter") and not self.loading and editor.mode=="play" then
        local ok,err=open_current(self)
        if ok then enter_edit(self) else editor.message=err end
    elseif (id==hash("editor_enter") or id==hash("editor_play")) and self.loading then
        editor.message="The level is still loading; press "..(id==hash("editor_play") and "Play" or "E").." again."
    elseif id==hash("editor_play") and not self.loading and editor.mode=="edit" then play(self,data.test)
    elseif id==hash("editor_reload") and not self.loading and editor.mode=="edit" then enter_edit(self)
    elseif id==hash("select_station") and not self.loading and editor.mode=="play" then
        local d,note=stations.load(data.id,data.speed)
        if not d then msg.post("#ui","station_error",{note=note});return end
        switch(self,{id=d.id,speed=data.speed,preset=data.preset,requested=socket.gettime()})
    elseif id==hash("proxy_unloaded") then
        msg.post("#world","load")
    elseif id==hash("proxy_loaded") then
        self.world_loads=self.world_loads+1
        msg.post(sender,"init")
        time_scale.apply(self.time,sender,editor.mode=="edit")
        if self.world_loads>1 or self.station=="custom" then
            msg.post("gym:/owner#script","configure_station",{id=self.station,speed=self.speed,preset=self.preset,preset_refused=self.preset_refused,generation=self.generation,
                snapshot=self.snapshot,note=self.note,requested=self.requested,parse_ms=self.parse_ms,edit=self.edit})
        end
        msg.post(sender,"enable")
    elseif id==hash("gym_ready") and data.generation==self.generation then
        self.loading=false
        msg.post(sender,"world_load_count",{count=self.world_loads,generation=self.generation})
        if not data.edit then msg.post(sender,"time_state",time_scale.state(self.time,self.generation)) end
        local loaded=self.station=="custom" and data.ok and self.snapshot
        -- A test run's snapshot carries a temporary start; the editor keeps opening from the saved level.
        if loaded and not (self.play and self.test_run) then
            self.level_snapshot,self.level_id=loaded,custom.peek(loaded).id
            self.level_edited=self.play==true or (self.restored_edited==true and not self.import)
            -- The My levels entry this level was played from (LE4); an imported file has none.
            self.level_key=self.play and editor.key() or (not self.import and self.restored_key) or nil
            self.restored_edited,self.restored_key=nil,nil
        end
        if self.queued then
            local next=self.queued;self.queued=nil
            custom.retain({[next.snapshot]=true})
            switch(self,next)
            return
        end
        -- The ready world has read its snapshot; keep only that one (and the level the editor opens from).
        custom.retain({[loaded or ""]=true,[self.level_snapshot or ""]=true})
        if self.restore_note and data.ok then msg.post("#ui","custom_status",{text=self.restore_note}) end
        self.restore_note=nil
        if self.edit then return end
        if self.play then
            self.play=false
            if not loaded then
                enter_edit(self,"Play failed: "..(data.reason or "the level could not be built")..". The previous saved level is kept.")
                return
            end
            -- A test start never replaces the save: its START was not the start that was driven.
            if self.test_run then
                editor.last_test=self.test_start
                msg.post("#ui","custom_status",{text="Test run; the saved level is unchanged"})
                return
            end
            -- Play result: only a drive-ready level replaces the save (decisions after LE1b).
            local saved,err=custom.save(self.play_text,editor.key())
            if saved then
                self.syncing=true
                msg.post("#ui","custom_status",{text="Saving..."})
                -- The draft now matches a played level: a reload drives instead of reopening the editor.
                local e=editor.doc and editor.doc.editor
                if e and e.revision==self.play_revision then e.compiled_revision=e.revision;editor.save_draft() end
                if self.debug_editor then html5.run("window.riderSavedLevel="..self.play_text) end
            else
                msg.post("#ui","custom_status",{text="Save failed; the previous saved level is kept ("..err..")"})
            end
            return
        end
        if not self.import and self.station=="custom" and not data.ok then
            custom.open(self.note or "The saved level could not be loaded ("..(data.reason or "the level could not be built").."). Import another level file.")
        end
        if self.import then
            local request=self.import;self.import=nil
            if not loaded then
                local reason=data.reason or "the level could not be built"
                custom.notify(request,"error","Import failed: "..reason..". The previous saved level is kept.")
                custom.open("Import failed: "..reason..". Import another level file.")
            else
                local saved,err=custom.save(custom.text(loaded))
                self.level_loaded_at=socket.gettime()
                if saved then
                    custom.notify(request,"loaded","Loaded.")
                    self.syncing=true
                    msg.post("#ui","custom_status",{text="Saving..."})
                else
                    custom.notify(request,"loaded","Loaded.")
                    msg.post("#ui","custom_status",{text="Save failed; the previous saved level is kept ("..err..")"})
                end
            end
        end
    end
end
