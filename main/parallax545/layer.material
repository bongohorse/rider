name: "parallax545"
tags: "tile"
vertex_program: "/main/parallax545/layer.vp"
fragment_program: "/main/parallax545/layer.fp"
vertex_space: VERTEX_SPACE_LOCAL
vertex_constants { name: "world_view_proj" type: CONSTANT_TYPE_WORLDVIEWPROJ }
vertex_constants { name: "scroll" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
samplers { name: "tex0" wrap_u: WRAP_MODE_REPEAT wrap_v: WRAP_MODE_REPEAT filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }
