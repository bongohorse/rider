local socket=require "socket"
local stations=require "main.game.stations"
local mobile=require "main.game.mobile"
local layout=require "main.game.layout"
local run_ui=require "main.game.run_ui"
local levels_ui=require "main.game.levels_ui"
local progress_ui=require "main.game.progress_ui"
local feel=require "main.game.feel"
local graph=require "main.game.graph"
local feedback=require "main.game.feedback"
local controls=require "main.game.controls"
local telemetry = require "main.game.telemetry"
local fps_counter=require "main.game.fps_counter"
local fps_place=require "main.game.fps_place"
local camera_hud=require "main.game.camera_hud"
-- ui.gui max_nodes (raised from the default 512 for the #443 camera control and panel); the debug camera state
-- publishes the nodes in use against it.
local MAX_NODES=600
-- #444: DOM controls over the canvas (drive zones, toolbar with Pause, level actions, page buttons) as GUI screen
-- rectangles (canvas pixels, origin bottom left). Open dialogs and the More menu are transient overlays above
-- everything and are left out; hidden elements have no box.
local DOM_CONTROLS=[[(()=>{const c=document.querySelector('canvas');if(!c)return '[]';const r=c.getBoundingClientRect();
if(!(r.width>0&&r.height>0))return '[]';const sx=c.width/r.width,sy=c.height/r.height,out=[];
for(const e of document.querySelectorAll('button,select,input,textarea,a[href],[role=button],[data-command]')){
if(e.closest('[role=dialog],[aria-modal=true],#rider-mobile-more,#rider-playbar .pb-menu'))continue;const b=e.getBoundingClientRect();
if(!(b.width>0&&b.height>0)||getComputedStyle(e).visibility!=='visible')continue;
if(b.right<=r.left||b.left>=r.right||b.bottom<=r.top||b.top>=r.bottom)continue;
out.push([(b.left-r.left)*sx,(r.bottom-b.bottom)*sy,(b.right-r.left)*sx,(r.bottom-b.top)*sy]);}
return JSON.stringify(out)})()]]
-- #443: one DOM query per placement poll for the controls (as above) and the touch HUD's status line (.readout: not a
-- control, but above the canvas, so it would hide panel buttons). Its width follows its text, so a ResizeObserver
-- counts its size changes (seq); the HUD re-places at once when seq moves instead of waiting for the next poll.
local HUD_LAYOUT=[[(()=>{if(window.riderHudLayout)return;const L=window.riderHudLayout={seq:0,el:null};
const ro=window.ResizeObserver?new ResizeObserver(()=>{L.seq++;}):null;
const rects=sel=>{const c=document.querySelector('canvas');if(!c)return [];const r=c.getBoundingClientRect();
if(!(r.width>0&&r.height>0))return [];const sx=c.width/r.width,sy=c.height/r.height,out=[];
for(const e of document.querySelectorAll(sel)){
if(e.closest('[role=dialog],[aria-modal=true],#rider-mobile-more,#rider-playbar .pb-menu'))continue;const b=e.getBoundingClientRect();
if(!(b.width>0&&b.height>0)||getComputedStyle(e).visibility!=='visible')continue;
if(b.right<=r.left||b.left>=r.right||b.bottom<=r.top||b.top>=r.bottom)continue;
out.push([(b.left-r.left)*sx,(r.bottom-b.bottom)*sy,(b.right-r.left)*sx,(r.bottom-b.top)*sy]);}
return out;};
L.watch=()=>{const e=document.querySelector('#rider-mobile .readout');
if(e!==L.el){if(L.el&&ro)ro.unobserve(L.el);L.el=e;if(e&&ro)ro.observe(e);L.seq++;}return L.seq;};
L.query=()=>JSON.stringify({seq:L.watch(),controls:rects('button,select,input,textarea,a[href],[role=button],[data-command]'),
readouts:rects('#rider-mobile .readout,#rider-playbar .pb-strip,#rider-playbar .pb-progress,#rider-playbar .pb-card')});})()]]
-- Visible screen area (safe area where the platform reports one), GUI screen pixels.
local function fps_area()
    local w,h=window.get_size()
    local a=window.get_safe_area and window.get_safe_area()
    if a then return {x0=a.inset_left,y0=a.inset_bottom,x1=w-a.inset_right,y1=h-a.inset_top} end
    return {x0=0,y0=0,x1=w,y1=h}
end
-- Screen rectangle of a centre-pivot box node: screen_to_local gives the parent's local units per screen pixel.
local function gui_rect(n)
    local p=gui.get_screen_position(n)
    local a,b=gui.screen_to_local(n,p),gui.screen_to_local(n,p+vmath.vector3(100,100,0))
    local fx,fy=math.abs(b.x-a.x)/100,math.abs(b.y-a.y)/100
    if not (fx>0 and fy>0) then return nil end
    local size,scale=gui.get_size(n),gui.get_scale(n)
    local hw,hh=size.x*scale.x/2/fx,size.y*scale.y/2/fy
    return {x0=p.x-hw,y0=p.y-hh,x1=p.x+hw,y1=p.y+hh}
end
-- Counter tap-area size in screen pixels, from its two corner probes.
local function fps_size(self)
    for _,n in ipairs({self.fps_hit,self.fps_corners[1],self.fps_corners[2]}) do gui.set_position(n,gui.get_position(n)) end
    local a,b=gui.get_screen_position(self.fps_corners[1]),gui.get_screen_position(self.fps_corners[2])
    return math.abs(b.x-a.x),math.abs(a.y-b.y)
end
-- The DOM controls over the canvas as GUI screen rectangles (empty outside HTML5).
local function dom_rects()
    local rects={}
    if not html5 then return rects end
    local ok,dom=pcall(json.decode,html5.run(DOM_CONTROLS))
    if ok and type(dom)=="table" then
        for _,d in ipairs(dom) do rects[#rects+1]={x0=d[1],y0=d[2],x1=d[3],y1=d[4]} end
    end
    return rects
end
-- #443: controls and the touch status line in one query, kept for taps and messages until the next poll.
local function dom_layout(self)
    local out={seq=0,controls={},readouts={}}
    if html5 then
        local ok,d=pcall(json.decode,html5.run("window.riderHudLayout.query()"))
        if ok and type(d)=="table" then
            out.seq=d.seq or 0
            for _,k in ipairs({"controls","readouts"}) do
                for _,r in ipairs(d[k] or {}) do out[k][#out[k]+1]={x0=r[1],y0=r[2],x1=r[3],y1=r[4]} end
            end
        end
    end
    self.dom_cache=out
    return out
end
-- The visible GUI buttons: Pause, Speed, Record, Replay, Next, Section, T, H, Levels, result buttons, the open
-- tuning panel and the editor's 3D look.
local function gui_controls(self)
    local rects={}
    local r=self.run_ui
    local nodes={self.time_buttons.pause.box,self.time_buttons.step.box,self.replay_buttons.record.box,self.replay_buttons.replay.box,
        self.station_next,self.section_next,self.tuning_button,self.help_button,r.entry,r.retry,r.levelnext,r.levelback}
    if self.panel_open then nodes[#nodes+1]=self.tuning_panel end
    for _,n in ipairs(nodes) do
        if gui.get_visible(n) then rects[#rects+1]=gui_rect(n) end
    end
    -- Play-mode buttons of the editor GUI (3D look), from its last render in this shared GUI state; kept from
    -- before while the 3D look panel is open (a transient modal).
    local editor=require "main.editor.editor"
    if not editor.play_ui then self.editor_rects=nil
    elseif not editor.play_ui_modal then self.editor_rects=require("main.editor.editor_ui").screen_rects(editor.play_ui) end
    for _,b in ipairs(self.editor_rects or {}) do rects[#rects+1]=b end
    return rects
end
-- Every visible control the counter must keep clear of: the GUI buttons and the DOM controls (drive zones, Pause,
-- ...). dom: the DOM rectangles of this poll, if already read.
local function fps_blocked(self,dom)
    local rects=gui_controls(self)
    -- DOM controls only while the counter is shown (an ON command refreshes them before placing).
    if html5 and self.fps_setting.visible then
        for _,d in ipairs(dom or dom_rects()) do rects[#rects+1]=d end
    end
    return rects
end
-- #443: the camera control keeps clear of the same controls, the touch status line and the FPS counter (which does
-- not move for it).
local function camera_blocked(self,dom)
    local rects=gui_controls(self)
    for _,d in ipairs(dom.controls) do rects[#rects+1]=d end
    for _,d in ipairs(dom.readouts) do rects[#rects+1]=d end
    if self.fps_setting.visible and self.fps_placed and self.fps_rect then rects[#rects+1]=self.fps_rect end
    return rects
end
-- dom: this poll's DOM layout; nil reuses the last one (taps, messages: no new DOM query).
local function place_camera(self,dom,force)
    dom=dom or self.dom_cache or dom_layout(self)
    if camera_hud.place(self.camera_hud,fps_area(),camera_blocked(self,dom),fps_place.GAP_CSS_PX*(self.pixel_ratio or 1),dom.seq) or force then
        camera_hud.publish(self.camera_hud,self.pixel_ratio,{used=layout.created+#self.fps_corners,max=MAX_NODES})
    end
end
local function publish_fps_place(self,clear)
    if not html5 then return end
    local s,r=self.fps_setting,self.fps_rect
    self.fps_place_seq=self.fps_place_seq+1
    html5.run("window.riderFpsPlace="..json.encode({seq=self.fps_place_seq,visible=s.visible,x=s.x,y=s.y,
        dragging=self.fps_press and self.fps_press.dragging or false,clear=clear,rect=r,area=self.fps_area_used,
        blocked=self.fps_blocked or {},pixel_ratio=self.pixel_ratio or 1,hit_rect=gui_rect(self.fps_hit)},{encode_empty_table_as_object=false}))
end
-- Move the tap area (and the counter text with it) so its top-left corner is at (left, top) screen pixels.
local function apply_fps(self,left,top,w,h,area,clear)
    local centre=gui.screen_to_local(self.fps_hit,vmath.vector3(left+w/2,top-h/2,0))
    gui.set_position(self.fps_hit,centre)
    gui.set_position(self.metrics[4],centre+self.fps_text_offset)
    self.fps_rect={x0=left,y0=top-h,x1=left+w,y1=top}
    self.fps_area_used=area
    self.fps_placed=true
    gui.set_visible(self.metrics[4],self.fps_setting.visible)
    publish_fps_place(self,clear)
end
-- Place the counter at its stored position for the current screen; only when something changed unless forced.
local function place_fps(self,force)
    local w,h=fps_size(self)
    if not (w>0 and h>0) then return end
    local area,s,blocked=fps_area(),self.fps_setting,self.fps_blocked or {}
    local parts={string.format("%.1f,%.1f,%.1f,%.1f|%.1f,%.1f|%s,%.6f,%.6f",area.x0,area.y0,area.x1,area.y1,w,h,tostring(s.visible),s.x,s.y)}
    for _,b in ipairs(blocked) do parts[#parts+1]=string.format("%.0f,%.0f,%.0f,%.0f",b.x0,b.y0,b.x1,b.y1) end
    local key=table.concat(parts,"|")
    if not force and key==self.fps_place_key then return end
    self.fps_place_key=key
    local left,top=fps_place.to_screen(area,w,h,s.x,s.y)
    local clear
    left,top,clear=fps_place.place(area,w,h,left,top,blocked,fps_place.GAP_CSS_PX*(self.pixel_ratio or 1))
    apply_fps(self,left,top,w,h,area,clear)
end
-- A press on the counter that has not been released yet: a drag past the threshold moves the counter and
-- stores the dropped position; a release without that travel is a tap and switches the cap (#417).
local function fps_pointer(self,id,action)
    local d=self.fps_press
    if action.screen_x then
        local dx,dy=action.screen_x-d.sx,action.screen_y-d.sy
        if not d.dragging and fps_place.is_drag(dx,dy,fps_place.THRESHOLD_CSS_PX*(self.pixel_ratio or 1)) then d.dragging=true end
        if d.dragging then
            local area=fps_area()
            local left,top,clear=fps_place.place(area,d.w,d.h,d.left+dx,d.top+dy,self.fps_blocked or {},fps_place.GAP_CSS_PX*(self.pixel_ratio or 1))
            apply_fps(self,left,top,d.w,d.h,area,clear)
        end
    end
    if id==hash("ui_pointer") and action.released then
        self.fps_press=nil
        if d.dragging then
            local x,y=fps_place.normalise(self.fps_area_used,d.w,d.h,self.fps_rect.x0,self.fps_rect.y1)
            self.fps_setting.x,self.fps_setting.y=x,y
            self.fps_drags=self.fps_drags+1
            msg.post("#script","fps_counter_set",{x=x,y=y})
            publish_fps_place(self,true)
        else msg.post("#script","fps_cap_next") end
        -- A release over a DOM button (Levels, page tools) focuses that button in the engine's mouse-up handler;
        -- give the canvas its keys back, as mobile.js and level_menu.js do after their buttons.
        if html5 then html5.run("document.querySelector('canvas')?.focus()") end
    end
    return true
end
-- An interrupted press (world switch, cleared input, lost release) changes nothing: back to the stored position.
local function cancel_fps_press(self)
    if not self.fps_press then return end
    self.fps_press=nil
    place_fps(self,true)
end
local function cancel_drag(self)
    cancel_fps_press(self)
    if self.controls and self.controls.drag then
        self.controls.drag=nil
        if self.owner then msg.post(self.owner,"ui_capture",{active=self.feedback_open or self.feedback_modal or false}) end
    end
end
local function hud_textures()
    for _,name in ipairs({"dot","speaker","copy"}) do
        local pixels={}
        for y=0,15 do for x=0,15 do
            local on=name=="dot" and ((x-7.5)^2+(y-7.5)^2<42)
                or name=="speaker" and ((x>=2 and x<=5 and y>=5 and y<=10) or (x>=6 and x<=10 and math.abs(y-7.5)<=x-3) or (x>=13 and x<=14 and y>=4 and y<=11))
                or name=="copy" and (((x==3 or x==10) and y>=2 and y<=11) or ((y==2 or y==11) and x>=3 and x<=10) or (x==13 and y>=5 and y<=14) or (y==14 and x>=6 and x<=13))
            pixels[#pixels+1]=on and string.char(255,255,255,255) or string.char(0,0,0,0)
        end end
        assert(gui.new_texture("hud_"..name,16,16,"rgba",table.concat(pixels)),"HUD icon texture unavailable")
    end
end
local function icon(x,y,name,anchor,size)
    local n=layout.box(vmath.vector3(x,y,0),vmath.vector3(size or 14,size or 14,0),anchor)
    gui.set_texture(n,"hud_"..name);return n
end
function init(self)
    layout.init()
    gui.set_safe_area_mode(gui.SAFE_AREA_BOTH)
    -- #678: in HTML5 the play bar (main/game/play_bar.js, editor kit style) replaces the scattered run buttons.
    -- The native top-right group (tuning panel, Record/Replay) starts below its row: about 62 CSS px, i.e. 60
    -- authored units at 960x540 and fewer on larger windows, where the row is relatively smaller.
    if html5 then
        require('main.editor.editor_ui_kit').ensure()
        html5.run(assert(sys.load_resource('/main/game/play_bar.js'),'Missing play bar'))
        self.playbar=true;run_ui.bar=true;require('main.game.progress_ui').bar=true;layout.right_top_inset=60
    end
    feedback.init()
    hud_textures()
    self.station_next=layout.box(vmath.vector3(270,390,0),vmath.vector3(54,24,0),"left_top")
    gui.set_color(self.station_next,vmath.vector4(0.12,0.3,0.3,1))
    self.station_next_label=layout.text(vmath.vector3(270,390,0),"Next","left_top");gui.set_font(self.station_next_label,"default");gui.set_scale(self.station_next_label,vmath.vector3(0.5,0.5,1))
    self.section_next=layout.box(vmath.vector3(374,390,0),vmath.vector3(116,24,0),"left_top")
    gui.set_color(self.section_next,vmath.vector4(0.12,0.3,0.3,1))
    self.section_label=layout.text(vmath.vector3(374,390,0),"Section [V]","left_top")
    gui.set_font(self.section_label,"default");gui.set_scale(self.section_label,vmath.vector3(0.5,0.5,1))
    -- A20 pause and slow motion: two overlay buttons and a centred state line (desktop; touch uses the toolbar).
    self.time_buttons={}
    for _,spec in ipairs({{"pause",482,"Pause [Space]",92},{"step",584,"Speed 1x [X]",100}}) do
        local box=layout.box(vmath.vector3(spec[2],390,0),vmath.vector3(spec[4],24,0),"left_top")
        gui.set_color(box,vmath.vector4(0.12,0.3,0.3,1))
        local label=layout.text(vmath.vector3(spec[2],390,0),spec[3],"left_top")
        gui.set_font(label,"default");gui.set_scale(label,vmath.vector3(0.5,0.5,1))
        self.time_buttons[spec[1]]={box=box,label=label}
    end
    -- A21 record and replay: two overlay buttons and a status line (desktop; touch uses the toolbar).
    self.replay_buttons={}
    for _,spec in ipairs({{"record",694,"Record [B]",84},{"replay",788,"Replay [G]",84}}) do
        local box=layout.box(vmath.vector3(spec[2],390,0),vmath.vector3(spec[4],24,0),"left_top")
        gui.set_color(box,vmath.vector4(0.12,0.3,0.3,1))
        local label=layout.text(vmath.vector3(spec[2],390,0),spec[3],"left_top")
        gui.set_font(label,"default");gui.set_scale(label,vmath.vector3(0.5,0.5,1))
        self.replay_buttons[spec[1]]={box=box,label=label}
    end
    self.replay_line=layout.text(vmath.vector3(240,364,0),"","left_top")
    gui.set_font(self.replay_line,"default");gui.set_pivot(self.replay_line,gui.PIVOT_W);gui.set_scale(self.replay_line,vmath.vector3(0.48,0.48,1))
    gui.set_color(self.replay_line,vmath.vector4(0.6,0.88,1,1))
    self.time_line=layout.text(vmath.vector3(480,460,0),"")
    gui.set_font(self.time_line,"default");gui.set_scale(self.time_line,vmath.vector3(0.7,0.7,1));gui.set_color(self.time_line,vmath.vector4(1,0.85,0.35,1))
    self.time={paused=false,step=1}
    self.debug_clock=html5 and sys.get_engine_info().is_debug and sys.get_config_string("rider.gym_test","")=="a20"
    self.debug_replay=html5 and sys.get_engine_info().is_debug and sys.get_config_string("rider.gym_test","")=="a21"
    self.station=layout.text(vmath.vector3(240,434,0),"Straight | start 0 m/s [1-9]","left_top")
    gui.set_font(self.station,"default");gui.set_pivot(self.station,gui.PIVOT_W);gui.set_scale(self.station,vmath.vector3(0.48,0.48,1))
    self.station_result=layout.text(vmath.vector3(240,414,0),"","left_top")
    gui.set_font(self.station_result,"default");gui.set_pivot(self.station_result,gui.PIVOT_W);gui.set_scale(self.station_result,vmath.vector3(0.48,0.48,1))
    self.tuning_open=false
    self.help=layout.text(vmath.vector3(16,322,0),"W / Up: throttle   S / Down: brake / reverse   A / D: lean\nR: retry   P: preset   T: tuning   H: help   C: crash   M: mute   F: copy\nSpace: pause   X: slow motion 1x / 0.5x / 0.25x   B: record run   G: replay run (ghost)")
    gui.set_font(self.help,"default");gui.set_pivot(self.help,gui.PIVOT_W)
    gui.set_scale(self.help,vmath.vector3(0.5,0.5,1));gui.set_visible(self.help,false)
    self.tuning_button=layout.box(vmath.vector3(922,514,0),vmath.vector3(52,28,0),"right_top")
    self.help_button=layout.box(vmath.vector3(860,514,0),vmath.vector3(52,28,0),"right_top")
    local button_color=vmath.vector4(0.13,0.24,0.28,1)
    gui.set_color(self.tuning_button,button_color);gui.set_color(self.help_button,button_color)
    self.toggle_labels={}
    for _,spec in ipairs({{922,"T"},{860,"H"}}) do
        local n=layout.text(vmath.vector3(spec[1],514,0),spec[2],"right_top")
        gui.set_font(n,"default");gui.set_scale(n,vmath.vector3(0.6,0.6,1));self.toggle_labels[#self.toggle_labels+1]=n
    end
    local sha = sys.get_config_string("rider.source_sha","development")
    local version = layout.text(vmath.vector3(480,20,0),"Build "..string.sub(sha,1,12))
    gui.set_font(version,"default")
    gui.set_scale(version,vmath.vector3(0.4,0.4,1));gui.set_color(version,vmath.vector4(0.55,0.65,0.65,0.7))
    if html5 then html5.run("window.riderBuild = "..json.encode(sha)) end
    msg.post(".","acquire_input_focus")
    local panel_start=#layout.nodes+1
    local panel=layout.box(vmath.vector3(788,294,0),vmath.vector3(304,400,0),"right_top")
    self.tuning_panel=panel
    gui.set_color(panel,vmath.vector4(0.05,0.1,0.13,0.9))
    self.presets={}
    -- One chip per registered preset (feel.order), spread across the same panel row.
    local step=math.floor(294/#feel.order)
    for i,key in ipairs(feel.order) do
        local x=788+math.floor((i-(#feel.order+1)/2)*step)
        local box=layout.box(vmath.vector3(x,475,0),vmath.vector3(step-8,26,0),"right_top")
        local label=layout.text(vmath.vector3(x,475,0),string.upper(key),"right_top")
        gui.set_font(label,"default");gui.set_scale(label,vmath.vector3(0.55,0.55,1))
        self.presets[key]=box
    end
    self.preset_note=layout.text(vmath.vector3(788,449,0),"","right_top")
    gui.set_font(self.preset_note,"default");gui.set_scale(self.preset_note,vmath.vector3(0.4,0.4,1))
    self.crash_button=layout.box(vmath.vector3(716,426,0),vmath.vector3(136,24,0),"right_top")
    gui.set_color(self.crash_button,button_color)
    self.crash_label=layout.text(vmath.vector3(716,426,0),"Crash OFF [C]","right_top")
    gui.set_font(self.crash_label,"default");gui.set_scale(self.crash_label,vmath.vector3(0.5,0.5,1))
    -- Car Feel 3: visual suspension struts on/off (the owner's juice module holds the setting).
    self.struts_button=layout.box(vmath.vector3(860,426,0),vmath.vector3(136,24,0),"right_top")
    gui.set_color(self.struts_button,button_color)
    self.struts_label=layout.text(vmath.vector3(860,426,0),"Struts","right_top")
    gui.set_font(self.struts_label,"default");gui.set_scale(self.struts_label,vmath.vector3(0.5,0.5,1))
    self.head=layout.text(vmath.vector3(788,407,0),"","right_top")
    gui.set_font(self.head,"default");gui.set_scale(self.head,vmath.vector3(0.4,0.4,1))
    self.controls=controls.new()
    self.audio_button=layout.box(vmath.vector3(714,128,0),vmath.vector3(132,24,0),"right_top")
    gui.set_color(self.audio_button,button_color)
    icon(662,128,"speaker","right_top")
    self.audio_label=layout.text(vmath.vector3(726,128,0),"Sound [M]","right_top")
    gui.set_font(self.audio_label,"default");gui.set_scale(self.audio_label,vmath.vector3(0.4,0.4,1))
    self.feedback_button=layout.box(vmath.vector3(862,128,0),vmath.vector3(132,24,0),"right_top")
    gui.set_color(self.feedback_button,button_color)
    icon(810,128,"copy","right_top")
    self.feedback_label=layout.text(vmath.vector3(874,128,0),"Copy [F]","right_top")
    gui.set_font(self.feedback_label,"default");gui.set_scale(self.feedback_label,vmath.vector3(0.4,0.4,1))
    self.panel_nodes={}
    for i=panel_start,#layout.nodes do self.panel_nodes[#self.panel_nodes+1]=layout.nodes[i];gui.set_visible(layout.nodes[i],false) end
    self.report_bg=layout.box(vmath.vector3(480,260,0),vmath.vector3(680,340,0))
    gui.set_color(self.report_bg,vmath.vector4(0.06,0.1,0.13,1));gui.set_enabled(self.report_bg,false)
    self.report=layout.text(vmath.vector3(480,260,0),"")
    gui.set_font(self.report,"default");gui.set_scale(self.report,vmath.vector3(0.55,0.55,1));gui.set_enabled(self.report,false)
    self.graph=graph.new()
    self.metrics = {}
    for i=1,6 do
        local y=({496,477,458,520,0,104})[i]
        local n=layout.text(vmath.vector3(i==6 and 648 or 12,y,0),"",i==6 and "right_top" or "left_top")
        gui.set_font(n,"default");gui.set_pivot(n,gui.PIVOT_W)
        gui.set_scale(n,vmath.vector3(i==4 and 0.6 or 0.48,i==4 and 0.6 or 0.48,1))
        self.metrics[i]=n
    end
    self.contact_dots={icon(32,477,"dot","left_top",6),icon(94,477,"dot","left_top",6)}
    self.contact_labels={}
    for _,x in ipairs({12,74}) do
        local n=layout.text(vmath.vector3(x,477,0),x==12 and "L" or "R","left_top")
        self.contact_labels[#self.contact_labels+1]=n
        gui.set_font(n,"default");gui.set_pivot(n,gui.PIVOT_W);gui.set_scale(n,vmath.vector3(0.48,0.48,1))
    end
    gui.set_visible(self.metrics[5],false);gui.set_visible(self.metrics[6],false)
    -- #417: metrics[4] is the tap-to-switch FPS counter; this transparent box is its tap target. 46 units tall
    -- from the top edge: the update loop scales left_top to at least 1 CSS px per unit, so it is never under the
    -- 44 px touch minimum. It covers only HUD text (counter, speed row), no control. Corner probes measure it.
    self.fps_hit=layout.box(vmath.vector3(56,517,0),vmath.vector3(112,46,0),"left_top")
    gui.set_color(self.fps_hit,vmath.vector4(0,0,0,0))
    self.fps_corners={}
    for i,offset in ipairs({vmath.vector3(-56,23,0),vmath.vector3(56,-23,0)}) do
        local n=gui.new_box_node(offset,vmath.vector3(1,1,0))
        gui.set_parent(n,self.fps_hit,false);gui.set_color(n,vmath.vector4(0,0,0,0));self.fps_corners[i]=n
    end
    self.fps=fps_counter.new();self.fps_cap=fps_counter.DEFAULT_CAP;self.fps_label_until=0;self.fps_seq=0;self.fps_cap_seq=0
    -- #444: the text keeps its offset inside the tap area wherever the area is placed. Hidden until the first
    -- placement, so a stored position never flashes at the default first.
    self.fps_text_offset=gui.get_position(self.metrics[4])-gui.get_position(self.fps_hit)
    self.fps_setting={visible=true,x=fps_place.DEFAULT_X,y=fps_place.DEFAULT_Y}
    self.fps_placed=false;self.fps_place_seq=0;self.fps_pos_seq=0;self.fps_drags=0
    gui.set_visible(self.metrics[4],false)
    self.reason = layout.text(vmath.vector3(480,498,0), "")
    gui.set_font(self.reason,"default");gui.set_scale(self.reason,vmath.vector3(0.55,0.55,1))
    self.run_ui=run_ui.new()
    self.progress_ui=progress_ui.new()
    self.levels_ui=levels_ui.new()
    self.mechanism_text=layout.text(vmath.vector3(480,50,0),'','bottom');gui.set_font(self.mechanism_text,'default');gui.set_scale(self.mechanism_text,vmath.vector3(.75,.75,1));gui.set_visible(self.mechanism_text,false)
    -- #443: camera A/B button and live camera settings panel; shown after its first placement. The debug
    -- ?camera352=a|b measurement route forces the controller's camera mode, so the button (which would store a choice
    -- the camera ignores) is hidden there.
    local forced=html5 and sys.get_engine_info().is_debug and html5.run("new URLSearchParams(location.search).get('camera352') || ''") or ""
    self.camera_hud=camera_hud.new((forced=="a" or forced=="b") and forced or nil)
    if html5 then html5.run(HUD_LAYOUT) end
end
-- #417: colour relative to the cap (Unlimited against 60); neutral while no reading or the cap label shows.
local function fps_color(fps,cap)
    local level=fps_counter.level(fps,cap)
    local c=level and fps_counter.COLORS[level]
    return c and vmath.vector4(c[1],c[2],c[3],1) or vmath.vector4(0.86,0.95,0.91,1),level
end
local function show_fps(self,now)
    local label=now<self.fps_label_until
    self.fps_label_shown=label
    local fps=self.fps.fps
    local color,level=fps_color(not label and fps,self.fps_cap)
    gui.set_text(self.metrics[4],label and fps_counter.label(self.fps_cap) or fps_counter.text(fps))
    gui.set_color(self.metrics[4],color)
    self.fps_seq=self.fps_seq+1
    if html5 then
        html5.run("window.riderFpsCounter="..json.encode({seq=self.fps_seq,cap_seq=self.fps_cap_seq,cap=self.fps_cap,fps=fps,
            text=gui.get_text(self.metrics[4]),level=level or false,label=label,buckets=#self.fps.buckets,saved=self.fps_saved or false,
            status=self.fps_status or false,color={color.x,color.y,color.z},visible=self.fps_setting.visible,x=self.fps_setting.x,y=self.fps_setting.y,
            pos_seq=self.fps_pos_seq,pos_saved=self.fps_pos_saved or false,pos_status=self.fps_pos_status or false,drags=self.fps_drags}))
    end
end
local function toggle_tuning(self)
    cancel_drag(self)
    if mobile.enabled() then html5.run("window.riderMobile.toggleDetails()") else self.tuning_open=not self.tuning_open end
end
local function toggle_help(self)
    self.help_open=not self.help_open;gui.set_visible(self.help,self.help_open)

end
function on_message(self,id,data,sender)
    if id==hash('mechanism_state') then if data.generation<(self.session_generation or 1) then return end;self.mechanism_status=data.text;gui.set_text(self.mechanism_text,data.text);gui.set_visible(self.mechanism_text,not mobile.enabled());return end
    if id==hash('fuel_state') then
        if data.generation<(self.session_generation or 1) then return end
        local old=self.fuel_data
        if old and old.generation==data.generation and old.attempt>data.attempt then return end
        if not old or old.generation~=data.generation or old.attempt~=data.attempt then self.fuel_flash=0
        elseif data.collected>old.collected then self.fuel_flash=.8;self.fuel_gain=data.feedback end
        self.fuel_data=data;return
    end
    if id==hash('coin_state') then
        if data.generation<(self.session_generation or 1) then return end
        local old=self.coin_data
        if old and old.generation==data.generation and old.attempt>data.attempt then return end
        if not old or old.generation~=data.generation or old.attempt~=data.attempt then self.coin_flash=0 end
        self.coin_data=data;if data.feedback>0 then self.coin_flash=.5;self.coin_flash_amount=data.feedback end;return
    elseif id==hash('coin_bank_state') then self.coin_bank_data=data;return end
    if id==hash("course_progress") then
        if data.generation<(self.session_generation or 1) then return end
        local old=self.progress_ui.data
        if old and old.generation==data.generation and old.attempt>data.attempt then return end
        progress_ui.show(self.progress_ui,data,mobile.enabled())
        if html5 then html5.run("window.riderProgress="..json.encode(data)..";window.riderProgressUI="..json.encode(progress_ui.geometry(self.progress_ui))) end
        return
    end
    if id==hash("run_state") then
        if data.generation<(self.session_generation or 1) then return end
        run_ui.show(self.run_ui,data,mobile.enabled())
        if html5 then html5.run("window.riderRun="..json.encode(data)..";window.riderRunUI="..json.encode(run_ui.geometry(self.run_ui))) end
        return
    elseif id==hash("station_loading") then self.fuel_data=nil;self.fuel_flash=0;self.coin_data=nil;self.coin_flash=0;run_ui.show(self.run_ui,nil);progress_ui.show(self.progress_ui,nil,false);if html5 then html5.run("window.riderRun=null;window.riderProgress=null") end end
    if id==hash("station_loading") then
        -- A new world starts uncaptured; re-send an open modal once it reports measurements.
        self.mechanism_status=nil;gui.set_visible(self.mechanism_text,false);if html5 then html5.run('window.riderMechanisms=null') end
        self.session_generation=data.generation;self.latest=nil;self.station_error=nil;self.custom_status=nil;self.feedback_modal=false;self.load_timing=nil
        if html5 then html5.run("window.riderStationError=null;window.riderCustomStatus=null") end
        cancel_drag(self);gui.set_text(self.station,"Loading station...");gui.set_color(self.station,vmath.vector4(1,1,1,1))
    elseif id==hash("station_error") then
        if html5 then html5.run("window.riderStationError="..json.encode(data.note)) end
        self.station_error=data.note
        gui.set_text(self.station,data.note);gui.set_color(self.station,vmath.vector4(1,0.3,0.2,1))
    elseif id==hash("load_timing") and data.generation==(self.session_generation or 1) then
        self.load_timing=data
        if html5 then html5.run("window.riderLoad="..json.encode(data)) end
    elseif id==hash("custom_status") then
        self.custom_status=data.text
        if html5 then html5.run("window.riderCustomStatus="..json.encode(data.text)) end
    elseif id==hash("hud_probe") then
        assert(sys.get_engine_info().is_debug,"HUD probe requires debug engine")
        -- Colour the live counter node for a given reading and cap, read it back from the node.
        local color,level=fps_color(data.fps,data.cap)
        gui.set_color(self.metrics[4],color)
        local c=gui.get_color(self.metrics[4])
        msg.post(sender,"hud_probe_result",{fps=data.fps,cap=data.cap,level=level,r=c.x,g=c.y,b=c.z})
    elseif id==hash("fps_cap") then
        -- The loader applied (and stored) this cap; measure only the new cadence from here on.
        self.fps_cap,self.fps_saved,self.fps_status=data.cap,data.saved,data.status
        self.fps_cap_seq=self.fps_cap_seq+1
        fps_counter.restart(self.fps)
        if data.changed then self.fps_label_until=socket.gettime()+fps_counter.LABEL_S end
        show_fps(self,socket.gettime())
    elseif id==hash("fps_counter") then
        -- #444: the loader applied (and stored) ON/OFF and the normalised position.
        self.fps_setting={visible=data.visible,x=data.x,y=data.y}
        self.fps_pos_saved,self.fps_pos_status=data.saved,data.status
        self.fps_pos_seq=self.fps_pos_seq+1
        if not self.fps_setting.visible then cancel_fps_press(self) end
        if not self.fps_press then self.fps_blocked=fps_blocked(self);place_fps(self,true) end -- a running drag keeps its place until its own release
        show_fps(self,socket.gettime())
        if html5 then html5.run("window.riderLevelMenu?.setFps?.("..json.encode({visible=data.visible,x=data.x,y=data.y,preset=fps_place.preset_of(data.x,data.y) or false})..")") end
    elseif id==hash("camera_settings") then
        -- #443: the loader applied (and stored) the camera choice and settings; the controller got the same.
        camera_hud.settings(self.camera_hud,data)
        if self.camera_hud.placed then place_camera(self,nil,true) end
    elseif id==hash("cancel_drag") then cancel_drag(self)
    elseif id==hash("graph") then
        graph.draw(self.graph,data)
        msg.post(sender,"graph_shown",{series=data.series,peak=data.peak,positive_peak=data.positive_peak,generation=data.generation})
    elseif id==hash("preset") then
        self.owner=sender
        self.preset,self.modified=data.key,data.modified
        for key,box in pairs(self.presets) do
            gui.set_color(box,key==data.key and vmath.vector4(0.15,0.5,0.45,1) or vmath.vector4(0.13,0.24,0.28,1))
        end
        -- A refused preset file must never pass silently for A (#199).
        gui.set_text(self.preset_note,data.refused and ("Preset "..data.refused.." - using A"..(data.modified and " | Modified" or "")) or data.invalid and "Invalid URL: A"
            -- #114 debug wheel candidates (debug engine only): their wheels stay until the page is reloaded.
            or data.candidate and string.format("Debug %s: A + %.2f m wheels%s%s",string.upper(data.key),feel.geometry_of(data.key).radius_m,
                data.modified and " | Modified" or "",data.switch_refused and " | reload to change" or "")
            or data.modified and "Modified - select "..string.upper(table.concat(feel.order,"/")) or "Presets [P]")
    elseif id==hash("tuning") then
        self.owner=sender
        self.tuning=data
        controls.sync(self.controls,data)
    elseif id==hash("measurements") then
        if data.session_generation and data.session_generation<(self.session_generation or 1) then return end
        self.owner=sender
        self.latest=data
        local note=self.station_error or data.station_note or ""
        if data.custom then note=note..(note~="" and " | " or "")..(self.custom_status or "Saved level") end
        gui.set_text(self.station,string.format("%s | start %.1f m/s [1-9] %s",data.station_name or "Straight",data.start_speed or 0,note))
        gui.set_text(self.station_result,data.station_result or string.format("x %.1f m | top %.1f m/s | brake %.1f m",data.station_distance or 0,data.station_top_speed or 0,data.station_brake_distance or 0))
        self.report_text=feedback.report(data,self.preset,self.modified,self.tuning,self.load_timing)
        feedback.update(self.report_text)
        gui.set_text(self.audio_label,data.audio_muted and "Muted [M]" or data.audio_started and string.format("%.2fx [M]",data.audio_pitch) or "[M]")
        if html5 then
            html5.run("window.riderTelemetry = "..json.encode(data))
            html5.run("window.riderControls = "..json.encode(controls.geometry(self.controls)))
            html5.run("window.riderDragging = "..tostring(self.controls.drag~=nil))
        end
        gui.set_text(self.crash_label,"Crash "..(data.crash_enabled and "ON" or "OFF").." [C]")
        gui.set_text(self.head,"Head: "..tostring(data.head_contact))
        for i,n in ipairs(self.contact_dots) do
            gui.set_color(n,(i==1 and data.contact1 or i==2 and data.contact2) and vmath.vector4(0.3,0.9,0.6,1) or vmath.vector4(0.4,0.45,0.5,1))
        end
        local b=telemetry.budget
        local values={
            string.format("%.2f m/s | %.1f km/h",feel.metres(data.speed),feel.metres(data.speed)*3.6),
            "",
            string.format("L %+.1f   R %+.1f u",data.travel1,data.travel2),
            false, -- metrics[4] is the FPS counter (#417): it shows its own measured cadence, not this telemetry value
            string.format("Frame %.2f ms / %.2f (mean)",data.frame_ms,b.frame_ms_max),
            string.format("Physics %.3f ms / %s",data.physics_ms,b.physics_ms_max and tostring(b.physics_ms_max) or "unset")}
        for i=1,#self.metrics do
            local text=values[i]
            if text then
                local over = i==5 and telemetry.over(data.frame_ms,b.frame_ms_max)
                    or i==6 and telemetry.over(data.physics_ms,b.physics_ms_max)
                gui.set_text(self.metrics[i],text)
                gui.set_color(self.metrics[i],over and vmath.vector4(1,0.25,0.25,1) or vmath.vector4(0.86,0.95,0.91,1))
            end
        end
        msg.post(sender,"measurements_shown",{fps=data.fps,speed=data.speed,physics_ms=data.physics_ms,
            contact1=data.contact1,contact2=data.contact2,head_contact=data.head_contact,crash_enabled=data.crash_enabled,preset=data.preset,modified=data.modified,travel1=data.travel1,travel2=data.travel2,
            preset_note=gui.get_text(self.preset_note),report_preset=self.report_text and string.match(self.report_text,"%- Preset: [^\n]*")})
    elseif id==hash("editor_mode") then
        -- The level editor draws its own panels; the driving HUD stays hidden while editing.
        for _,root in pairs(layout.roots) do gui.set_enabled(root,not data.active) end
        self.editing=data.active
        if data.active then camera_hud.close(self.camera_hud) end
        cancel_drag(self)
    elseif id==hash("time_state") then
        self.time={paused=data.paused,step=data.step}
        local step=data.step==1 and "1x" or tostring(data.step).."x"
        gui.set_text(self.time_buttons.pause.label,data.paused and "Resume [Space]" or "Pause [Space]")
        gui.set_text(self.time_buttons.step.label,"Speed "..step.." [X]")
        gui.set_text(self.time_line,data.paused and "PAUSED [Space]" or data.step~=1 and "Slow motion "..step.." - values not comparable" or "")
        if html5 then
            html5.run("window.riderTimeState="..json.encode({paused=data.paused,step=data.step}))
            html5.run("window.riderMobile?.setTime?.("..tostring(data.paused)..","..data.step..")")
        end
    elseif id==hash("struts") then gui.set_text(self.struts_label,"Struts "..(data.enabled and "ON" or "OFF"))
    elseif id==hash("replay_state") then
        gui.set_text(self.replay_line,data.text)
        if html5 then html5.run("window.riderMobile?.setReplay?.("..json.encode(data.text)..")") end
    elseif id==hash("finish_reached") then
        self.toast_time=3;gui.set_visible(self.reason,not mobile.enabled())
        gui.set_text(self.reason,string.format("Finish reached %.2f s",data.time)..(data.time_scaled and " (slow motion: not comparable)" or "")..(data.has_coins and (" | Coins "..data.coins..(self.run_ui.data and "" or " (practice)")) or ""))
        if mobile.enabled() then html5.run("window.riderMobile.toast("..json.encode(gui.get_text(self.reason))..")") end
    elseif id==hash("retry_done") then
        self.toast_time=1.5;gui.set_visible(self.reason,not mobile.enabled())
        gui.set_text(self.reason,data.reason=="bounds" and "Retry: outside practice area" or data.reason=="head" and "Retry: head contact" or data.reason=="preset" and "Retry: preset changed" or data.reason=="record" and "Retry: recording from the start"
            or data.reason=="replay" and "Retry: replay from the start" or "Retry: manual")
        if mobile.enabled() then html5.run("window.riderMobile.toast("..json.encode(gui.get_text(self.reason))..")") end
        msg.post(sender,"retry_labelled",{reason=data.reason})
    end
end

local function copy_feedback(self)
    if self.owner then msg.post(self.owner,"clear_input") end
    if html5 then feedback.copy()
    else
        self.feedback_open=not self.feedback_open
        gui.set_text(self.report,self.report_text or "Waiting for measurements")
        gui.set_enabled(self.report_bg,self.feedback_open);gui.set_enabled(self.report,self.feedback_open)
        gui.set_text(self.feedback_label,"Clipboard unavailable; F closes report")
        if self.owner then msg.post(self.owner,"ui_capture",{active=self.feedback_open}) end
    end
end
function update(self,dt)
    levels_ui.update(self.levels_ui)
    -- #678: the HTML5 play bar: render its state and run its queued commands through the existing owners.
    if self.playbar then
        html5.run('window.riderPlayBar.render()')
        local text=html5.run('window.riderPlayBar.take()')
        if text~='[]' then
            local ok,list=pcall(json.decode,text)
            for _,a in ipairs(ok and type(list)=='table' and list or {}) do
                if a=='tuning' then toggle_tuning(self) elseif a=='help' then toggle_help(self)
                elseif a=='3d' then
                    -- The 3D button toggles: a second press closes the open 3D look (like its Close).
                    local look=require('main.editor.editor_look')
                    if look.session and look.session.open then look.confirm();look.close() else msg.post('main:/loader#script','terrain_look_open') end
                elseif a=='edit' then msg.post('main:/loader#script','editor_enter')
                -- #678 slice 3: the debug group (desktop), the same messages as the native buttons it replaces.
                elseif a=='step' then msg.post("main:/loader#script","time_control",{action="step"})
                elseif (a=='record' or a=='replay') and self.owner then msg.post(self.owner,"replay_control",{action=a})
                elseif a=='next_section' and self.owner then msg.post(self.owner,"next_section")
                elseif a=='station_next' and self.latest and not self.run_ui.data then
                    local index=1;for i,key in ipairs(stations.ids) do if key==self.latest.station then index=i end end
                    msg.post("main:/loader#script","select_station",{id=stations.ids[index%#stations.ids+1],preset=self.preset or "a"}) end
            end
        end
    end
    -- #417: one engine frame per update(); wall time keeps the reading honest under any cap.
    local now=socket.gettime()
    if fps_counter.frame(self.fps,now) or self.fps_label_shown and now>=self.fps_label_until then show_fps(self,now) end
    local enabled=mobile.enabled()
    gui.set_visible(self.section_next,not enabled and self.latest and (self.latest.section_count or 0)>1 or false)
    gui.set_visible(self.section_label,not enabled and self.latest and (self.latest.section_count or 0)>1 or false)
    for _,node in ipairs({self.station,self.station_result,self.station_next,self.station_next_label,self.time_line,self.replay_line}) do gui.set_visible(node,not enabled) end
    for _,b in pairs(self.time_buttons) do gui.set_visible(b.box,not enabled);gui.set_visible(b.label,not enabled) end
    -- The open tuning panel can cover the Record/Replay buttons on small views: hide them then (B/G still work).
    for _,b in pairs(self.replay_buttons) do gui.set_visible(b.box,not enabled and not self.panel_open);gui.set_visible(b.label,not enabled and not self.panel_open) end
    if self.debug_clock then
        -- A20 only: unscaled engine time (this collection is not time-scaled) next to the wall clock.
        self.engine_time,self.engine_frames=(self.engine_time or 0)+dt,(self.engine_frames or 0)+1
        -- The editor camera (shared module state, read only) shows whether Edit mode received Space+drag.
        local editor=require "main.editor.editor"
        html5.run("window.riderClock="..json.encode({engine=self.engine_time,frames=self.engine_frames,wall=socket.gettime(),
            editor_camera={x=editor.camera.x,y=editor.camera.y}}))
        -- Debug burst: several time requests posted in one frame (stale-acknowledgement check).
        local ok,burst=pcall(json.decode,html5.run("(()=>{const b=window.riderDebugTimeBurst;window.riderDebugTimeBurst=null;return JSON.stringify(b||null)})()"))
        if ok and type(burst)=="table" then for _,a in ipairs(burst) do msg.post("main:/loader#script","time_control",{action=a}) end end
    end
    if self.debug_replay then
        -- A21 only: editor mode/grid (shared module state, read only) prove B/G never touch the editor in Play and G
        -- stays the grid key in Edit mode.
        local editor=require "main.editor.editor"
        local e=editor.doc and editor.doc.editor
        html5.run("window.riderReplayEditor="..json.encode({mode=editor.mode,grid=editor.grid,revision=e and e.revision or -1,
            undo=editor.history and #editor.history.undo or 0,toast=gui.get_text(self.reason),line=gui.get_text(self.replay_line)}))
    end
    self.toast_time=math.max(0,(self.toast_time or 0)-dt)
    gui.set_visible(self.reason,self.toast_time>0 and not enabled and not self.run_ui.data)
    -- #678: in HTML5 the play bar has Tuning, Help and Pause.
    gui.set_visible(self.tuning_button,not enabled and not self.playbar);gui.set_visible(self.help_button,not enabled and not self.playbar)
    for _,n in ipairs(self.toggle_labels) do gui.set_visible(n,not enabled and not self.playbar) end
    if self.playbar then
        -- #678: the play bar has Pause; its debug group has Speed, Record, Replay, Next station and Section.
        for _,n in ipairs({self.time_buttons.pause.box,self.time_buttons.pause.label,self.time_buttons.step.box,self.time_buttons.step.label,
            self.replay_buttons.record.box,self.replay_buttons.record.label,self.replay_buttons.replay.box,self.replay_buttons.replay.label,
            self.station_next,self.station_next_label,self.section_next,self.section_label}) do gui.set_visible(n,false) end
    end
    if self.run_ui.data then
        run_ui.show(self.run_ui,self.run_ui.data,mobile.enabled())
        gui.set_visible(self.time_line,false)
        gui.set_visible(self.station_result,false);gui.set_visible(self.replay_line,false)
        for _,b in pairs(self.replay_buttons) do gui.set_visible(b.box,false);gui.set_visible(b.label,false) end
        gui.set_visible(self.time_buttons.step.box,false);gui.set_visible(self.time_buttons.step.label,false)
        gui.set_visible(self.station_next,false);gui.set_visible(self.station_next_label,false)
        local terminal=self.run_ui.data.state=='finished' or self.run_ui.data.state=='failed'
        if terminal then gui.set_visible(self.time_buttons.pause.box,false);gui.set_visible(self.time_buttons.pause.label,false) end
    end
    if self.playbar then
        -- #678 slice 3b: on desktop the play bar's debug card shows these readouts; the native texts stay the fallback.
        -- Stays after the station/result/replay visibility rules above: it reads what they set this frame.
        local card=false
        if not enabled and not self.editing then
            local function line(n) return gui.get_visible(n) and gui.get_text(n)~="" and gui.get_text(n) or nil end
            local t=self.latest or {}
            card={speed=gui.get_text(self.metrics[1]),travel=t.travel1 and string.format("%+.1f / %+.1f u",t.travel1,t.travel2) or "",
                contact={t.contact1==true,t.contact2==true},station=line(self.station),result=line(self.station_result),replay=line(self.replay_line)}
        end
        for _,n in ipairs({self.metrics[1],self.metrics[3],self.contact_dots[1],self.contact_dots[2],self.contact_labels[1],self.contact_labels[2]}) do gui.set_visible(n,card==false) end
        for _,n in ipairs({self.station,self.station_result,self.replay_line}) do if card then gui.set_visible(n,false) end end
        local encoded=json.encode(card)
        if encoded~=self.card_published then self.card_published=encoded;html5.run('window.riderDebugCard='..encoded) end
    end
    self.fuel_flash=math.max(0,(self.fuel_flash or 0)-dt)
    run_ui.show_fuel(self.run_ui,self.fuel_data,enabled,self.fuel_flash>0 and self.fuel_gain or nil)
    if html5 then
        local d=self.fuel_data;local encoded=json.encode(d)
        if self.fuel_published~=encoded then self.fuel_published=encoded;html5.run('window.riderFuel='..encoded) end
        -- #678: the refill gain while it flashes, for the play bar's strip.
        local gain=self.fuel_flash>0 and self.fuel_gain or false
        if self.fuel_gain_published~=gain then self.fuel_gain_published=gain;html5.run('window.riderFuelGain='..json.encode(gain)) end
    end
    self.coin_flash=math.max(0,(self.coin_flash or 0)-dt)
    run_ui.show_coins(self.run_ui,self.coin_data,self.coin_bank_data,enabled,self.coin_flash>0 and (self.coin_flash_amount or 1) or false)
    if html5 then
        local c,b=self.coin_data,self.coin_bank_data
        local published=c and {count=c.count,total=c.total,practice=c.practice,finished=c.finished,flash=self.coin_flash>0 and (self.coin_flash_amount or 1) or 0,gems=c.gems,gem_total=c.gem_total,gem_bank=b and b.gems or 0,gem_earned=b and b.course_gems or 0,bank=b and b.total or 0,save=b and b.status or 'Checking storage'} or nil
        local encoded=json.encode(published)
        if encoded~=self.coin_published then
            self.coin_published=encoded;html5.run('window.riderCoins='..encoded..';window.riderRunUI='..json.encode(run_ui.geometry(self.run_ui)))
        end
    end
    if self.progress_ui.data and self.progress_ui.data.enabled then gui.set_visible(self.time_line,false) end
    local compact=mobile.compact()
    self.compact=compact
    local open=mobile.enabled() and not compact or self.tuning_open
    if open~=self.panel_open then
        if html5 then html5.run("document.body.classList.toggle('rider-tuning',"..tostring(open)..")") end
        if not open then cancel_drag(self) end
        self.panel_open=open
        for _,node in ipairs(self.panel_nodes) do gui.set_visible(node,open) end
        gui.set_visible(self.metrics[6],open)
    end
    -- #443: a resized touch status line re-places the camera control this frame (one counter read, no layout query).
    if html5 and enabled then
        local seq=tonumber(html5.run("window.riderHudLayout?window.riderHudLayout.watch():0"))
        if seq~=self.hud_layout_seq then self.hud_layout_seq=seq;self.feedback_poll=math.max(self.feedback_poll or 0,0.1) end
    end
    self.feedback_poll=(self.feedback_poll or 0)+dt
    if self.feedback_poll<0.1 then return end
    self.feedback_poll=0
    local pixel_ratio=html5 and tonumber(html5.run("document.querySelector('canvas').width / document.querySelector('canvas').getBoundingClientRect().width")) or 1
    local unit=math.abs(gui.get_screen_position(self.graph.probe).x-gui.get_screen_position(self.graph.origin).x)
    local root=layout.roots.left_top
    local base=unit/math.max(0.01,pixel_ratio or 1)/gui.get_scale(root).x
    local panel_scale=math.max(1,1/math.max(0.01,base))
    -- Small/portrait FIT views still need a usable editor and a legible graph.
    gui.set_scale(root,vmath.vector3(panel_scale,panel_scale,1))
    local height=html5 and tonumber(html5.run("innerHeight")) or 540
    local bottom=html5 and not enabled and 52 or 16
    -- The group's inset below the play bar (#678, unscaled authored units) also takes room from the panel's height.
    local editor_scale=math.min(panel_scale,math.max(0.1,(((height or 540)-bottom)/base-(layout.right_top_inset or 0))/446))
    gui.set_scale(layout.roots.right_top,vmath.vector3(editor_scale,editor_scale,1))
    layout.readable(base)
    -- #444: re-place the counter when the screen, its size, the controls or the setting changed (not mid-drag).
    self.pixel_ratio=pixel_ratio or 1
    local dom=dom_layout(self)
    if not self.fps_press then self.fps_blocked=fps_blocked(self,dom.controls);place_fps(self) end
    -- #443: the camera control (and its open panel) after the counter, clear of it and of every other control.
    place_camera(self,dom)
    local narrow=html5 and tonumber(html5.run("innerWidth"))<520
    graph.visible(self.graph,not self.run_ui.data and not (open and narrow))
    if html5 then
        local function point(n)
            local p=gui.get_screen_position(n);return {x=p.x,y=p.y}
        end
        local c=gui.get_color(self.metrics[4])
        html5.run("window.riderCompact = "..tostring(compact))
        html5.run("window.riderHud = "..json.encode({tuning=open,help=self.help_open or false,fps_color={c.x,c.y,c.z},crash=point(self.crash_button),presets=(function() local r={};for key,box in pairs(self.presets) do r[key]=point(box) end;return r end)(),
            pause=not self.playbar and point(self.time_buttons.pause.box) or nil,step=not self.playbar and point(self.time_buttons.step.box) or nil,struts=point(self.struts_button),struts_label=gui.get_text(self.struts_label),preset_note=gui.get_text(self.preset_note),
            record=not self.playbar and point(self.replay_buttons.record.box) or nil,replay=not self.playbar and point(self.replay_buttons.replay.box) or nil,fps=point(self.fps_hit),
            fps_rect={top_left=point(self.fps_corners[1]),bottom_right=point(self.fps_corners[2])}}))
    end
    if html5 then
        local status,visible=feedback.state()
        -- The custom import panel captures input like the feedback fallback.
        local modal=visible or html5.run("!!window.riderCustom?.visible")=="true"
        gui.set_text(self.feedback_label,"Copy [F]")
        if self.owner and self.latest then
            if status~=self.last_feedback_status or visible~=self.feedback_visible then
                self.last_feedback_status,self.feedback_visible=status,visible
                msg.post(self.owner,"feedback_status",{status=status,visible=visible})
            end
            if modal~=self.feedback_modal then
                self.feedback_modal=modal
                msg.post(self.owner,"ui_capture",{active=modal})
            end
        end
    end
end
function on_input(self,id,action)
    -- #444: while a press on the counter is held, pointer moves and the release belong to it (never to driving).
    if self.fps_press and (id==nil or id==hash("ui_pointer")) then
        if id==hash("ui_pointer") and action.pressed then cancel_fps_press(self) -- its release was lost
        else return fps_pointer(self,id,action) end
    end
    if levels_ui.input(self.levels_ui,id,action) then return true end
    if not self.feedback_modal and run_ui.input(self.run_ui,id,action,self.owner) then return true end
    if id==hash("ui_pointer") and action.pressed and self.latest and (self.latest.section_count or 0)>1 and gui.get_visible(self.section_next) and gui.pick_node(self.section_next,action.x,action.y) then
        msg.post(self.owner,"next_section");return true
    end
    if id==hash("ui_pointer") and action.pressed and self.latest and not self.run_ui.data and gui.get_visible(self.station_next) and gui.pick_node(self.station_next,action.x,action.y) then
        local index=1;for i,key in ipairs(stations.ids) do if key==self.latest.station then index=i end end
        msg.post("main:/loader#script","select_station",{id=stations.ids[index%#stations.ids+1],preset=self.preset or "a"})
        return true
    end
    if id==hash("feedback") and action.pressed then
        if html5 then if self.owner then msg.post(self.owner,"clear_input") end else copy_feedback(self) end
        return true
    end
    if self.feedback_open or self.feedback_modal then return true end
    -- #443: a press on the camera control or its open panel is consumed here (never drive input). Hidden while
    -- editing (pick_node ignores the disabled roots).
    if not self.editing and camera_hud.input(self.camera_hud,id,action) then
        place_camera(self,nil,true)
        return true
    end
    -- #417/#444: a press on the FPS counter is consumed here (hidden while editing or switched off; pick_node
    -- ignores enabled and visible state). Its release decides: a tap switches the cap, a drag moves the counter.
    -- Drive input is keyboard or the DOM touch zones, never this node.
    if id==hash("ui_pointer") and action.pressed and not self.editing and self.fps_placed and self.fps_setting.visible
        and gui.pick_node(self.fps_hit,action.x,action.y) then
        local r=self.fps_rect
        self.fps_press={sx=action.screen_x,sy=action.screen_y,left=r.x0,top=r.y1,w=r.x1-r.x0,h=r.y1-r.y0,dragging=false}
        return true
    end
    if id==hash("pause_toggle") and action.pressed then msg.post("main:/loader#script","time_control",{action="pause"});return true end
    if id==hash("time_step") and action.pressed then msg.post("main:/loader#script","time_control",{action="step"});return true end
    if not mobile.enabled() and id==hash("ui_pointer") and action.pressed then
        for name,b in pairs(self.time_buttons) do
            -- pick_node ignores visibility: a button hidden for the play bar (#678) must not answer.
            if gui.get_visible(b.box) and gui.pick_node(b.box,action.x,action.y) then msg.post("main:/loader#script","time_control",{action=name});return true end
        end
        for name,b in pairs(self.replay_buttons) do
            if not self.panel_open and gui.get_visible(b.box) and gui.pick_node(b.box,action.x,action.y) and self.owner then msg.post(self.owner,"replay_control",{action=name});return true end
        end
    end
    if id==hash("tuning_toggle") and action.pressed then toggle_tuning(self);return true end
    if id==hash("help_toggle") and action.pressed then toggle_help(self);return true end
    if not mobile.enabled() and not self.playbar and id==hash("ui_pointer") and action.pressed then
        if gui.pick_node(self.tuning_button,action.x,action.y) then toggle_tuning(self);return true end
        if gui.pick_node(self.help_button,action.x,action.y) then toggle_help(self);return true end
    end
    if not self.panel_open then return end
    if id==hash("ui_pointer") and action.pressed and gui.pick_node(self.feedback_button,action.x,action.y) then copy_feedback(self);return true end
    if controls.input(self.controls,id,action,self.owner) then return true end
    if id==hash("ui_pointer") and action.pressed and gui.pick_node(self.audio_button,action.x,action.y) then msg.post(self.owner,"audio_mute");return true end
    if id==hash("ui_pointer") and action.pressed then
        for key,box in pairs(self.presets) do
            if gui.pick_node(box,action.x,action.y) then msg.post(self.owner,"select_preset",{key=key});return true end
        end
    end
    if id==hash("ui_pointer") and action.pressed and gui.pick_node(self.crash_button,action.x,action.y) then
        msg.post("gym:/owner#script","crash_toggle")
        return true
    end
    if id==hash("ui_pointer") and action.pressed and gui.pick_node(self.struts_button,action.x,action.y) then
        msg.post("gym:/owner#script","struts_toggle")
        return true
    end
end

-- Opt-in #516 measurements; no input owner or layout schedule changes.
if sys.get_engine_info().is_debug then
    local callbacks=require('main.gym.publication_probe516').group({['hud.update']=update,['hud.on_message']=on_message},
        {dom_rects,dom_layout,show_fps,publish_fps_place})
    update,on_message=callbacks['hud.update'],callbacks['hud.on_message']
end
