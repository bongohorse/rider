#version 140
in highp vec3 position;
in lowp vec4 color;
in highp vec2 texcoord0;
out lowp vec4 var_color;
out highp vec2 var_uv;
uniform vs_uniforms { highp mat4 world_view_proj; };
void main() {
    // Shallow visual extrusion only. Camera and 2D collision coordinates stay unchanged.
    vec3 p = position;
    p.xy += p.z * vec2(0.18, 0.55);
    p.z = 0.0;
    gl_Position = world_view_proj * vec4(p, 1.0);
    var_color = color;
    var_uv = texcoord0;
}
