-- Dedicated G2 fixture; no dependency on G1 timing or global mutable state.
local function publish(self)
    automation_bridge.publish("rider.bridge", {
        count=self.count,run_id=self.run_id,
        source_sha=sys.get_config_string("rider.source_sha","missing"),
        engine_sha=sys.get_engine_info().version_sha1,
        ready=true
    })
end
function init(self)
    self.run_id=sys.get_config_string("rider.run_id","missing")
    self.count=0
    local title=gui.new_text_node(vmath.vector3(480,380,0),"Bridge Smoke")
    gui.set_font(title,"default");gui.set_id(title,"bridge_title")
    self.box=gui.new_box_node(vmath.vector3(480,260,0),vmath.vector3(320,110,0))
    gui.set_color(self.box,vmath.vector4(0.15,0.35,0.8,1));gui.set_id(self.box,"activate")
    self.label=gui.new_text_node(vmath.vector3(480,260,0),"Count: 0")
    gui.set_font(self.label,"default");gui.set_id(self.label,"counter")
    if sys.get_config_string("rider.bridge_mode","debug")=="release" then
        local absent=type(automation_bridge)=="nil"
        print("RIDER_RELEASE "..json.encode({run_id=self.run_id,module_absent=absent,ready=true,engine=sys.get_engine_info()}))
        assert(absent,"Debug automation Lua module leaked into release")
        -- Runner also checks the HTTP route while this process is known alive.
        return
    end
    assert(type(automation_bridge)=="table","Bridge debug Lua module missing")
    msg.post(".","acquire_input_focus")
    publish(self)
    print("RIDER_BRIDGE_READY "..json.encode({run_id=self.run_id,source_sha=sys.get_config_string("rider.source_sha","missing")}))
end
function on_input(self,action_id,action)
    if action_id==hash("activate") and action.pressed then
        self.count=self.count+1
        gui.set_text(self.label,"Count: "..self.count)
        gui.set_color(self.box,vmath.vector4(0.1,0.7,0.35,1))
        publish(self)
        return true
    end
end
