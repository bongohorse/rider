#version 140
in highp vec3 position;
in lowp vec4 color;
in highp vec2 texcoord0;
in highp vec3 look_data;
in highp float texture_slot; // face, constant per triangle
out lowp vec4 var_color;
out highp vec3 var_uv; // along the track, Surface across (back edge 0), face
out lowp float var_flipped; // 1 when this face's winding is reversed
out highp vec4 var_side; // metres below the line, slope factor, Fill UV in world space
uniform vs_uniforms {
    highp mat4 world_view_proj;
    highp vec4 editor_params;
    highp vec4 look_origin; // world origin m, local floor m, engine-to-metres scale
    highp vec4 look_shape; // width m, reciprocal focal contribution, side depth m, shading
    highp vec4 look_camera; // unchanged camera XY m, view shear XY
};
void main() {
    vec3 p=position;
    float s=look_origin.w;
    float depth=p.z>0.0?p.z*s/0.9*look_shape.x:0.0;
    if(p.z<0.0) {
        depth=max(0.0,-p.z*s-0.9)/0.9*look_shape.x;
        if(look_data.z>1.5) { /* source-authored bottom already baked */ }
        else if(look_data.z>0.5) p.y=max(look_origin.z,look_data.y-look_shape.z)/s;
        else p.xy=mix(look_data.xy/s,p.xy,min(look_shape.z,0.9)/0.9);
    }
    // Drop below the driving line: bottoms use their source point in look_data, tops carry a constant.
    float line_drop=position.z<0.0?distance(look_data.xy,p.xy*s):look_data.x;
    vec2 fill_uv=(p.xy*s+look_origin.xy)/4.0;
    float perspective_w=1.0;
    if(depth>0.0 && look_shape.y==0.0) {
        p.xy+=(depth/s)*look_camera.zw;
    } else if(depth>0.0) {
    vec2 world=p.xy*s+look_origin.xy;
    // One central projection for the entire rigid shallow body. z=0 is exactly invariant.
    perspective_w=1.0+look_shape.y*depth;
    vec2 projected=look_camera.xy+(world-look_camera.xy+depth*look_camera.zw)/(1.0+look_shape.y*depth);
    p.xy=(projected-look_origin.xy)/s;
    }
    p.z=0.0; // preserve accepted terrain/sprite layering; no gameplay camera or 3D physics
    gl_Position=(world_view_proj*vec4(p,1.0))*perspective_w;
    var_color=color;
    float slot=floor(texture_slot+0.5);
    float flipped=slot>3.5?1.0:0.0;
    float face=slot-4.0*flipped;
    // One image spans 4 m along the track; per-quad U plus the fractional section phase, continuous across sections.
    float u=face<2.5?texcoord0.x+fract(editor_params.x):texcoord0.x*0.225;
    var_uv=vec3(u,1.0-texcoord0.y,face);
    var_flipped=flipped;
    // Run ends share one x: U continues over their depth, so the Fill does not streak.
    if(face>2.5) fill_uv.x+=u;
    var_side=vec4(line_drop,texcoord0.y,fill_uv);
}
