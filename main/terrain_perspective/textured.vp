#version 140
in highp vec3 position;
in lowp vec4 color;
in highp vec2 texcoord0;
in highp vec3 look_data;
in highp float texture_slot; // #392: family*4+face, constant per triangle
out lowp vec4 var_color;
out highp vec3 var_tile; // tile U, tile V (top-left image origin), slot
out highp vec4 var_line; // #536: metres below the driving line, slope factor, Fill U, Fill V (image top = 0)
uniform vs_uniforms {
    highp mat4 world_view_proj;
    highp vec4 editor_params;
    highp vec4 look_origin; // world origin m, local floor m, engine-to-metres scale
    highp vec4 look_shape; // width m, reciprocal focal contribution, side depth m, shading
    highp vec4 look_camera; // unchanged camera XY m, view shear XY
    highp vec4 look_body; // #536: metres the visible body moves in front of the driving line
};
void main() {
    vec3 p=position;
    float s=look_origin.w;
    float depth=p.z>0.0?p.z*s/0.9*look_shape.x:0.0;
    if(p.z<0.0) {
        depth=max(0.0,-p.z*s-0.9)/0.9*look_shape.x;
        if(look_data.z>1.5) { /* source-authored bottom already baked */ }
        else if(look_data.z>0.5) p.y=max(look_origin.z,look_data.y-look_shape.z)/s;
        else p.xy=mix(look_data.xy/s,p.xy,min(look_shape.z,0.9)/0.9);
    }
    // Side and end faces tile by world height (metres), after the bottom is resolved and before projection.
    // Section-local plus the fractional origin: same fract() as the world value; bounded by the section height.
    float tile_y=p.y*s+fract(look_origin.y);
    // #536: drop below the driving line. Bottoms use their source point in look_data; tops carry a constant.
    float line_drop=position.z<0.0?distance(look_data.xy,p.xy*s):look_data.x;
    float world_x=p.x*s+look_origin.x;
    float world_y=p.y*s+look_origin.y;
    // #536: move the whole visible body in front of the line, so the car drives on the Surface instead of its edge.
    if(texture_slot>23.5) depth-=look_body.x;
    float perspective_w=1.0;
    if(depth!=0.0 && look_shape.y==0.0) {
        p.xy+=(depth/s)*look_camera.zw;
    } else if(depth!=0.0) {
    vec2 world=p.xy*s+look_origin.xy;
    // One central projection for the entire rigid shallow body. z=0 is exactly invariant.
    perspective_w=1.0+look_shape.y*depth;
    vec2 projected=look_camera.xy+(world-look_camera.xy+depth*look_camera.zw)/(1.0+look_shape.y*depth);
    p.xy=(projected-look_origin.xy)/s;
    }
    p.z=0.0; // preserve accepted terrain/sprite layering; no gameplay camera or 3D physics
    gl_Position=(world_view_proj*vec4(p,1.0))*perspective_w;
    // Neutral per-face shading and selection gains come from the vertex colour; no green look tint.
    float id=floor(texture_slot+0.5);
    var_color=id>31.5?vec4(mix(vec3(1.0),color.rgb,look_shape.w),color.a):color; // protolit: Shading sets the light strength
    float face=id-4.0*floor(id*0.25+0.01);
    // Arc length in tile periods: per-quad U (material.lua drops whole tiles) plus the fractional section phase.
    // It differs from the course-wide value by whole tiles only (continuous) and stays below about
    // 1 + segment/period + 1, set by the longest single interval (worst built-in case ~137 periods, a 122.88 m
    // segment in straight.json), so var_tile needs highp (declared in both shaders; WebGL2/ES 3.0 guarantee it).
    bool proto=id>23.5;
    float period=face<1.5?0.9:1.0;
    if(proto) period=4.0;
    float arc=texcoord0.x*4.0/period+fract(editor_params.x*4.0/period);
    // Surface: one cross-section over the depth, image top at the back edge. Rim: image top at the road line.
    // Side: 1 m world tiles. End: U front->back over the cap, V by world height.
    float u=face<2.5?arc:texcoord0.x;
    float v=face<0.5?1.0-texcoord0.y:face<1.5?texcoord0.y:-tile_y;
    if(proto) {
        if(face>2.5) u=texcoord0.x*0.225;
        bool world_fill=id>27.5;
        var_line=vec4(line_drop,texcoord0.y,world_fill&&face<2.5?world_x/4.0:u,(world_fill?-world_y:line_drop)/4.0);
        v=face<0.5?1.0-texcoord0.y:0.0;
    } else var_line=vec4(0.0);
    var_tile=vec3(u,v,id);
}
