[project]
title = RiderG1
version = 0.1.0
dependencies#0 = https://github.com/defold/extension-automation-bridge/archive/567c7efb2f72626af71967984bd33dde856f0d36.zip

[bootstrap]
main_collection = /main/main.collectionc

[display]
width = 960
height = 540
vsync = 0
update_frequency = 60

[engine]
fixed_update_frequency = 60

[physics]
type = 2D
use_fixed_timestep = 1
scale = 0.01
gravity_y = -981
max_collision_object_count = 256

[box2d]
sub_step_count = 4

[native_extension]
app_manifest = /main/physics.appmanifest
