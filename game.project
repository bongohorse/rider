[project]
title = RiderG1
version = 0.1.0
custom_resources = /main/game/budget.json,/main/game/stations,/main/game/presets,/main/game/feedback.js,/main/game/custom.js,/main/game/mobile.js,/main/game/play_bar.js,/main/game/tilt.js,/main/game/level_menu.js,/main/game/background_panel.js,/main/game/decoration_panel.js,/main/editor/web/ui_kit.js,/main/editor/web/ui_fonts.js,/main/editor/web/chrome.js,/main/decorations/meadow/thumbs,/main/terrain_material/presets/meadow/thumb.png,/main/terrain_material/presets/quarry/thumb.png,/main/terrain_material/presets/volcano/thumb.png,/main/terrain_material/presets/city/thumb.png,/main/terrain_material/presets/inca/thumb.png,/main/terrain_material/presets/glacier/thumb.png,/main/terrain_material/presets/scrapyard/thumb.png,/main/backgrounds/fixtures,/main/background_presets
dependencies#0 = https://github.com/defold/extension-automation-bridge/archive/567c7efb2f72626af71967984bd33dde856f0d36.zip

[bootstrap]
render = /main/backgrounds/world.renderc
main_collection = /main/game/boot.collectionc

[display]
width = 960
height = 540
high_dpi = 1
vsync = 0
update_frequency = 60

[engine]
fixed_update_frequency = 60

[physics]
type = 2D
use_fixed_timestep = 1
scale = 0.01
gravity_y = -981
max_collision_object_count = 256

[box2d]
sub_step_count = 4

[native_extension]
app_manifest = /main/physics.appmanifest

[input]
game_binding = /input/game.input_bindingc

[html5]
scale_mode = stretch
htmlfile = /main/html5/index.html
show_fullscreen_button = 0
show_made_with_defold = 0

[sprite]
max_count = 1024

[label]
max_count = 1024

[graphics]
texture_profiles = /main/terrain_material/level.texture_profiles
